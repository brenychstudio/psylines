---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import AtmosphericBackdropRoot from "../../../app/atmosphere/AtmosphericBackdropSystem/AtmosphericBackdropRoot.astro";
import { getAllPrints, getAllWorks, getPrintBySlug } from "../../../data/site/relations";
import { collectorChecklist } from "../../../data/site/collector";
import { resolvePublicAsset } from "../../../lib/assets/publicAsset";
import { getResponsivePublicImage } from "../../../lib/assets/responsiveImage";

export async function getStaticPaths() {
  return getAllPrints().map((item) => ({
    params: { slug: item.slug },
  }));
}

const slug = Astro.params.slug;

if (!slug) {
  throw new Error("Missing print collector slug");
}

const print = getPrintBySlug(slug);

if (!print) {
  throw new Error(`Print not found for collector route: ${slug}`);
}

const relatedWork = getAllWorks().find((item) => item.slug === print.artworkSlug) ?? null;
const coverSrc = relatedWork ? resolvePublicAsset(relatedWork.cover) : null;
const coverImage = relatedWork ? getResponsivePublicImage(relatedWork.cover, { defaultWidth: 1400 }) : null;
---
<BaseLayout
  title={`${print.title} — Collector Route — Rostyslav Brenych`}
  description={`Collector route for ${print.title}`}
  canonicalPath={`/collectors/prints/${print.slug}`}
  noindex={true}
>
  <AtmosphericBackdropRoot />

  <section class="detail-shell">
    <div class={`detail-hero aspect-${print.aspect}`}>
      <div class={`detail-media-card aspect-${print.aspect}`}>
        {coverSrc ? (
          <>
            <img
              src={coverImage?.src ?? coverSrc}
              srcset={coverImage?.srcset}
              sizes="(min-width: 980px) 46vw, 92vw"
              alt={`${print.title} collector route`}
              class="detail-media-image"
              loading="eager"
              decoding="async"
            />
            <div class="detail-media-overlay"></div>
          </>
        ) : (
          <div class="detail-media-surface"></div>
        )}
        <div class="detail-media-frame"></div>
        <div class="detail-media-label">Collector route / print edition</div>
      </div>

      <div class="detail-info-card">
        <p class="detail-kicker">collector route / print edition</p>
        <h1 class="detail-title">{print.title}</h1>
        <p class="detail-copy">
          {print.edition} / {print.paper} / {print.leadTime}
        </p>

        <div class="detail-chip-row">
          <span class="detail-chip">{print.paper}</span>
          <span class="detail-chip">{print.certificate}</span>
          <span class="detail-chip">{print.aspect}</span>
        </div>

        <div class="btn-row">
          <a href="/contact" class="btn-primary">Open contact lane</a>
          <a href={`/prints/${print.slug}`} class="btn-secondary">Back to print edition</a>
        </div>
      </div>
    </div>
  </section>

  <section class="notice-strip">
    <div class="notice-card">
      <h2 class="notice-title">What this route is for</h2>
      <p class="notice-copy">
        This page is the purchase-oriented bridge between the visual print page and the broader contact lane. It should gather the right purchase context before real payment infrastructure is added.
      </p>
    </div>
  </section>

  <section class="flow-shell">
    <div class="flow-grid cols-3">
      <article class="flow-card">
        <p class="detail-kicker">edition</p>
        <h2 class="flow-title">{print.edition}</h2>
        <p class="flow-copy">Choose the preferred format and confirm that the edition route is the correct acquisition path.</p>
      </article>

      <article class="flow-card">
        <p class="detail-kicker">production</p>
        <h2 class="flow-title">{print.paper}</h2>
        <p class="flow-copy">{print.leadTime}</p>
      </article>

      <article class="flow-card">
        <p class="detail-kicker">shipping</p>
        <h2 class="flow-title">Dispatch note</h2>
        <p class="flow-copy">{print.shippingNote}</p>
      </article>
    </div>
  </section>

  <section class="flow-shell">
    <div class="flow-grid cols-2">
      <article class="flow-note-card">
        <p class="detail-kicker">what to include</p>
        <h2 class="flow-title">Inquiry checklist</h2>
        <ul class="flow-checklist">
          {collectorChecklist.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </article>

      <article class="flow-note-card">
        <p class="detail-kicker">edition options</p>
        <h2 class="flow-title">Available sizes and prices</h2>
        <div class="price-grid">
          {print.options.map((option) => (
            <article class="price-row">
              <p class="price-label">{option.label}</p>
              <h3 class="price-title">{option.dimensions}</h3>
              <p class="price-copy">EUR {option.priceEUR}</p>
            </article>
          ))}
        </div>
      </article>
    </div>
  </section>
</BaseLayout>
