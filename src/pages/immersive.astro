---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Immersive Field - ARTIST STAGE"
  description="A spatial continuation of the Meta-Bodies practice through signal, residue, and manifestation."
  canonicalPath="/immersive"
>
  <section class="immersive-shell">
    <div class="immersive-head">
      <p class="immersive-kicker">immersive / field of manifestation</p>
      <h1 class="immersive-title">Enter the manifestation field.</h1>
      <p class="immersive-copy">
        This is not a virtual gallery. It is an authored XR threshold where the work appears as signal,
        residue, and unstable presence.
      </p>

      <div class="immersive-actions">
        <a href="/immersive/experience" class="immersive-primary">Enter field</a>
        <a href="/works/mt-3">Return to MT-3</a>
        <a href="/works">Back to works field</a>
      </div>
    </div>

    <div class="immersive-note">
      <p>
        For the full XR test, open the experience route on a supported WebXR device or browser.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .immersive-shell {
    width: min(1120px, calc(100% - 48px));
    margin: 0 auto;
    padding: 140px 0 80px;
    display: grid;
    gap: 1.4rem;
  }

  .immersive-head {
    display: grid;
    gap: 0.85rem;
    max-width: 760px;
  }

  .immersive-kicker {
    margin: 0;
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(229, 232, 242, 0.52);
  }

  .immersive-title {
    margin: 0;
    font-size: clamp(2.8rem, 5vw, 4.8rem);
    line-height: 0.92;
    letter-spacing: -0.05em;
    color: rgba(245, 247, 252, 0.96);
    font-weight: 300;
  }

  .immersive-copy {
    margin: 0;
    max-width: 44ch;
    font-size: 1rem;
    line-height: 1.68;
    color: rgba(231, 234, 240, 0.72);
  }

  .immersive-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    padding-top: 0.3rem;
  }

  .immersive-actions a {
    display: inline-flex;
    align-items: center;
    min-height: 2.8rem;
    padding: 0.78rem 1rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.02);
    color: rgba(236, 239, 245, 0.76);
    text-decoration: none;
    transition:
      border-color 180ms ease,
      background 180ms ease,
      color 180ms ease,
      transform 180ms ease,
      box-shadow 180ms ease;
  }

  .immersive-actions a:hover {
    transform: translateY(-1px);
    border-color: rgba(255, 255, 255, 0.14);
    background: rgba(255, 255, 255, 0.04);
    color: rgba(246, 248, 252, 0.92);
  }

  .immersive-actions .immersive-primary {
    background: rgba(255, 255, 255, 0.94);
    color: rgba(10, 12, 18, 0.96);
    border-color: rgba(255, 255, 255, 0.94);
    box-shadow: 0 10px 24px rgba(255, 255, 255, 0.08);
  }

  .immersive-note {
    max-width: 720px;
    padding-top: 0.35rem;
  }

  .immersive-note p {
    margin: 0;
    font-size: 0.86rem;
    line-height: 1.55;
    color: rgba(229, 232, 242, 0.52);
  }
</style>
