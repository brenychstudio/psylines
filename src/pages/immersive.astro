---
import BaseLayout from "../layouts/BaseLayout.astro";
import ImmersivePressureField from "../components/immersive/ImmersivePressureField.astro";
import { getResponsivePublicImage } from "../lib/assets/responsiveImage";

const pressureTextureSources = [
  "/artworks/test-painting-2/mt-3.jpg",
  "/artworks/test-painting-2/mt-1.jpg",
  "/artworks/test-painting-2/mt-6.jpg",
  "/artworks/test-painting-2/mt-7.jpg",
  "/artworks/test-painting-2/mt-9.jpg",
].map((source) => getResponsivePublicImage(source, { defaultWidth: 2000 }).src);
---

<BaseLayout
  title="Field of Manifestation — Rostyslav Brenych"
  description="A living spatial threshold where original paintings pass through membrane, pigment, and unstable presence."
  canonicalPath="/immersive"
  hideFooter={true}
  preloadImages={pressureTextureSources.slice(0, 1)}
>
  <section
    class="immersive-threshold"
    data-immersive-threshold
    data-cinematic-idle-root
    data-cinematic-idle-delay="6000"
    data-cinematic-idle-reduced-delay="9600"
    data-cinematic-idle-wake-duration="3700"
    data-cinematic-idle-settle-duration="3000"
    data-cinematic-idle-dream-duration="8200"
  >
    <ImmersivePressureField textureSources={pressureTextureSources} />
    <div class="immersive-threshold__veil" aria-hidden="true"></div>

    <div class="immersive-interface">
      <div class="immersive-head">
        <div class="immersive-overline" data-cinematic-idle="detail">
          <p class="immersive-kicker">IMMERSIVE / FIELD 01</p>
          <p class="immersive-live-state"><span aria-hidden="true"></span>LIVE MEMBRANE</p>
        </div>

        <h1 class="immersive-title" data-cinematic-idle="anchor">
          Field of
          <span>Manifestation</span>
        </h1>

        <p class="immersive-copy" data-cinematic-idle="voice">
          Pigment gathers behind a living surface. It presses into space, crosses material layers,
          and recedes before becoming fixed form.
        </p>

        <div class="immersive-actions" data-cinematic-idle="action">
          <a href="/immersive/experience" class="immersive-primary">Enter field</a>
          <nav class="immersive-secondary-actions" aria-label="Related immersive routes">
            <a href="/works/mt-3">View MT-3</a>
            <a href="/works">Works index</a>
          </nav>
        </div>
      </div>

      <aside class="immersive-register" aria-label="Immersive field state" data-cinematic-idle="line">
        <div class="immersive-register__gauge" aria-hidden="true"><span></span></div>
        <dl>
          <div>
            <dt>Membrane</dt>
            <dd>Active</dd>
          </div>
          <div>
            <dt>Layers</dt>
            <dd>03</dd>
          </div>
          <div>
            <dt>Medium</dt>
            <dd>WebXR</dd>
          </div>
          <div>
            <dt>Access</dt>
            <dd>Device dependent</dd>
          </div>
        </dl>
      </aside>
    </div>

    <div class="immersive-field-rail" data-cinematic-idle="detail">
      <p>PIGMENT / MEMBRANE / RESIDUE</p>
      <p>AUTHORED THRESHOLD / META BODIES</p>
    </div>
  </section>
</BaseLayout>

<style>
  .immersive-threshold {
    --pressure-live: 0.58;
    --presence-live: 0.46;
    --bank-transition-live: 0;
    --bank-light-live: 0.07;
    position: relative;
    z-index: 2;
    min-height: calc(100svh - var(--site-header-height));
    overflow: hidden;
    isolation: isolate;
    color: rgba(241, 244, 237, 0.92);
    background: #020403;
  }

  .immersive-threshold__veil {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(90deg, rgba(2, 4, 3, 0.58) 0%, rgba(2, 4, 3, 0.3) 34%, rgba(2, 4, 3, 0.02) 64%, rgba(2, 4, 3, 0.1) 100%),
      linear-gradient(180deg, rgba(2, 4, 3, 0.14) 0%, transparent 24%, transparent 72%, rgba(2, 4, 3, 0.48) 100%);
  }

  .immersive-threshold__veil::after {
    content: "";
    position: absolute;
    inset: -18%;
    pointer-events: none;
    background: linear-gradient(
      112deg,
      transparent 20%,
      rgba(204, 224, 181, 0.08) 42%,
      rgba(224, 177, 111, 0.13) 51%,
      rgba(92, 153, 143, 0.07) 61%,
      transparent 79%
    );
    mix-blend-mode: screen;
    opacity: var(--bank-light-live);
    transform: translate3d(-4%, 1%, 0) scale(1.08);
    animation: immersivePressureLightDrift 24s ease-in-out infinite alternate;
    transition: opacity 820ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .immersive-interface {
    position: relative;
    z-index: 3;
    box-sizing: border-box;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 15rem;
    grid-template-rows: 1fr;
    gap: 4rem;
    width: 100%;
    min-height: calc(100svh - var(--site-header-height));
    padding: 4.75rem var(--site-frame-gutter) 5.8rem;
  }

  .immersive-head {
    align-self: center;
    display: grid;
    gap: 1rem;
    width: min(48rem, 100%);
  }

  .immersive-overline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    width: min(39rem, 100%);
  }

  .immersive-kicker,
  .immersive-live-state,
  .immersive-field-rail p {
    margin: 0;
    color: rgba(229, 235, 225, 0.52);
    font-size: 0.65rem;
    line-height: 1.2;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .immersive-live-state {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: rgba(191, 213, 160, 0.62);
  }

  .immersive-live-state span {
    width: 0.38rem;
    height: 0.38rem;
    border: 1px solid rgba(191, 213, 160, 0.68);
    border-radius: 50%;
    background: rgba(147, 188, 102, 0.42);
    box-shadow: 0 0 20px rgba(147, 188, 102, 0.34);
    animation: immersiveSignalBreath 5.8s ease-in-out infinite;
  }

  .immersive-title {
    max-width: 9ch;
    margin: 0;
    color: rgba(245, 247, 241, 0.96);
    font-size: 5.8rem;
    font-weight: 300;
    line-height: 0.88;
    letter-spacing: 0;
  }

  .immersive-title span {
    display: block;
    color: rgba(225, 232, 218, 0.78);
  }

  .immersive-copy {
    max-width: 43ch;
    margin: 0.45rem 0 0;
    color: rgba(229, 235, 225, 0.68);
    font-size: 1.02rem;
    line-height: 1.62;
    letter-spacing: 0;
  }

  .immersive-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.25rem;
    padding-top: 0.65rem;
  }

  .immersive-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 8.5rem;
    min-height: 3rem;
    padding: 0.75rem 1.1rem;
    border: 1px solid rgba(238, 242, 233, 0.9);
    border-radius: 2px;
    background: rgba(238, 242, 233, 0.92);
    color: rgba(5, 8, 6, 0.96);
    font-size: 0.78rem;
    line-height: 1;
    letter-spacing: 0;
    text-decoration: none;
    transition:
      background-color 320ms ease,
      color 320ms ease,
      border-color 320ms ease,
      transform 420ms cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 520ms ease;
  }

  .immersive-primary:hover,
  .immersive-primary:focus-visible {
    transform: translateY(-2px);
    border-color: rgba(211, 230, 181, 0.98);
    background: rgba(211, 230, 181, 0.96);
    box-shadow: 0 18px 52px rgba(117, 157, 80, 0.18);
  }

  .immersive-primary:focus-visible,
  .immersive-secondary-actions a:focus-visible {
    outline: 1px solid rgba(236, 241, 230, 0.7);
    outline-offset: 4px;
  }

  .immersive-secondary-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem 1rem;
  }

  .immersive-secondary-actions a {
    padding: 0.45rem 0 0.35rem;
    border-bottom: 1px solid rgba(229, 235, 225, 0.16);
    color: rgba(229, 235, 225, 0.6);
    font-size: 0.72rem;
    line-height: 1;
    letter-spacing: 0;
    text-decoration: none;
    transition: color 240ms ease, border-color 240ms ease;
  }

  .immersive-secondary-actions a:hover,
  .immersive-secondary-actions a:focus-visible {
    border-color: rgba(211, 230, 181, 0.5);
    color: rgba(240, 244, 235, 0.9);
  }

  .immersive-register {
    position: relative;
    align-self: end;
    display: grid;
    grid-template-columns: 1px minmax(0, 1fr);
    gap: 1rem;
    margin-bottom: 1.6rem;
    padding-top: 0.85rem;
    border-top: 1px solid rgba(229, 235, 225, 0.12);
  }

  .immersive-register__gauge {
    position: relative;
    width: 1px;
    height: 8.5rem;
    overflow: hidden;
    background: rgba(229, 235, 225, 0.11);
  }

  .immersive-register__gauge span {
    position: absolute;
    inset: 0;
    background: rgba(169, 202, 124, 0.72);
    transform: scaleY(var(--pressure-live));
    transform-origin: center bottom;
    transition: transform 900ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .immersive-register dl {
    display: grid;
    gap: 0.82rem;
    margin: 0;
  }

  .immersive-register dl > div {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.75rem;
    align-items: baseline;
  }

  .immersive-register dt,
  .immersive-register dd {
    margin: 0;
    font-size: 0.62rem;
    line-height: 1.2;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .immersive-register dt {
    color: rgba(229, 235, 225, 0.38);
  }

  .immersive-register dd {
    color: rgba(229, 235, 225, 0.68);
    text-align: right;
  }

  .immersive-field-rail {
    position: absolute;
    right: var(--site-frame-gutter);
    bottom: 1.2rem;
    left: var(--site-frame-gutter);
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(229, 235, 225, 0.085);
  }

  @keyframes immersivePressureLightDrift {
    from {
      transform: translate3d(-5%, 1%, 0) scale(1.08);
    }

    to {
      transform: translate3d(5%, -1%, 0) scale(1.12);
    }
  }

  @media (max-width: 1100px) {
    .immersive-interface {
      grid-template-columns: minmax(0, 1fr) 13rem;
      gap: 2rem;
    }

    .immersive-title {
      font-size: 4.8rem;
    }
  }

  @media (max-width: 760px) {
    .immersive-threshold__veil {
      background:
        linear-gradient(180deg, rgba(2, 4, 3, 0.24) 0%, rgba(2, 4, 3, 0.12) 36%, rgba(2, 4, 3, 0.34) 78%, rgba(2, 4, 3, 0.56) 100%),
        linear-gradient(90deg, rgba(2, 4, 3, 0.38) 0%, rgba(2, 4, 3, 0.06) 76%, rgba(2, 4, 3, 0.16) 100%);
    }

    .immersive-interface {
      grid-template-columns: 1fr;
      grid-template-rows: auto auto;
      align-content: center;
      gap: 2.2rem;
      padding: 3.2rem var(--site-frame-gutter) 5.4rem;
    }

    .immersive-head {
      align-self: auto;
      gap: 0.9rem;
    }

    .immersive-overline {
      width: 100%;
    }

    .immersive-title {
      max-width: 10ch;
      font-size: 3.35rem;
      line-height: 0.9;
    }

    .immersive-copy {
      max-width: 37ch;
      font-size: 0.94rem;
      line-height: 1.56;
    }

    .immersive-register {
      align-self: auto;
      width: min(22rem, 100%);
      margin: 0;
    }

    .immersive-register__gauge {
      height: 6.75rem;
    }

    .immersive-field-rail p:last-child {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .immersive-threshold__veil::after {
      animation: none;
    }
  }

  @media (max-width: 420px) {
    .immersive-interface {
      align-content: start;
      padding-top: 2.6rem;
    }

    .immersive-live-state {
      display: none;
    }

    .immersive-title {
      font-size: 2.85rem;
    }

    .immersive-actions {
      display: grid;
      justify-items: start;
    }

    .immersive-secondary-actions {
      gap: 0.55rem 0.9rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .immersive-live-state span {
      animation: none;
    }

    .immersive-primary,
    .immersive-register__gauge span {
      transition: none;
    }
  }

  @keyframes immersiveSignalBreath {
    0%,
    100% {
      opacity: 0.48;
      transform: scale(0.82);
    }

    48% {
      opacity: 1;
      transform: scale(1);
    }
  }
</style>

<style is:global>
  html[data-atmosphere-route="/immersive"] {
    --atmo-top: #0b1009;
    --atmo-mid: #060906;
    --atmo-bottom: #020403;
    --atmo-accent: rgba(147, 188, 102, 0.22);
    --artwork-accent: rgba(147, 188, 102, 0.34);
    --site-header-bg: rgba(2, 5, 3, 0.78);
    --site-header-border: rgba(180, 205, 153, 0.085);
  }

  /* Route-critical geometry stays global so a dev style refresh cannot collapse the WebGL viewport. */
  html[data-atmosphere-route="/immersive"] .immersive-threshold {
    position: relative;
    min-height: calc(100vh - var(--site-header-height));
    min-height: calc(100svh - var(--site-header-height));
    overflow: hidden;
    isolation: isolate;
  }

  html[data-atmosphere-route="/immersive"] .immersive-interface {
    position: relative;
    z-index: 3;
    box-sizing: border-box;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 15rem;
    grid-template-rows: 1fr;
    gap: 4rem;
    width: 100%;
    min-height: calc(100vh - var(--site-header-height));
    min-height: calc(100svh - var(--site-header-height));
    padding: 4.75rem var(--site-frame-gutter) 5.8rem;
  }

  html[data-atmosphere-route="/immersive"] .immersive-head {
    align-self: center;
    display: grid;
    gap: 1rem;
    width: min(48rem, 100%);
    max-width: none;
  }

  html[data-atmosphere-route="/immersive"] .immersive-overline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: min(39rem, 100%);
  }

  html[data-atmosphere-route="/immersive"] .immersive-title {
    max-width: 9ch;
    font-size: 5.8rem;
    line-height: 0.88;
    letter-spacing: 0;
  }

  html[data-atmosphere-route="/immersive"] .immersive-title span {
    display: block;
  }

  html[data-atmosphere-route="/immersive"] .immersive-register {
    position: relative;
    align-self: end;
    display: grid;
    grid-template-columns: 1px minmax(0, 1fr);
    gap: 1rem;
    margin-bottom: 1.6rem;
  }

  html[data-atmosphere-route="/immersive"] .immersive-register dl > div {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
  }

  html[data-atmosphere-route="/immersive"] .immersive-field-rail {
    position: absolute;
    right: var(--site-frame-gutter);
    bottom: 1.2rem;
    left: var(--site-frame-gutter);
    z-index: 3;
    display: flex;
    justify-content: space-between;
  }

  html[data-atmosphere-route="/immersive"] .site-shell::before,
  html[data-atmosphere-route="/immersive"] .site-artwork-atmosphere-field {
    opacity: 0.08;
  }

  html[data-atmosphere-route="/immersive"] .site-header {
    background: rgba(2, 5, 3, 0.78);
    backdrop-filter: blur(18px);
  }

  html[data-atmosphere-route="/immersive"][data-presence-phase="dreaming"] .immersive-live-state span {
    background: rgba(213, 232, 184, 0.78);
    box-shadow: 0 0 34px rgba(165, 205, 113, 0.5);
  }

  html[data-atmosphere-route="/immersive"][data-presence-phase="dreaming"] .immersive-primary {
    border-color: rgba(213, 232, 184, 0.76);
    box-shadow: 0 0 80px rgba(134, 177, 88, 0.18);
  }

  @media (max-width: 760px) {
    html[data-atmosphere-route="/immersive"] .immersive-interface {
      grid-template-columns: 1fr;
      grid-template-rows: auto auto;
      align-content: center;
      gap: 2.2rem;
      padding: 3.2rem var(--site-frame-gutter) 5.4rem;
    }

    html[data-atmosphere-route="/immersive"] .immersive-title {
      max-width: 10ch;
      font-size: 3.35rem;
      line-height: 0.9;
    }

    html[data-atmosphere-route="/immersive"] .immersive-register {
      align-self: auto;
      width: min(22rem, 100%);
      margin: 0;
    }

    html[data-atmosphere-route="/immersive"] .site-header {
      backdrop-filter: blur(12px);
    }
  }

  @media (max-width: 420px) {
    html[data-atmosphere-route="/immersive"] .immersive-interface {
      align-content: start;
      padding-top: 2.6rem;
    }

    html[data-atmosphere-route="/immersive"] .immersive-title {
      font-size: 2.85rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html[data-atmosphere-route="/immersive"] .site-header {
      backdrop-filter: none;
    }
  }
</style>
