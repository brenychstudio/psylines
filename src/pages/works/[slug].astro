  /* V3 Object Chamber - Pass 01 */
  .object-chamber-v3 {
    --object-accent: rgba(150, 195, 98, 0.16);
    --object-glow: rgba(120, 165, 80, 0.12);
    --object-shadow: rgba(5, 18, 8, 0.45);
    --object-line: rgba(219, 235, 204, 0.092);
    position: relative;
    isolation: isolate;
    width: min(100% - 48px, 1360px);
    max-width: none;
    padding: clamp(5.4rem, 8svh, 6.7rem) 0 clamp(1.8rem, 4svh, 2.8rem);
  }

  .object-chamber-v3::before {
    content: "";
    position: absolute;
    inset: clamp(4.4rem, 7svh, 5.8rem) -1.35rem 0;
    z-index: -1;
    border: 1px solid rgba(255, 255, 255, 0.035);
    border-radius: 2.35rem;
    background:
      radial-gradient(circle at 28% 22%, var(--object-glow), transparent 34%),
      linear-gradient(110deg, rgba(255, 255, 255, 0.028), transparent 34%),
      rgba(3, 6, 6, 0.2);
    box-shadow:
      0 42px 140px rgba(0, 0, 0, 0.36),
      inset 0 1px 0 rgba(255, 255, 255, 0.026);
    pointer-events: none;
  }

  .object-chamber-v3 .detail-hero {
    position: relative;
    grid-template-columns: 1fr;
    gap: clamp(0.9rem, 1.4vw, 1.25rem);
    align-items: stretch;
  }

  .object-chamber-v3 .detail-media-stage {
    min-height: 0;
  }

  .object-chamber-v3 .object-chamber-surface {
    position: relative;
    margin: 0;
    min-height: clamp(29rem, 68svh, 44rem);
    padding: clamp(1.4rem, 3vw, 2.8rem);
    display: grid;
    place-items: center;
    border-radius: 2rem;
    border: 1px solid var(--object-line);
    background:
      radial-gradient(circle at 50% 38%, rgba(160, 205, 112, 0.076), transparent 42%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.032), rgba(255, 255, 255, 0.01)),
      rgba(4, 7, 8, 0.78);
    box-shadow:
      0 40px 120px rgba(0, 0, 0, 0.46),
      inset 0 1px 0 rgba(255, 255, 255, 0.035);
    overflow: hidden;
    transition:
      opacity 360ms ease,
      transform 420ms ease,
      border-color 360ms ease;
  }

  .object-chamber-v3 .object-chamber-surface::after {
    content: "";
    position: absolute;
    inset: 1.05rem;
    z-index: 1;
    border: 1px solid rgba(255, 255, 255, 0.034);
    border-radius: 1.45rem;
    pointer-events: none;
    mask-image: linear-gradient(180deg, transparent, black 18%, black 82%, transparent);
  }

  .object-chamber-v3 .object-chamber-surface__aura {
    position: absolute;
    inset: 8% 12% 14%;
    background:
      radial-gradient(circle at 48% 42%, rgba(149, 190, 102, 0.16), transparent 60%),
      radial-gradient(circle at 52% 72%, rgba(226, 236, 208, 0.045), transparent 52%);
    filter: none;
    opacity: 0.76;
    pointer-events: none;
  }

  .object-chamber-v3 .object-chamber-plane {
    position: relative;
    z-index: 2;
    width: min(76%, 540px);
    max-height: min(64svh, 670px);
    display: grid;
    place-items: center;
    box-shadow:
      0 28px 84px rgba(0, 0, 0, 0.5),
      0 0 0 1px rgba(255, 255, 255, 0.042);
    transform: translateZ(0);
  }

  .object-chamber-v3 .object-chamber-media,
  .object-chamber-v3 .detail-media-card.aspect-portrait .object-chamber-media {
    position: relative;
    inset: auto;
    left: auto;
    right: auto;
    display: block;
    width: 100%;
    height: auto;
    max-width: 100%;
    max-height: min(64svh, 670px);
    object-fit: contain;
    object-position: center center;
    margin: 0;
    filter: saturate(1.04) contrast(1.035);
    transform: none;
  }

  .object-chamber-v3 .detail-media-surface.object-chamber-media {
    aspect-ratio: 3 / 4;
    min-height: 22rem;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.035), rgba(255, 255, 255, 0.012)),
      rgba(255, 255, 255, 0.018);
  }

  .object-chamber-v3 .object-chamber-label {
    left: 1rem;
    bottom: 1rem;
    z-index: 3;
    width: fit-content;
    padding: 0.38rem 0.7rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.075);
    background: rgba(5, 7, 8, 0.5);
    color: rgba(238, 241, 246, 0.56);
    font-size: 0.6rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .object-chamber-v3 .collector-instrument {
    position: relative;
    padding: clamp(1.4rem, 2.3vw, 1.9rem);
    border-radius: 2rem;
    border-color: rgba(219, 235, 204, 0.078);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.042), rgba(255, 255, 255, 0.014)),
      linear-gradient(120deg, rgba(128, 165, 94, 0.044), transparent 36%),
      rgba(6, 9, 10, 0.62);
    box-shadow:
      0 36px 108px rgba(0, 0, 0, 0.34),
      inset 0 1px 0 rgba(255, 255, 255, 0.045);
    backdrop-filter: none;
  }

  .object-chamber-v3 .collector-instrument::before {
    opacity: 0;
  }

  .object-chamber-v3 .collector-instrument__identity {
    padding-bottom: 1.08rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.052);
  }

  .object-chamber-v3 .detail-kicker,
  .object-chamber-v3 .detail-purchase-kicker,
  .object-chamber-v3 .detail-purchase-label {
    letter-spacing: 0.18em;
  }

  .object-chamber-v3 .detail-title {
    font-size: 4.2rem;
    line-height: 0.92;
    letter-spacing: 0;
  }

  .object-chamber-v3 .detail-copy {
    max-width: 30ch;
    margin: 0.92rem 0 1.05rem;
    color: rgba(233, 236, 242, 0.66);
  }

  .object-chamber-v3 .detail-chip-row {
    margin: 0;
    gap: 0.45rem;
  }

  .object-chamber-v3 .detail-chip {
    min-height: 1.85rem;
    border-color: rgba(219, 235, 204, 0.08);
    background: rgba(255, 255, 255, 0.018);
    color: rgba(238, 241, 246, 0.62);
  }

  .object-chamber-v3 .detail-purchase-panel {
    margin-top: 1rem;
    padding-top: 0;
    border-top: 0;
    gap: 0.9rem;
  }

  .object-chamber-v3 .collector-instrument__route-copy {
    padding-bottom: 0.85rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.044);
  }

  .object-chamber-v3 .detail-purchase-edition {
    max-width: 58ch;
    color: rgba(245, 247, 252, 0.82);
  }

  .object-chamber-v3 .detail-purchase-paper {
    color: rgba(229, 232, 242, 0.45);
  }

  .object-chamber-v3 .collector-instrument__selector {
    gap: 0.52rem;
  }

  .object-chamber-v3 .detail-size-options {
    gap: 0.48rem;
  }

  .object-chamber-v3 .detail-size-chip {
    min-height: 2.08rem;
    border-color: rgba(219, 235, 204, 0.078);
    background: rgba(255, 255, 255, 0.014);
    color: rgba(244, 246, 252, 0.68);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.02);
    transition:
      background 180ms ease,
      border-color 180ms ease,
      color 180ms ease,
      transform 180ms ease;
  }

  .object-chamber-v3 .detail-size-chip:hover {
    transform: translateY(-1px);
    border-color: rgba(219, 235, 204, 0.14);
    background: rgba(255, 255, 255, 0.032);
    color: rgba(244, 246, 252, 0.88);
  }

  .object-chamber-v3 .detail-size-chip.is-active {
    border-color: rgba(244, 247, 238, 0.9);
    background: rgba(244, 247, 238, 0.92);
    color: rgba(7, 10, 12, 0.96);
  }

  .object-chamber-v3 .collector-instrument__readout {
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
    gap: 0.72rem;
  }

  .object-chamber-v3 .collector-instrument__readout-cell {
    padding-top: 0.72rem;
    border-top: 1px solid rgba(255, 255, 255, 0.052);
  }

  .object-chamber-v3 .detail-price-value,
  .object-chamber-v3 .detail-format-value {
    font-size: 1rem;
    color: rgba(248, 249, 252, 0.88);
  }

  .object-chamber-v3 .collector-instrument__proof {
    gap: 0.45rem;
    padding: 0.78rem 0.84rem;
    border: 1px solid rgba(255, 255, 255, 0.052);
    border-radius: 1rem;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.024), rgba(255, 255, 255, 0.01)),
      rgba(255, 255, 255, 0.008);
  }

  .object-chamber-v3 .detail-purchase-proof-row {
    grid-template-columns: minmax(4.7rem, 5.4rem) minmax(0, 1fr);
    gap: 0.7rem;
  }

  .object-chamber-v3 .detail-purchase-proof-row + .detail-purchase-proof-row {
    padding-top: 0.42rem;
    border-top: 1px solid rgba(255, 255, 255, 0.035);
  }

  .object-chamber-v3 .detail-purchase-proof-row strong {
    color: rgba(241, 244, 249, 0.72);
  }

  .object-chamber-v3 .collector-instrument__context p,
  .object-chamber-v3 .detail-purchase-meta-row span:last-child {
    color: rgba(229, 232, 242, 0.5);
  }

