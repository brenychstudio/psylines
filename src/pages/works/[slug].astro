    place-items: center;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.04);
    color: rgba(245, 248, 242, 0.78);
    font-size: 1.2rem;
    line-height: 1;
    cursor: pointer;
