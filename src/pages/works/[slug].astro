    margin-top: 1rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.055);
    color: rgba(245, 248, 242, 0.88);
    font: inherit;
    font-size: 0.78rem;
    font-weight: 700;
    cursor: pointer;
