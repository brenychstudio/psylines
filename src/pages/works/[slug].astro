---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AtmosphericBackdropRoot from "../../app/atmosphere/AtmosphericBackdropSystem/AtmosphericBackdropRoot.astro";
import ArtworkAtmosphereBridge from "../../components/artwork-atmosphere/ArtworkAtmosphereBridge.astro";
import ObjectChamberHero from "../../components/works/ObjectChamberHero.astro";
import CollectorAcquisitionPanel from "../../components/commerce/CollectorAcquisitionPanel.astro";
import InteriorPreviewPanel from "../../components/commerce/InteriorPreviewPanel.astro";
import EditionProofCards from "../../components/commerce/EditionProofCards.astro";
import AdjacentManifestations from "../../components/works/AdjacentManifestations.astro";
import LivingAtmosphereOverride from "../../components/living-atmosphere/LivingAtmosphereOverride.astro";
import PrintArOverlay from "../../modules/print-ar/components/PrintArOverlay.jsx";
import { getArtworkMeta } from "../../data/site/artworkMeta";
import { getSeriesById } from "../../data/site/series";
import {
  getAllWorks,
  getWorkBySlug,
  getSiblingWorks,
} from "../../data/site/relations";
import {
  getCommerceOptionMaterialLine,
  getCommerceOptionProofLine,
  getCommerceOptionTypeLabel,
  getCommerceProduct,
  getDefaultCommerceOption,
} from "../../data/commerce/catalog";
import { resolvePublicAsset } from "../../lib/assets/publicAsset";
import { getWorkAtmosphereMood } from "../../lib/living-atmosphere/workMood";

export async function getStaticPaths() {
  return getAllWorks().map((work) => ({
    params: { slug: work.slug },
  }));
}

const slug = Astro.params.slug;

if (!slug) {
  throw new Error("Missing work slug");
}

const work = getWorkBySlug(slug);

if (!work) {
  throw new Error(`Work not found for slug: ${slug}`);
}

const artworkMeta = getArtworkMeta(work.slug);
const artworkSeries = getSeriesById(artworkMeta.seriesId);

const commerceProduct = getCommerceProduct(work.slug);
const defaultCommerceOption = commerceProduct
  ? getDefaultCommerceOption(work.slug)
  : null;

const defaultOptionTypeLabel = defaultCommerceOption
  ? getCommerceOptionTypeLabel(defaultCommerceOption)
  : "";

const defaultOptionProofLine = defaultCommerceOption
  ? getCommerceOptionProofLine(defaultCommerceOption)
  : "";

const defaultOptionMaterialLine = defaultCommerceOption
  ? getCommerceOptionMaterialLine(defaultCommerceOption)
  : "";

const printOptions = commerceProduct
  ? commerceProduct.options.filter((option) => option.type !== "original")
  : [];

const originalOption = commerceProduct
  ? commerceProduct.options.find((option) => option.type === "original")
  : null;

const relatedWorks = artworkSeries ? getSiblingWorks(work.slug, work.series) : [];
const coverSrc = resolvePublicAsset(work.cover);
const workAtmosphereMood = getWorkAtmosphereMood(work);
const workSeoDescription =
  work.statement ||
  artworkMeta.shortStatement ||
  `${work.title} - ${artworkMeta.mediumLine ?? "work on archival paper"}${artworkSeries ? ` from ${artworkSeries.title}` : ""}.`;
const previewDimensions = defaultCommerceOption?.dimensions ?? artworkMeta.dimensions ?? work.dimensions ?? "";
const hasPreviewRoute = Boolean(previewDimensions);
const previewRouteLabel = defaultCommerceOption
  ? getCommerceOptionTypeLabel(defaultCommerceOption)
  : artworkMeta.acquisitionStatus === "sold"
    ? "Placed work"
    : artworkMeta.acquisitionStatus === "reserved"
      ? "Collector hold"
      : "Original inquiry";
const previewPriceLabel = defaultCommerceOption ? `EUR ${defaultCommerceOption.priceEUR}` : "Shared on request";
const previewKind = defaultCommerceOption
  ? (defaultCommerceOption.type === "original" ? "original" : "print")
  : "original";
const previewSizeKey = defaultCommerceOption?.sizeKey ?? "original";
const workArConfig = {
  workId: work.slug,
  title: work.title,
  image: coverSrc,
  series: artworkSeries?.title ?? "",
  paper: artworkMeta.paper,
  routeHref: `/works/${work.slug}#collector-route`,
  defaultSizeKey: previewSizeKey,
  defaultDimensions: previewDimensions,
  defaultPrice: defaultCommerceOption?.priceEUR ?? null,
  defaultTypeLabel: previewRouteLabel,
};
const workArConfigJson = JSON.stringify(workArConfig).replace(/</g, "\\u003c");
---
<BaseLayout
  title={`${work.title} — Rostyslav Brenych`}
  description={workSeoDescription}
  ogImage={coverSrc}
  canonicalPath={`/works/${work.slug}`}
  ogType="article"
>
  <AtmosphericBackdropRoot />
  <LivingAtmosphereOverride mood={workAtmosphereMood} />
  <ArtworkAtmosphereBridge slug={artworkMeta.atmosphereProfile || work.slug} mode="work-detail" />

  <main
    class="work-detail-atmosphere-frame"
    data-work-detail-atmosphere="dominant"
    data-cinematic-idle-root
    data-cinematic-idle-delay="7200"
    data-cinematic-idle-reduced-delay="10800"
    data-cinematic-idle-settle-duration="3400"
    data-cinematic-idle-dream-duration="9800"
    data-cinematic-idle-wake-duration="3800"
  >
    <ObjectChamberHero
      work={work}
      artworkMeta={artworkMeta}
      artworkSeries={artworkSeries}
    >
      <CollectorAcquisitionPanel
        work={work}
        commerceProduct={commerceProduct}
        defaultCommerceOption={defaultCommerceOption}
        defaultOptionTypeLabel={defaultOptionTypeLabel}
        defaultOptionProofLine={defaultOptionProofLine}
        defaultOptionMaterialLine={defaultOptionMaterialLine}
        printOptions={printOptions}
        originalOption={originalOption}
        artworkMeta={artworkMeta}
        artworkSeries={artworkSeries}
      />
    </ObjectChamberHero>

    {hasPreviewRoute ? (
      <InteriorPreviewPanel
        work={work}
        coverSrc={coverSrc}
        defaultCommerceOption={defaultCommerceOption}
        previewDimensions={previewDimensions}
        previewPriceLabel={previewPriceLabel}
        previewRouteLabel={previewRouteLabel}
        previewKind={previewKind}
        previewSizeKey={previewSizeKey}
      />
    ) : null}

    <PrintArOverlay client:load mode="auto" />
    <script
      type="application/json"
      id="work-detail-ar-config"
      set:html={workArConfigJson}
    ></script>

    <EditionProofCards
      work={work}
      commerceProduct={commerceProduct}
      artworkMeta={artworkMeta}
      artworkSeries={artworkSeries}
    />

    <AdjacentManifestations relatedWorks={relatedWorks} />
  </main>

  <script is:inline define:vars={{ workSlug: work.slug }}>
    const sizeChips = document.querySelectorAll("[data-size-chip]");
    const priceDisplay = document.querySelector("[data-price-display]");
    const formatDisplay = document.querySelector("[data-format-display]");
    const typeDisplay = document.querySelector("[data-type-display]");
    const proofDisplay = document.querySelector("[data-proof-display]");
    const materialDisplay = document.querySelector("[data-material-display]");
    const returnDisplay = document.querySelector("[data-return-display]");
    const productionDisplay = document.querySelector("[data-production-display]");
    const shippingDisplay = document.querySelector("[data-shipping-display]");
    const collectorRouteDisplay = document.querySelector("[data-collector-route-display]");
    const collectorPriceDetailDisplay = document.querySelector("[data-collector-price-display]");
    const collectorFormatDetail = document.querySelector("[data-collector-format-detail]");
    const editionDisplay = document.querySelector("[data-edition-display]");
    const techniqueDetailDisplay = document.querySelector("[data-technique-display] a");
    const surfaceDetailDisplay = document.querySelector("[data-surface-display]");
    const paperDetailDisplay = document.querySelector("[data-paper-display]");
    const materialsDetailDisplay = document.querySelector("[data-materials-detail-display]");
    const signatureDisplay = document.querySelector("[data-signature-display]");
    const certificateDisplay = document.querySelector("[data-certificate-display]");
    const presentationDisplay = document.querySelector("[data-presentation-display]");
    const buyNowButton = document.querySelector("[data-buy-now]");
    const inquiryLinks = Array.from(document.querySelectorAll("[data-collector-inquiry-link]"));
    const checkoutFeedback = document.querySelector("[data-checkout-feedback]");
    const checkoutOverlay = document.querySelector("[data-checkout-overlay]");
    const checkoutOverlayCopy = document.querySelector("[data-checkout-overlay-copy]");
    const objectChamber = document.querySelector("[data-object-chamber]");
    const surfaceLensToggle = document.querySelector("[data-surface-lens-toggle]");
    const surfaceLensPlane = document.querySelector("[data-object-physical-plane]");
    const surfaceLensSource = document.querySelector("[data-surface-lens-source]");
    const surfaceLens = document.querySelector("[data-surface-lens]");
    const collectorDetails = document.querySelector("[data-collector-details]");
    const collectorDetailsSummary = document.querySelector("[data-collector-details-summary]");
    const collectorDetailsCloseButtons = Array.from(document.querySelectorAll("[data-collector-details-close]"));
    const interiorPreviewOpen = document.querySelector("[data-interior-preview-open]");
    const interiorPreviewPanels = Array.from(document.querySelectorAll("[data-interior-preview-panel]"));
    const interiorPreviewPanel =
      interiorPreviewPanels.find((panel) => !panel.closest("[data-object-chamber]")) ||
      interiorPreviewPanels[0] ||
      null;
    const inspectShell = interiorPreviewPanel?.querySelector("[data-inspect-shell]");
    const interiorPreviewCloseButtons = interiorPreviewPanel?.querySelectorAll("[data-interior-preview-close]") || [];

    interiorPreviewPanels.forEach((panel) => {
      if (panel !== interiorPreviewPanel) {
        panel.remove();
      }
    });

    if (interiorPreviewPanel?.closest("[data-object-chamber]")) {
      document.body.appendChild(interiorPreviewPanel);
    }

    const interiorPreviewSize = interiorPreviewPanel?.querySelector("[data-interior-preview-size]");
    const interiorPreviewPrice = interiorPreviewPanel?.querySelector("[data-interior-preview-price]");
    const interiorPreviewRoute = interiorPreviewPanel?.querySelector("[data-interior-preview-route]");
    const inspectArtworkObject = interiorPreviewPanel?.querySelector("[data-inspect-artwork-object]");

    function getActiveChip() {
      return document.querySelector("[data-size-chip].is-active");
    }

    function applyInspectFormatRatio(dimensions) {
      if (!inspectArtworkObject || !dimensions) return;

      const match = dimensions.match(/(\d+(?:[.,]\d+)?)\s*[×x]\s*(\d+(?:[.,]\d+)?)/i);
      if (!match) return;

      const width = Number(match[1].replace(",", "."));
      const height = Number(match[2].replace(",", "."));

      if (!Number.isFinite(width) || !Number.isFinite(height) || width <= 0 || height <= 0) return;

      inspectArtworkObject.style.setProperty("--inspect-format-ratio", `${width} / ${height}`);
      inspectArtworkObject.dataset.formatOrientation = width > height ? "landscape" : width === height ? "square" : "portrait";
    }

    function normalizePreviewSizeKey(value) {
      const normalized = String(value || "")
        .trim()
        .toLowerCase()
        .replace(/\s+/g, "")
        .replace(/[×]/g, "x")
        .replace(/[^a-z0-9x-]/g, "");

      return normalized || "original";
    }

    function setContactParam(params, key, value) {
      const normalized = String(value || "").trim();
      if (normalized) {
        params.set(key, normalized);
      }
    }

    function getCheckoutActionLabel(typeLabel) {
      const normalized = String(typeLabel || "").toLowerCase();

      if (normalized.includes("original")) return "Acquire original";
      if (normalized.includes("edition") || normalized.includes("print")) return "Acquire edition";
      return "Acquire work";
    }

    function buildCollectorContactHref(chip) {
      const sourceLink = inquiryLinks[0];
      if (!sourceLink) return "/contact";

      const routeLabel =
        chip?.getAttribute("data-size-type-label") ||
        sourceLink.getAttribute("data-inquiry-default-route") ||
        "Original inquiry";
      const formatLabel =
        chip?.textContent?.trim() ||
        sourceLink.getAttribute("data-inquiry-default-format") ||
        "Original work";
      const dimensions =
        chip?.getAttribute("data-size-dimensions") ||
        sourceLink.getAttribute("data-inquiry-default-dimensions") ||
        "";
      const rawPrice =
        chip?.getAttribute("data-size-price") ||
        sourceLink.getAttribute("data-inquiry-default-price") ||
        "";
      const priceLabel = rawPrice && !String(rawPrice).startsWith("EUR ")
        ? `EUR ${rawPrice}`
        : rawPrice;

      const url = new URL("/contact", window.location.origin);
      const params = url.searchParams;

      params.set("context", "collector");
      setContactParam(params, "work", sourceLink.getAttribute("data-inquiry-work-title"));
      setContactParam(params, "workSlug", sourceLink.getAttribute("data-inquiry-work-slug"));
      setContactParam(params, "inventory", sourceLink.getAttribute("data-inquiry-inventory"));
      setContactParam(params, "series", sourceLink.getAttribute("data-inquiry-series-title"));
      setContactParam(params, "seriesSlug", sourceLink.getAttribute("data-inquiry-series-slug"));
      setContactParam(params, "route", routeLabel);
      setContactParam(params, "format", formatLabel);
      setContactParam(params, "dimensions", dimensions);
      setContactParam(params, "price", priceLabel);
      setContactParam(params, "source", "work-detail");

      return `${url.pathname}?${params.toString()}`;
    }

    function updateInquiryLinks(chip) {
      if (!inquiryLinks.length) return;

      const href = buildCollectorContactHref(chip);
      inquiryLinks.forEach((link) => {
        link.setAttribute("href", href);
      });
    }

    function updateBuyNowLabel(chip) {
      if (!buyNowButton) return;

      const typeLabel =
        chip?.getAttribute("data-size-type-label") ||
        buyNowButton.getAttribute("data-buy-now-default-label") ||
        "";

      buyNowButton.textContent = getCheckoutActionLabel(typeLabel);
    }

    function applyPreviewOptionState(chip) {
      if (!interiorPreviewPanel || !chip) return;

      const optionLabel = chip.getAttribute("data-size-label") || "";
      const typeLabel = chip.getAttribute("data-size-type-label") || "";
      const normalizedOption = normalizePreviewSizeKey(optionLabel);
      const isOriginal =
        normalizedOption === "original" ||
        typeLabel.toLowerCase().includes("original");

      interiorPreviewPanel.dataset.previewKind = isOriginal ? "original" : "print";
      interiorPreviewPanel.dataset.previewSizeKey = isOriginal ? "original" : normalizedOption;
    }

    function setFeedback(message, variant = "default") {
      if (!checkoutFeedback) return;
      checkoutFeedback.textContent = message;
      checkoutFeedback.setAttribute("data-variant", variant);
    }

    function clearFeedback() {
      if (!checkoutFeedback) return;
      checkoutFeedback.textContent = "";
      checkoutFeedback.setAttribute("data-variant", "default");
    }

    function updateDisplaysFromChip(chip) {
      const price = chip?.getAttribute("data-size-price");
      const dimensions = chip?.getAttribute("data-size-dimensions");
      const typeLabel = chip?.getAttribute("data-size-type-label");
      const proofLine = chip?.getAttribute("data-size-proof-line");
      const materialLine = chip?.getAttribute("data-size-material-line");
      const productionTime = chip?.getAttribute("data-size-production-time");
      const returnWindow = chip?.getAttribute("data-size-return-window");
      const shippingNote = chip?.getAttribute("data-size-shipping-note");
      const collectorFormat = chip?.getAttribute("data-size-collector-format");
      const editionLabel = chip?.getAttribute("data-size-edition-label");
      const technique = chip?.getAttribute("data-size-technique");
      const surface = chip?.getAttribute("data-size-surface");
      const paper = chip?.getAttribute("data-size-paper");
      const materials = chip?.getAttribute("data-size-materials");
      const signature = chip?.getAttribute("data-size-signature");
      const certificate = chip?.getAttribute("data-size-certificate");
      const presentation = chip?.getAttribute("data-size-presentation");

      applyPreviewOptionState(chip);

      if (priceDisplay && price) {
        priceDisplay.textContent = `EUR ${price}`;
      }

      if (formatDisplay && dimensions) {
        formatDisplay.textContent = dimensions;
      }

      if (typeDisplay && typeLabel) {
        typeDisplay.textContent = typeLabel;
      }

      if (proofDisplay && proofLine) {
        proofDisplay.textContent = proofLine;
      }

      if (materialDisplay && materialLine) {
        materialDisplay.textContent = materialLine;
      }

      if (productionDisplay && productionTime) {
        productionDisplay.textContent = productionTime;
      }

      if (returnDisplay && returnWindow) {
        returnDisplay.textContent = returnWindow;
      }

      if (shippingDisplay && shippingNote) {
        shippingDisplay.textContent = shippingNote;
      }

      if (collectorRouteDisplay && typeLabel) {
        collectorRouteDisplay.textContent = typeLabel;
      }

      if (collectorPriceDetailDisplay && price) {
        collectorPriceDetailDisplay.textContent = `EUR ${price}`;
      }

      if (collectorFormatDetail && collectorFormat) {
        collectorFormatDetail.textContent = collectorFormat;
      }

      if (editionDisplay && editionLabel) {
        editionDisplay.textContent = editionLabel;
      }

      if (techniqueDetailDisplay && technique) {
        techniqueDetailDisplay.textContent = technique;
      }

      if (surfaceDetailDisplay && surface) {
        surfaceDetailDisplay.textContent = surface;
      }

      if (paperDetailDisplay && paper) {
        paperDetailDisplay.textContent = paper;
      }

      if (materialsDetailDisplay && materials) {
        materialsDetailDisplay.textContent = materials;
      }

      if (signatureDisplay && signature) {
        signatureDisplay.textContent = signature;
      }

      if (certificateDisplay && certificate) {
        certificateDisplay.textContent = certificate;
      }

      if (presentationDisplay && presentation) {
        presentationDisplay.textContent = presentation;
      }

      if (interiorPreviewSize && dimensions) {
        interiorPreviewSize.textContent = dimensions;
      }

      if (dimensions) {
        applyInspectFormatRatio(dimensions);
      }

      if (interiorPreviewPrice && price) {
        interiorPreviewPrice.textContent = `EUR ${price}`;
      }

      if (interiorPreviewRoute && typeLabel) {
        interiorPreviewRoute.textContent = typeLabel;
      }

      updateInquiryLinks(chip);
      updateBuyNowLabel(chip);
    }

    function openInteriorPreview() {
      setSurfaceLensActive(false);
      interiorPreviewPanel?.removeAttribute("hidden");
      interiorPreviewPanel?.setAttribute("data-open", "true");
      objectChamber?.setAttribute("data-object-chamber-state", "inspecting");
      objectChamber?.classList.add("is-inspect-open");
      objectChamber?.classList.add("is-inspecting");
      window.ArtistStageAtmosphereOrchestrator?.setState?.("inspecting");
      window.ArtistStageAtmosphereOrchestrator?.setPresence?.("settling", {
        source: "inspect-open",
      });
      document.documentElement.classList.add("is-object-inspecting");
      document.documentElement.dataset.artworkAtmosphereState = "inspecting";
      inspectShell?.setAttribute("tabindex", "-1");
      inspectShell?.focus?.({ preventScroll: true });
    }

    function closeInteriorPreview() {
      interiorPreviewPanel?.setAttribute("hidden", "");
      interiorPreviewPanel?.removeAttribute("data-open");
      objectChamber?.setAttribute("data-object-chamber-state", "awake");
      objectChamber?.classList.remove("is-inspect-open");
      objectChamber?.classList.remove("is-inspecting");
      window.ArtistStageAtmosphereOrchestrator?.setState?.("settled");
      window.ArtistStageAtmosphereOrchestrator?.setPresence?.("active", {
        source: "inspect-close",
      });
      document.documentElement.classList.remove("is-object-inspecting");
      delete document.documentElement.dataset.artworkAtmosphereState;
    }

    window.__ARTIST_STAGE_INTERIOR_PREVIEW__ = {
      open: openInteriorPreview,
      close: closeInteriorPreview,
    };

    const surfaceLensZoom = 1.68;
    let isSurfaceLensActive = false;

    function getSurfaceLensImageUrl() {
      return surfaceLensSource?.currentSrc || surfaceLensSource?.getAttribute("src") || "";
    }

    function refreshSurfaceLensImage() {
      if (!surfaceLens) return;

      const imageUrl = getSurfaceLensImageUrl();
      if (!imageUrl) return;

      surfaceLens.style.backgroundImage = `url("${imageUrl}")`;
    }

    function hideSurfaceLens() {
      surfaceLens?.removeAttribute("data-visible");
    }

    function setSurfaceLensActive(nextState) {
      const canActivate = Boolean(surfaceLens && surfaceLensSource && surfaceLensPlane);
      isSurfaceLensActive = canActivate && nextState;

      surfaceLensToggle?.setAttribute("aria-pressed", isSurfaceLensActive ? "true" : "false");
      objectChamber?.classList.toggle("is-surface-lens-active", isSurfaceLensActive);
      surfaceLensPlane?.toggleAttribute("data-surface-lens-active", isSurfaceLensActive);

      if (isSurfaceLensActive) {
        refreshSurfaceLensImage();
      } else {
        hideSurfaceLens();
      }
    }

    function updateSurfaceLens(event) {
      if (!isSurfaceLensActive || !surfaceLens || !surfaceLensSource || !surfaceLensPlane) return false;

      const imageRect = surfaceLensSource.getBoundingClientRect();
      if (!imageRect.width || !imageRect.height) return false;

      const localX = event.clientX - imageRect.left;
      const localY = event.clientY - imageRect.top;
      const isInside =
        localX >= 0 &&
        localY >= 0 &&
        localX <= imageRect.width &&
        localY <= imageRect.height;

      if (!isInside) {
        hideSurfaceLens();
        return false;
      }

      const planeRect = surfaceLensPlane.getBoundingClientRect();
      const lensRect = surfaceLens.getBoundingClientRect();
      const lensSize = lensRect.width || 168;
      const lensX = event.clientX - planeRect.left;
      const lensY = event.clientY - planeRect.top;
      const backgroundWidth = imageRect.width * surfaceLensZoom;
      const backgroundHeight = imageRect.height * surfaceLensZoom;
      const backgroundX = (lensSize / 2) - (localX * surfaceLensZoom);
      const backgroundY = (lensSize / 2) - (localY * surfaceLensZoom);

      surfaceLens.style.setProperty("--lens-x", `${lensX}px`);
      surfaceLens.style.setProperty("--lens-y", `${lensY}px`);
      surfaceLens.style.backgroundSize = `${backgroundWidth}px ${backgroundHeight}px`;
      surfaceLens.style.backgroundPosition = `${backgroundX}px ${backgroundY}px`;
      surfaceLens.setAttribute("data-visible", "true");
      return true;
    }

    surfaceLensToggle?.addEventListener("click", () => {
      setSurfaceLensActive(!isSurfaceLensActive);
    });

    surfaceLensSource?.addEventListener("load", refreshSurfaceLensImage);

    const collectorDetailsReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let collectorDetailsCloseTimer = 0;
    let collectorDetailsScrollState = null;

    function lockCollectorDetailsScroll() {
      if (window.innerWidth <= 1100 || collectorDetailsScrollState) return;

      const scrollbarWidth = Math.max(0, window.innerWidth - document.documentElement.clientWidth);
      collectorDetailsScrollState = {
        scrollY: window.scrollY,
        htmlOverflow: document.documentElement.style.overflow,
        bodyOverflow: document.body.style.overflow,
        bodyPaddingRight: document.body.style.paddingRight,
      };

      document.documentElement.classList.add("collector-details-scroll-lock");
      document.body.classList.add("collector-details-scroll-lock");
      document.documentElement.style.overflow = "hidden";
      document.body.style.overflow = "hidden";

      if (scrollbarWidth > 0) {
        document.body.style.paddingRight = `${scrollbarWidth}px`;
      }
    }

    function unlockCollectorDetailsScroll() {
      if (!collectorDetailsScrollState) return;

      const { scrollY, htmlOverflow, bodyOverflow, bodyPaddingRight } = collectorDetailsScrollState;
      collectorDetailsScrollState = null;
      document.documentElement.classList.remove("collector-details-scroll-lock");
      document.body.classList.remove("collector-details-scroll-lock");
      document.documentElement.style.overflow = htmlOverflow;
      document.body.style.overflow = bodyOverflow;
      document.body.style.paddingRight = bodyPaddingRight;
      window.scrollTo({ top: scrollY, left: 0, behavior: "auto" });
    }

    function finishClosingCollectorDetails(restoreFocus = false) {
      if (!collectorDetails?.open) return;

      collectorDetails.removeAttribute("open");
      collectorDetails.removeAttribute("data-closing");
      objectChamber?.classList.remove("is-collector-details-open");
      collectorDetailsSummary?.setAttribute("aria-expanded", "false");
      unlockCollectorDetailsScroll();

      if (restoreFocus) {
        collectorDetailsSummary?.focus?.({ preventScroll: true });
      }
    }

    function closeCollectorDetails({ restoreFocus = false } = {}) {
      if (!collectorDetails?.open || collectorDetails.hasAttribute("data-closing")) return;

      collectorDetails.setAttribute("data-closing", "true");
      collectorDetailsSummary?.setAttribute("aria-expanded", "false");
      window.clearTimeout(collectorDetailsCloseTimer);

      const closeDelay = collectorDetailsReducedMotion.matches ? 0 : 420;
      collectorDetailsCloseTimer = window.setTimeout(
        () => finishClosingCollectorDetails(restoreFocus),
        closeDelay,
      );
    }

    collectorDetails?.addEventListener("toggle", () => {
      if (collectorDetails.open) {
        window.clearTimeout(collectorDetailsCloseTimer);
        collectorDetails.removeAttribute("data-closing");
        lockCollectorDetailsScroll();
      } else {
        unlockCollectorDetailsScroll();
      }

      objectChamber?.classList.toggle("is-collector-details-open", collectorDetails.open);
      collectorDetailsSummary?.setAttribute("aria-expanded", collectorDetails.open ? "true" : "false");
    });

    window.addEventListener("resize", () => {
      if (!collectorDetails?.open) return;

      if (window.innerWidth > 1100) {
        lockCollectorDetailsScroll();
      } else {
        unlockCollectorDetailsScroll();
      }
    });

    collectorDetailsSummary?.addEventListener("click", (event) => {
      if (!collectorDetails?.open) return;
      event.preventDefault();
      closeCollectorDetails({ restoreFocus: true });
    });

    collectorDetailsCloseButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const restoreFocus = !button.classList.contains("collector-details-backdrop");
        closeCollectorDetails({ restoreFocus });
      });
    });

    document.addEventListener("pointerdown", (event) => {
      if (!collectorDetails?.open) return;
      if (event.target instanceof Node && collectorDetails.contains(event.target)) return;

      closeCollectorDetails();
    }, true);

    document.addEventListener("pointermove", updateSurfaceLens, true);
    document.addEventListener("pointerdown", (event) => {
      const didUpdateLens = updateSurfaceLens(event);
      if (didUpdateLens && isSurfaceLensActive && event.pointerType !== "mouse") {
        event.preventDefault();
      }
    }, true);
    document.addEventListener("pointerup", (event) => {
      if (event.pointerType !== "mouse") {
        hideSurfaceLens();
      }
    }, true);

    function setCheckoutLoadingState(isLoading) {
      if (!buyNowButton) return;

      if (isLoading) {
        buyNowButton.setAttribute("disabled", "true");
        buyNowButton.textContent = "Redirecting...";
        checkoutOverlay?.removeAttribute("hidden");
        document.documentElement.classList.add("is-checkout-loading");
      } else {
        buyNowButton.removeAttribute("disabled");
        updateBuyNowLabel(getActiveChip());
        checkoutOverlay?.setAttribute("hidden", "");
        document.documentElement.classList.remove("is-checkout-loading");
      }
    }

    sizeChips.forEach((chip) => {
      chip.addEventListener("click", () => {
        sizeChips.forEach((item) => item.classList.remove("is-active"));
        chip.classList.add("is-active");
        updateDisplaysFromChip(chip);
        clearFeedback();
      });
    });

    const initialChip = getActiveChip();
    if (initialChip) {
      updateDisplaysFromChip(initialChip);
    }

    if (!initialChip) {
      updateInquiryLinks(null);
    }

    interiorPreviewOpen?.addEventListener("click", openInteriorPreview);

    interiorPreviewCloseButtons.forEach((button) => {
      button.addEventListener("click", closeInteriorPreview);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && collectorDetails?.open) {
        closeCollectorDetails({ restoreFocus: true });
      }

      if (event.key === "Escape" && interiorPreviewPanel?.getAttribute("data-open") === "true") {
        closeInteriorPreview();
      }

      if (event.key === "Escape" && isSurfaceLensActive) {
        setSurfaceLensActive(false);
      }
    });

    const params = new URLSearchParams(window.location.search);
    if (params.get("checkout") === "success") {
      setFeedback(
        "Collector checkout completed. Stripe confirmation will arrive by email.",
        "success",
      );
    } else if (params.get("checkout") === "cancel") {
      setFeedback(
        "Checkout was cancelled. Your selected collector route is still available to review.",
        "muted",
      );
    }

    buyNowButton?.addEventListener("click", async () => {
      const activeChip = getActiveChip();

      if (!activeChip) {
        setFeedback("Select a format before checkout.", "muted");
        return;
      }

      const optionLabel = activeChip.getAttribute("data-size-label");

      if (!optionLabel) {
        setFeedback("Missing product data.", "error");
        return;
      }

      const selectedText = activeChip.textContent?.trim() || "selected edition";
      const selectedPrice = activeChip.getAttribute("data-size-price");

      if (checkoutOverlayCopy) {
        checkoutOverlayCopy.textContent = selectedPrice
          ? `Preparing ${selectedText} / EUR ${selectedPrice}`
          : `Preparing ${selectedText}`;
      }

      clearFeedback();
      setCheckoutLoadingState(true);

      try {
        const response = await fetch("/api/checkout", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            workSlug,
            optionLabel,
          }),
        });

        const data = await response.json();

        if (!response.ok || !data?.url) {
          throw new Error(data?.error || "Checkout session failed.");
        }

        window.location.href = data.url;
      } catch (error) {
        console.error(error);
        setCheckoutLoadingState(false);
        setFeedback("Unable to start checkout. Try again.", "error");
      }
    });
  </script>
  <script>
    import { buildPrintArPayload } from "../../modules/print-ar/buildPrintArPayload.js";
    import { openSitePrintPreview } from "../../integrations/print-ar-preview/openSitePrintPreview.js";

    const arConfigElement = document.getElementById("work-detail-ar-config");

    function parseArConfig() {
      if (!arConfigElement) return null;

      try {
        return JSON.parse(arConfigElement.textContent || "{}");
      } catch (error) {
        console.error("[ARTIST STAGE] Failed to parse AR config.", error);
        return null;
      }
    }

    function extractSizeLabel(dimensions, fallbackKey) {
      const normalizedDimensions = String(dimensions || "").trim();
      const numericMatch = normalizedDimensions.match(
        /(\d+(?:[.,]\d+)?)\s*[Г—x]\s*(\d+(?:[.,]\d+)?)/i,
      );

      if (numericMatch) {
        return `${numericMatch[1]} x ${numericMatch[2]} cm`;
      }

      if (String(fallbackKey || "").toLowerCase() === "original") {
        return "29.7 x 42 cm";
      }

      return normalizedDimensions || "50 x 70 cm";
    }

    function getActiveSizeSelection(config) {
      const activeChip = document.querySelector("[data-size-chip].is-active");

      if (!activeChip) {
        return {
          key: config?.defaultSizeKey || "original",
          dimensions: config?.defaultDimensions || "29.7 x 42 cm",
          price: Number(config?.defaultPrice || 0) || null,
          typeLabel: config?.defaultTypeLabel || "Original work",
          materialLine: config?.paper || "",
        };
      }

      const priceValue = Number(activeChip.getAttribute("data-size-price") || "");

      return {
        key: activeChip.getAttribute("data-size-label") || config?.defaultSizeKey || "original",
        dimensions:
          activeChip.getAttribute("data-size-dimensions") ||
          config?.defaultDimensions ||
          "29.7 x 42 cm",
        price: Number.isFinite(priceValue) ? priceValue : Number(config?.defaultPrice || 0) || null,
        typeLabel:
          activeChip.getAttribute("data-size-type-label") ||
          config?.defaultTypeLabel ||
          "Original work",
        materialLine:
          activeChip.getAttribute("data-size-material-line") ||
          config?.paper ||
          "",
      };
    }

    async function openWorkArPreview() {
      const config = parseArConfig();
      if (!config?.image) return null;

      const sizeSelection = getActiveSizeSelection(config);
      const payload = await buildPrintArPayload({
        print: {
          id: config.workId,
          title: config.title,
          image: config.image,
          series: config.series,
          edition: sizeSelection.typeLabel,
          paper: sizeSelection.materialLine || config.paper || "",
          priceFrom: sizeSelection.price,
        },
        size: {
          key: sizeSelection.key,
          label: extractSizeLabel(sizeSelection.dimensions, sizeSelection.key),
          price: sizeSelection.price,
        },
        shareUrl: window.location.href,
        framePresetId: "black",
      });

      const nextPayload = {
        ...payload,
        cta: {
          label: "Return to collector route",
          url: config.routeHref || `${window.location.pathname}#collector-route`,
        },
        sourceMeta: {
          ...payload.sourceMeta,
          routeTypeLabel: sizeSelection.typeLabel,
          selectedDimensions: sizeSelection.dimensions,
        },
      };

      return openSitePrintPreview(nextPayload);
    }

    async function handleWorkArPreviewButton(button) {
      const originalLabel = button.textContent;

      button.setAttribute("aria-busy", "true");
      button.textContent = "Preparing...";

      try {
        const preview = await openWorkArPreview();
        if (!preview) {
          window.__ARTIST_STAGE_INTERIOR_PREVIEW__?.open?.();
        }
      } catch (error) {
        console.error("[ARTIST STAGE] Failed to open AR preview.", error);
        window.__ARTIST_STAGE_INTERIOR_PREVIEW__?.open?.();
      } finally {
        button.removeAttribute("aria-busy");
        button.textContent = originalLabel;
      }
    }

    window.__ARTIST_STAGE_WORK_AR__ = {
      open: openWorkArPreview,
    };

    let lastArOpenButton = null;
    let lastArOpenAt = 0;

    function triggerWorkArPreviewFromEvent(event) {
      const button = event.target?.closest?.("[data-print-ar-open]");
      if (!button) return;
      if (button.disabled || button.getAttribute("aria-busy") === "true") return;

      const now = window.performance?.now?.() ?? Date.now();
      if (lastArOpenButton === button && now - lastArOpenAt < 700) return;

      event.preventDefault();
      event.stopPropagation();

      lastArOpenButton = button;
      lastArOpenAt = now;

      void handleWorkArPreviewButton(button);
    }

    document.addEventListener("pointerup", triggerWorkArPreviewFromEvent, true);
    document.addEventListener("click", triggerWorkArPreviewFromEvent, true);
  </script>
</BaseLayout>

