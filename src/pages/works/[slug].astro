  .inspect-field-stage .inspect-meta-grid {
    display: grid;
    gap: 0.85rem;
  }

  .inspect-field-stage .inspect-meta-grid div {
    padding-top: 0.8rem;
    border-top: 1px solid rgba(255, 255, 255, 0.075);
  }

  .inspect-field-stage .inspect-meta-grid span {
    display: block;
    margin-bottom: 0.2rem;
    font-size: 0.6rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(235, 240, 232, 0.42);
