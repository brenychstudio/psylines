      min-height: auto;
    }

    .home-selected-field {
      min-height: 620px;
    }

    .home-selected-plane--active {
      left: 50%;
      right: auto;
      width: min(420px, 72vw);
      transform: translate(-50%, -50%);
    }

    .home-selected-plane--orbit {
      width: clamp(96px, 22vw, 180px);
    }

    .home-selected-field-hint {
      right: 50%;
      top: auto;
      bottom: 0.5rem;
      transform: translateX(50%);
      text-align: center;
    }

    .home-field-next {
      right: var(--site-frame-gutter-mobile);
      bottom: clamp(4.25rem, 8svh, 5.5rem);
    }

    .home-selected-route-scene__intro {
      grid-template-columns: 1fr;
    }

    .home-selected-route-stage {
      min-height: auto;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

