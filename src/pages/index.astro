---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArtworkAtmosphereBridge from "../components/artwork-atmosphere/ArtworkAtmosphereBridge.astro";
import HomePrologueField from "../components/home/HomePrologueField.astro";
import HomeLivingEditorialSurface, {
  type HomeLivingEditorialItem,
} from "../components/home/HomeLivingEditorialSurface";
import { getHomeManifestationFieldWorks } from "../data/site/artworkCollections";
import { getArtworkAtmosphereProfile } from "../lib/artwork-atmosphere/artworkAtmosphereProfiles";
import { resolvePublicAsset } from "../lib/assets/publicAsset";
import { getResponsivePublicImage } from "../lib/assets/responsiveImage";

const homeFieldWorks = getHomeManifestationFieldWorks(8);
const activeSelectedWork = homeFieldWorks[0];
const orbitWorks = homeFieldWorks.slice(1, 7);
const homeLivingWorks = getHomeManifestationFieldWorks(12);

if (!activeSelectedWork) {
  throw new Error("Home requires at least one artwork in the manifestation field.");
}

type HomeFieldWork = (typeof homeFieldWorks)[number];
type HomeFieldAsset = string | { src?: string; alt?: string } | null | undefined;
type HomeVisualWork = HomeFieldWork & {
  image?: HomeFieldAsset;
  cover?: HomeFieldAsset;
};

const readAssetSrc = (asset: HomeFieldAsset) => {
  if (!asset) return "";
  if (typeof asset === "string") return asset;
  return asset.src ?? "";
};

const readAssetAlt = (asset: HomeFieldAsset) => {
  if (!asset || typeof asset === "string") return "";
  return asset.alt ?? "";
};

const getWorkImageSrc = (work: HomeFieldWork) => {
  const visualWork = work as HomeVisualWork;
  const assetPath = readAssetSrc(visualWork.image) || readAssetSrc(visualWork.cover);
  return getResponsivePublicImage(resolvePublicAsset(assetPath) ?? assetPath, { defaultWidth: 960 }).src;
};

const getWorkImageSrcSet = (work: HomeFieldWork) => {
  const visualWork = work as HomeVisualWork;
  const assetPath = readAssetSrc(visualWork.image) || readAssetSrc(visualWork.cover);
  return getResponsivePublicImage(resolvePublicAsset(assetPath) ?? assetPath, { defaultWidth: 960 }).srcset ?? "";
};

const getWorkFieldTextureSrc = (work: HomeFieldWork) => {
  const visualWork = work as HomeVisualWork;
  const assetPath = readAssetSrc(visualWork.image) || readAssetSrc(visualWork.cover);
  return getResponsivePublicImage(resolvePublicAsset(assetPath) ?? assetPath, { defaultWidth: 2000 }).src;
};

const getWorkImageAlt = (work: HomeFieldWork) => {
  const visualWork = work as HomeVisualWork;
  return readAssetAlt(visualWork.image) || readAssetAlt(visualWork.cover) || work.title || "Selected artwork";
};

const getWorkDisplayLabel = (work: HomeFieldWork) => work.meta?.inventoryNumber ?? work.title;
const getWorkContextLabel = (work: HomeFieldWork) => work.series?.title ?? "Independent Manifestation";
const getWorkAtmosphereSlug = (work: HomeFieldWork) => work.meta?.atmosphereProfile || work.slug;

const activeHandoffSlug = getWorkAtmosphereSlug(activeSelectedWork);
const homePrologueTextures = homeLivingWorks.map((work) => ({
  slug: work.slug,
  src: getWorkFieldTextureSrc(work),
}));
const homePrologueMemorySlug =
  homeLivingWorks.find((work) => work.slug === "mt-9")?.slug ??
  homeLivingWorks.find((work) => work.slug !== activeSelectedWork.slug)?.slug ??
  activeSelectedWork.slug;
const livingDepths = ["hero", "near", "mid", "hero", "trace", "near", "mid", "near", "trace"] as const;
const getLivingTone = (work: HomeFieldWork): HomeLivingEditorialItem["tone"] => {
  if (["mt-1", "mt-2", "mt-4", "mt-7", "mt-9", "mt-10", "quiet-red-interval"].includes(work.slug)) return "red";
  if (["mt-3", "mt-5", "mt-6"].includes(work.slug)) return "green";
  if (work.slug === "figure-in-ash-light") return "ash";
  if (work.meta.mood === "nightWater") return "blue";
  if (work.meta.mood === "studies") return "ash";
  if (work.meta.mood === "metaBodies") return "earth";
  return "earth";
};

const getLivingCopyKey = (work: HomeFieldWork): HomeLivingEditorialItem["copyKey"] => {
  if (work.meta.mood === "nightWater") return "night";
  if (work.meta.mood === "studies") return "studies";
  if (work.role === "archive" || work.role === "study") return "archive";
  if (work.meta.mood === "metaBodies") return "meta";
  return "selected";
};

const livingEditorialItems: HomeLivingEditorialItem[] = homeLivingWorks.map((work, index) => {
  const atmosphereSlug = getWorkAtmosphereSlug(work);
  const atmosphere = getArtworkAtmosphereProfile(atmosphereSlug);

  return {
    id: work.slug,
    title: getWorkDisplayLabel(work),
    kicker: getWorkContextLabel(work),
    href: `/works/${work.slug}`,
    image: getWorkImageSrc(work),
    srcset: getWorkImageSrcSet(work),
    alt: getWorkImageAlt(work),
    year: work.meta.year ? String(work.meta.year) : "",
    context: getWorkContextLabel(work),
    description: work.meta.shortStatement ?? work.statement,
    tone: getLivingTone(work),
    depth: livingDepths[index % livingDepths.length],
    copyKey: getLivingCopyKey(work),
    atmosphereSlug,
    atmosphereWash: atmosphere.washStrong,
    atmosphereGlow: atmosphere.glow,
    atmosphereAccent: atmosphere.accent,
    atmosphereShadow: atmosphere.shadowWash,
  };
});
---

<BaseLayout
  title="ARTIST STAGE - Meta-Bodies and Collector Field"
  description="A living collector field for selected manifestations, series, works, editions, originals, and spatial continuations."
  canonicalPath="/"
>
  <ArtworkAtmosphereBridge slug={activeHandoffSlug} mode="home" />
  <HomePrologueField
    textures={homePrologueTextures}
    initialSlug={activeSelectedWork.slug}
    memorySlug={homePrologueMemorySlug}
  />
  <div
    class="home-manifestation-field"
    data-home-selected-field
    data-works-atmosphere-field
    data-cinematic-idle-root
    data-cinematic-idle-delay="6400"
    data-cinematic-idle-reduced-delay="10000"
    data-cinematic-idle-wake-duration="3900"
    data-cinematic-idle-settle-duration="3200"
    data-cinematic-idle-dream-duration="8800"
  >
    <section
      class="home-threshold-field"
      aria-label="ARTIST STAGE selected manifestations field"
      data-atmosphere-section="home-threshold"
    >
      <div class="home-threshold-copy">
        <p class="home-kicker" data-cinematic-idle="detail">AUTHORIAL PRACTICE / LIVING MANIFESTATION FIELD</p>
        <h1 class="home-title" data-cinematic-idle="anchor">
          <span>ARTIST</span>
          <span>STAGE</span>
        </h1>
        <p class="home-manifesto" data-cinematic-idle="voice">
          Meta-bodies emerge as presences, not representations.
        </p>
        <p class="home-copy" data-cinematic-idle="voice">
          A living artwork system of selected works, authored series, material traces, and spatial continuations.
        </p>
        <p class="home-active-context" data-home-active-context data-cinematic-idle="detail">
          {getWorkContextLabel(activeSelectedWork)}
        </p>

        <nav class="home-route-signals" aria-label="Home routes" data-cinematic-idle="action">
          <a href="/works" data-home-handoff-link data-atmosphere-handoff-slug={activeHandoffSlug}>
            Enter works field
          </a>
          <a
            href={`/works/${activeSelectedWork.slug}`}
            data-home-active-object-route
            data-atmosphere-handoff-slug={activeHandoffSlug}
          >
            Open selected object
          </a>
          <a href="/series" data-home-handoff-link data-atmosphere-handoff-slug={activeHandoffSlug}>
            Enter series field
          </a>
        </nav>
      </div>

      <div
        class="home-selected-field"
        aria-label="Selected manifestations"
        tabindex="0"
        data-home-hero-stage
      >
        <p class="home-field-chapter" data-cinematic-idle="detail">FIELD 01 / OVERTURE</p>
        <a
          class="home-selected-plane home-selected-plane--active"
          href={`/works/${activeSelectedWork.slug}`}
          aria-label={`Open ${activeSelectedWork.title}`}
          data-home-active-link
          data-artwork-slug={activeSelectedWork.slug}
          data-home-work-slug={activeSelectedWork.slug}
          data-home-work-title={activeSelectedWork.title}
          data-home-work-label={getWorkDisplayLabel(activeSelectedWork)}
          data-home-work-context={getWorkContextLabel(activeSelectedWork)}
          data-home-work-year={activeSelectedWork.meta.year ?? ""}
          data-home-work-image={getWorkImageSrc(activeSelectedWork)}
          data-home-work-srcset={getWorkImageSrcSet(activeSelectedWork)}
          data-home-work-alt={getWorkImageAlt(activeSelectedWork)}
          data-home-work-atmosphere={activeHandoffSlug}
          data-atmosphere-handoff-slug={activeHandoffSlug}
        >
          <img
            src={getWorkImageSrc(activeSelectedWork)}
            alt={getWorkImageAlt(activeSelectedWork)}
            srcset={getWorkImageSrcSet(activeSelectedWork)}
            sizes="(min-width: 1200px) 34vw, (min-width: 760px) 56vw, 84vw"
            loading="eager"
            decoding="async"
            data-cinematic-cover
            data-home-active-image
            data-cinematic-idle="image"
          />
          <span data-home-active-caption>
            Active manifestation / {getWorkDisplayLabel(activeSelectedWork)}
            {activeSelectedWork.meta.year ? ` / ${activeSelectedWork.meta.year}` : ""}
          </span>
        </a>

        <div class="home-selected-orbit" aria-label="Selected field traces">
          {orbitWorks.map((work, index) => (
            <a
              class={`home-selected-plane home-selected-plane--orbit home-selected-plane--orbit-${index + 1}`}
              href="#"
              role="button"
              aria-current="false"
              aria-label={`Bring ${work.title} into focus`}
              data-home-work-node
              data-home-work-slug={work.slug}
              data-home-work-title={work.title}
              data-home-work-label={getWorkDisplayLabel(work)}
              data-home-work-context={getWorkContextLabel(work)}
              data-home-work-year={work.meta.year ?? ""}
              data-home-work-image={getWorkImageSrc(work)}
              data-home-work-srcset={getWorkImageSrcSet(work)}
              data-home-work-alt={getWorkImageAlt(work)}
              data-home-work-atmosphere={getWorkAtmosphereSlug(work)}
              data-home-hero-node
              data-atmosphere-handoff-slug={getWorkAtmosphereSlug(work)}
              tabindex="0"
            >
              <img
                src={getWorkImageSrc(work)}
                alt={getWorkImageAlt(work)}
                srcset={getWorkImageSrcSet(work)}
                sizes="(min-width: 1200px) 14vw, (min-width: 760px) 20vw, 42vw"
                loading="eager"
                decoding="async"
                data-cinematic-cover
              />
              <span>{getWorkDisplayLabel(work)}</span>
            </a>
          ))}
        </div>

        <aside class="home-field-register" aria-label="Current field state" data-cinematic-idle="detail">
          <div>
            <span>Field</span>
            <strong>Active</strong>
          </div>
          <div>
            <span>Work</span>
            <strong data-home-active-register>{getWorkDisplayLabel(activeSelectedWork)}</strong>
          </div>
          <div>
            <span>Manifestations</span>
            <strong>{String(homeLivingWorks.length).padStart(2, "0")}</strong>
          </div>
        </aside>
        <button class="home-field-next" type="button" data-home-field-next data-cinematic-idle="action" aria-label="Continue to selected manifestations">
          <span class="home-field-next__line" aria-hidden="true"></span>
          Next
        </button>
      </div>
    </section>

    <HomeLivingEditorialSurface items={livingEditorialItems} client:load />
  </div>
</BaseLayout>

<script is:inline>
  (() => {
    const root = document.querySelector("[data-home-selected-field]");
    if (!root) return;

    const activeLink = root.querySelector("[data-home-active-link]");
    const activeImage = root.querySelector("[data-home-active-image]");
    const activeCaption = root.querySelector("[data-home-active-caption]");
    const activeContext = root.querySelector("[data-home-active-context]");
    const activeRegister = root.querySelector("[data-home-active-register]");
    const activeObjectRoute = root.querySelector("[data-home-active-object-route]");
    const handoffLinks = root.querySelectorAll("[data-home-handoff-link]");
    const heroStage = root.querySelector("[data-home-hero-stage]");
    const nextSectionButton = root.querySelector("[data-home-field-next]");
    const heroNodes = Array.from(root.querySelectorAll("[data-home-hero-node]"));
    const nodes = Array.from(root.querySelectorAll("[data-home-work-node]"));

    if (!activeLink || !activeImage || !activeCaption || !nodes.length) return;

    const nodesBySlug = new Map();
    nodes.forEach((node) => {
      const slug = node.dataset.homeWorkSlug;
      if (slug && !nodesBySlug.has(slug)) {
        nodesBySlug.set(slug, node);
      }
    });

    const initialSlug = activeLink.getAttribute("data-artwork-slug");
    const initialCycleNode = initialSlug ? document.createElement("span") : null;
    if (initialCycleNode) {
      Object.entries(activeLink.dataset).forEach(([key, value]) => {
        initialCycleNode.dataset[key] = value;
      });
    }
    const orderedNodes = [
      initialCycleNode,
      ...heroNodes,
      ...nodes,
    ].filter(Boolean);
    const seenSlugs = new Set();
    const cycleNodes = orderedNodes.filter((node) => {
      const slug = node.dataset.homeWorkSlug;
      if (!slug || seenSlugs.has(slug)) return false;
      seenSlugs.add(slug);
      return true;
    });

    let activeIndex = Math.max(
      0,
      cycleNodes.findIndex((node) => node.dataset.homeWorkSlug === initialSlug),
    );
    let lastWheelShiftAt = 0;
    let activeImageAnimation = null;
    let activeImageGhostAnimation = null;
    let isHeroTransitioning = false;
    let heroTransitionTimer = 0;
    let wheelIntent = 0;
    let wheelIntentTimer = 0;
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const heroTransitionMs = 980;
    const wheelShiftCooldownMs = 760;
    const wheelShiftIntentThreshold = 150;

    const easeOutQuint = (progress) => 1 - Math.pow(1 - progress, 5);

    const scrollToNextSection = () => {
      const target = document.getElementById("selected-manifestations") || document.querySelector("[data-home-living-editorial]");
      if (!target) return;

      const startY = window.scrollY;
      const targetY = Math.max(0, target.getBoundingClientRect().top + window.scrollY);
      const distance = targetY - startY;
      const duration = reducedMotion.matches ? 0 : Math.min(1350, Math.max(860, Math.abs(distance) * 0.52));
      let startTime = 0;

      root.dataset.homeFieldAdvancing = "true";

      if (!duration) {
        window.scrollTo(0, targetY);
        window.setTimeout(() => {
          delete root.dataset.homeFieldAdvancing;
        }, 120);
        return;
      }

      const step = (timestamp) => {
        if (!startTime) startTime = timestamp;

        const progress = Math.min(1, (timestamp - startTime) / duration);
        const easedProgress = easeOutQuint(progress);
        window.scrollTo(0, startY + distance * easedProgress);

        if (progress < 1) {
          window.requestAnimationFrame(step);
        } else {
          window.setTimeout(() => {
            delete root.dataset.homeFieldAdvancing;
          }, 180);
        }
      };

      window.requestAnimationFrame(step);
    };

    const warmHeroImages = () => {
      cycleNodes.forEach((node) => {
        const source = node.dataset.homeWorkImage;
        if (!source) return;

        const preload = new Image();
        preload.decoding = "async";
        preload.sizes = "(min-width: 1200px) 34vw, (min-width: 760px) 56vw, 84vw";
        if (node.dataset.homeWorkSrcset) {
          preload.srcset = node.dataset.homeWorkSrcset;
        }
        preload.src = source;
        preload.decode?.().catch(() => undefined);
      });
    };

    if ("requestIdleCallback" in window) {
      window.requestIdleCallback(warmHeroImages, { timeout: 1200 });
    } else {
      window.setTimeout(warmHeroImages, 320);
    }

    const syncActiveStates = (slug) => {
      nodes.forEach((item) => {
        const isActive = item.dataset.homeWorkSlug === slug;
        item.classList.toggle("is-active", isActive);
        item.setAttribute("aria-current", isActive ? "true" : "false");
      });

      heroNodes.forEach((item, index) => {
        const itemSlug = item.dataset.homeWorkSlug;
        const itemIndex = cycleNodes.findIndex((node) => node.dataset.homeWorkSlug === itemSlug);
        const rawOffset = itemIndex - activeIndex;
        const wrappedOffset =
          rawOffset > cycleNodes.length / 2
            ? rawOffset - cycleNodes.length
            : rawOffset < -cycleNodes.length / 2
              ? rawOffset + cycleNodes.length
              : rawOffset;
        const slot = itemSlug === slug ? "active" : String(Math.max(-3, Math.min(3, wrappedOffset || index + 1)));
        item.dataset.homeSlot = slot;
      });
    };

    const setActiveFromNode = (node, options = {}) => {
      const { animateImage = true, dispatchAtmosphere = true } = options;
      const slug = node.dataset.homeWorkSlug;
      const label = node.dataset.homeWorkLabel || node.dataset.homeWorkTitle || slug;
      const context = node.dataset.homeWorkContext || "";
      const year = node.dataset.homeWorkYear || "";
      const image = node.dataset.homeWorkImage;
      const srcset = node.dataset.homeWorkSrcset || "";
      const alt = node.dataset.homeWorkAlt || label;
      const atmosphere = node.dataset.homeWorkAtmosphere || slug;

      if (!slug || !image) return false;

      const nextIndex = cycleNodes.findIndex((item) => item.dataset.homeWorkSlug === slug);
      if (nextIndex >= 0) {
        activeIndex = nextIndex;
      }

      if (slug === activeLink.getAttribute("data-artwork-slug")) {
        syncActiveStates(slug);
        return false;
      }

      const direction = root.dataset.homeHeroDirection === "prev" ? -1 : 1;
      const shouldAnimateImage = animateImage && !reducedMotion.matches;
      let ghostImage = null;

      if (shouldAnimateImage) {
        const activeRect = activeImage.getBoundingClientRect();
        const linkRect = activeLink.getBoundingClientRect();
        const currentSource = activeImage.currentSrc || activeImage.getAttribute("src");

        if (currentSource && activeRect.width && activeRect.height) {
          activeImageGhostAnimation?.cancel?.();
          activeLink.querySelectorAll(".home-selected-active-ghost").forEach((ghost) => ghost.remove());
          ghostImage = activeImage.cloneNode(false);
          ghostImage.className = "home-selected-active-ghost";
          ghostImage.removeAttribute("srcset");
          ghostImage.setAttribute("src", currentSource);
          ghostImage.setAttribute("alt", "");
          ghostImage.setAttribute("aria-hidden", "true");
          ghostImage.style.left = `${activeRect.left - linkRect.left}px`;
          ghostImage.style.top = `${activeRect.top - linkRect.top}px`;
          ghostImage.style.width = `${activeRect.width}px`;
          ghostImage.style.height = `${activeRect.height}px`;
          activeLink.appendChild(ghostImage);
        }
      }

      activeLink.setAttribute("href", `/works/${slug}`);
      activeLink.setAttribute("aria-label", `Open ${label}`);
      activeLink.setAttribute("data-artwork-slug", slug);
      activeLink.setAttribute("data-atmosphere-handoff-slug", atmosphere);

      activeImage.setAttribute("src", image);
      if (srcset) {
        activeImage.setAttribute("srcset", srcset);
      } else {
        activeImage.removeAttribute("srcset");
      }
      activeImage.setAttribute("alt", alt);

      activeCaption.textContent = `Active manifestation / ${label}${year ? ` / ${year}` : ""}`;

      if (activeContext) {
        activeContext.textContent = context;
      }

      if (activeRegister) {
        activeRegister.textContent = label;
      }

      if (activeObjectRoute) {
        activeObjectRoute.setAttribute("href", `/works/${slug}`);
        activeObjectRoute.setAttribute("data-atmosphere-handoff-slug", atmosphere);
      }

      handoffLinks.forEach((link) => {
        link.setAttribute("data-atmosphere-handoff-slug", atmosphere);
      });

      syncActiveStates(slug);

      window.dispatchEvent(
        new CustomEvent("artist-stage:home-prologue-target", {
          detail: {
            slug,
            source: "home-selected",
          },
        }),
      );

      if (shouldAnimateImage) {
        activeImageAnimation?.cancel?.();
        activeImageAnimation = activeImage.animate?.(
          [
            {
              opacity: 0.22,
              filter: "blur(8px) saturate(0.82) brightness(0.78)",
              transform: `translate3d(${direction * 2.2}rem, 18px, 0) scale(0.955)`,
            },
            {
              opacity: 0.82,
              filter: "blur(1.5px) saturate(0.96) brightness(0.94)",
              transform: `translate3d(${direction * 0.18}rem, 2px, 0) scale(0.995)`,
              offset: 0.72,
            },
            {
              opacity: 1,
              filter: "blur(0) saturate(1) brightness(1)",
              transform: "translate3d(0, 0, 0) scale(1)",
            },
          ],
          {
            duration: heroTransitionMs,
            easing: "cubic-bezier(0.16, 1, 0.3, 1)",
          },
        );

        if (ghostImage) {
          activeImageGhostAnimation = ghostImage.animate?.(
            [
              {
                opacity: 0.9,
                filter: "blur(0) saturate(1) brightness(1)",
                transform: "translate3d(0, 0, 0) scale(1)",
              },
              {
                opacity: 0,
                filter: "blur(8px) saturate(0.72) brightness(0.74)",
                transform: `translate3d(${direction * -2.6}rem, -18px, 0) scale(1.035)`,
              },
            ],
            {
              duration: heroTransitionMs + 180,
              easing: "cubic-bezier(0.16, 1, 0.3, 1)",
            },
          );
          const cleanupGhost = () => ghostImage?.remove();
          const ghostCleanupTimer = window.setTimeout(cleanupGhost, heroTransitionMs + 420);

          if (activeImageGhostAnimation?.finished) {
            activeImageGhostAnimation.finished
              .catch(() => undefined)
              .finally(() => {
                window.clearTimeout(ghostCleanupTimer);
                cleanupGhost();
              });
          }
        }
      }

      if (dispatchAtmosphere) {
        window.ArtistStageAtmosphereOrchestrator?.setTarget?.(atmosphere, {
          source: "home-selected",
          immediate: false,
        });

        window.dispatchEvent(
          new CustomEvent("artist-stage:artwork-atmosphere:set", {
            detail: {
              slug: atmosphere,
              source: "home-selected",
            },
          }),
        );
      }

      return true;
    };

    const runHeroFlight = (nextNode, direction) => {
      root.dataset.homeHeroDirection = direction > 0 ? "next" : "prev";
      return setActiveFromNode(nextNode, { animateImage: true });
    };

    const settleHeroTransition = (didChange) => {
      window.clearTimeout(heroTransitionTimer);
      heroTransitionTimer = window.setTimeout(() => {
        isHeroTransitioning = false;
        delete root.dataset.homeHeroTransitioning;
      }, heroTransitionMs + 140);

      if (!didChange) {
        isHeroTransitioning = false;
        delete root.dataset.homeHeroTransitioning;
      }
    };

    const activateHeroNode = (nextNode, direction) => {
      if (!nextNode || isHeroTransitioning) return false;

      isHeroTransitioning = true;
      root.dataset.homeHeroTransitioning = "true";

      const didChange = runHeroFlight(nextNode, direction || 1);
      settleHeroTransition(didChange);
      return didChange;
    };

    const getDirectionToNode = (node) => {
      const nextIndex = cycleNodes.findIndex((item) => item.dataset.homeWorkSlug === node.dataset.homeWorkSlug);
      if (nextIndex < 0 || nextIndex === activeIndex) return 0;

      const rawDelta = nextIndex - activeIndex;
      const wrappedDelta =
        Math.abs(rawDelta) > cycleNodes.length / 2
          ? rawDelta - Math.sign(rawDelta) * cycleNodes.length
          : rawDelta;

      return wrappedDelta > 0 ? 1 : -1;
    };

    const previewHeroNode = (node) => {
      if (isHeroTransitioning || node.classList.contains("is-active")) return;

      heroNodes.forEach((item) => item.classList.toggle("is-hovered", item === node));
      root.dataset.homePreviewSlug = node.dataset.homeWorkSlug || "";
      const atmosphere = node.dataset.homeWorkAtmosphere;
      if (atmosphere) {
        window.ArtistStageAtmosphereOrchestrator?.setTarget?.(atmosphere, {
          source: "home-orbit-preview",
          immediate: false,
        });
      }
    };

    const clearHeroNodePreview = (node) => {
      node?.classList.remove("is-hovered");
      if (node?.dataset.homeWorkSlug && root.dataset.homePreviewSlug === node.dataset.homeWorkSlug) {
        delete root.dataset.homePreviewSlug;
      }
    };

    const cycleActive = (direction) => {
      if (!cycleNodes.length || isHeroTransitioning) return;

      const nextIndex = (activeIndex + direction + cycleNodes.length) % cycleNodes.length;
      const nextNode = cycleNodes[nextIndex];
      if (nextNode) {
        activateHeroNode(nextNode, direction);
      }
    };

    nodes.forEach((node) => {
      node.addEventListener("focus", () => {
        if (node.hasAttribute("data-home-hero-node")) return;
        setActiveFromNode(node);
      });
    });

    heroNodes.forEach((node) => {
      node.addEventListener("pointerenter", () => previewHeroNode(node));
      node.addEventListener("pointerleave", () => clearHeroNodePreview(node));
      node.addEventListener("focus", () => previewHeroNode(node));
      node.addEventListener("blur", () => clearHeroNodePreview(node));

      node.addEventListener("click", (event) => {
        event.preventDefault();
        clearHeroNodePreview(node);
        const direction = getDirectionToNode(node);
        if (direction) {
          activateHeroNode(node, direction);
        }
      }, true);

      node.addEventListener("keydown", (event) => {
        if (event.key !== "Enter" && event.key !== " ") return;

        event.preventDefault();
        clearHeroNodePreview(node);
        const direction = getDirectionToNode(node);
        if (direction) {
          activateHeroNode(node, direction);
        }
      });
    });

    nextSectionButton?.addEventListener("click", scrollToNextSection);

    heroStage?.addEventListener(
      "wheel",
      (event) => {
        const dominantDelta =
          Math.abs(event.deltaY) >= Math.abs(event.deltaX) ? event.deltaY : event.deltaX;
        if (Math.abs(dominantDelta) < 14) return;

        event.preventDefault();

        const now = performance.now();
        if (isHeroTransitioning || now - lastWheelShiftAt < wheelShiftCooldownMs) return;

        wheelIntent += dominantDelta;
        window.clearTimeout(wheelIntentTimer);
        wheelIntentTimer = window.setTimeout(() => {
          wheelIntent = 0;
        }, 240);

        if (Math.abs(wheelIntent) < wheelShiftIntentThreshold) return;

        lastWheelShiftAt = now;
        cycleActive(wheelIntent > 0 ? 1 : -1);
        wheelIntent = 0;
      },
      { passive: false },
    );

    heroStage?.addEventListener("keydown", (event) => {
      if (event.key === "ArrowRight" || event.key === "ArrowDown") {
        event.preventDefault();
        cycleActive(1);
      }

      if (event.key === "ArrowLeft" || event.key === "ArrowUp") {
        event.preventDefault();
        cycleActive(-1);
      }
    });

    if (initialSlug) {
      syncActiveStates(initialSlug);
    }
  })();
</script>

