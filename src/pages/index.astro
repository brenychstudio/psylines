    width: min(13rem, 15vw);
    border-top: 1px solid rgba(235, 240, 232, 0.14);
    border-left: 1px solid rgba(235, 240, 232, 0.08);
    padding: 0.72rem 0 0 0.85rem;
    color: rgba(235, 240, 232, 0.52);
    font-size: 0.58rem;
    text-transform: uppercase;
