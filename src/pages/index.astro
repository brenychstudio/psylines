  }

  .home-field-register strong {
    color: rgba(245, 248, 242, 0.72);
    font-weight: 500;
  }

  .home-field-next {
    right: 0;
    bottom: 1.55rem;
  }

  .home-living-editorial {
    --home-field-cold: rgba(51, 106, 112, 0.12);
    --home-field-warm: rgba(151, 91, 39, 0.1);
    --home-light-x: 64%;
    --home-light-strength: 0.56;
    --home-light-opacity: 0.73;
    --home-light-sheen-opacity: 0.56;
    min-height: 344rem;
    margin-top: 0;
    border-top: 0;
    background: transparent;
