      linear-gradient(96deg, rgba(1, 4, 3, 0.7) 0%, rgba(1, 4, 3, 0.38) 18%, transparent 46%, transparent 74%, rgba(1, 4, 3, 0.3) 100%),
      linear-gradient(180deg, transparent 0%, rgba(1, 4, 3, 0.08) 18%, rgba(1, 4, 3, 0.2) 58%, rgba(1, 4, 3, 0.32) 100%);
    -webkit-mask-image: linear-gradient(
      180deg,
      transparent 0,
      rgba(0, 0, 0, 0.08) 8rem,
      black 34rem,
      black calc(100% - 28rem),
      transparent 100%
    );
    mask-image: linear-gradient(
      180deg,
      transparent 0,
      rgba(0, 0, 0, 0.08) 8rem,
      black 34rem,
      black calc(100% - 28rem),
      transparent 100%
    );
