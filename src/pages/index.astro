  .home-living-editorial__light {
    position: sticky;
    top: 0;
    width: 100%;
    height: 100svh;
    pointer-events: none;
    transform-origin: var(--home-light-x) 50%;
    background:
      radial-gradient(
        ellipse 46vw 72vh at var(--home-light-x) 48%,
        color-mix(in srgb, var(--artwork-glow), white 7%) 0%,
        color-mix(in srgb, var(--artwork-glow), transparent 46%) 34%,
        transparent 74%
      ),
      radial-gradient(
        ellipse 24vw 62vh at calc(var(--home-light-x) + 4%) 46%,
        color-mix(in srgb, var(--artwork-accent), transparent 84%) 0%,
        transparent 76%
      );
    opacity: var(--home-light-opacity);
    animation: homeEditorialLightBreath 18s ease-in-out infinite;
    will-change: transform, opacity;
