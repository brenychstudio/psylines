  .home-route-signals {
    margin-top: clamp(0.95rem, 2svh, 1.35rem);
  }

  .home-route-signals a,
  .home-selected-route-actions a {
    letter-spacing: 0;
  }

  .home-selected-field {
    inset: 0 var(--site-frame-gutter) 0;
    min-height: 100%;
    cursor: default;
    perspective-origin: 70% 48%;
  }

  .home-selected-field::after {
    content: "";
    position: absolute;
    left: 48%;
    right: 2%;
    bottom: 5.1rem;
    z-index: 1;
    height: 1px;
    pointer-events: none;
    background: linear-gradient(90deg, transparent, rgba(235, 240, 232, 0.12), transparent);
  }

  .home-selected-plane--active {
    left: 71.5%;
    top: 48.5%;
    width: clamp(320px, 25.5vw, 560px);
  }

  .home-selected-orbit::before {
    background: none;
  }

  .home-selected-plane--active,
  .home-selected-plane--orbit {
    isolation: isolate;
  }

  .home-selected-plane--active::before {
    inset: -20% -24%;
    background:
      radial-gradient(ellipse at 50% 48%, rgba(1, 4, 3, 0.82) 0%, rgba(1, 4, 3, 0.58) 38%, rgba(1, 4, 3, 0.18) 62%, transparent 78%),
      radial-gradient(ellipse at 52% 56%, var(--artwork-glow), transparent 64%);
    opacity: 0.88;
    filter: blur(14px);
  }

  .home-selected-plane--orbit::before {
    inset: -28% -30%;
    background:
      radial-gradient(ellipse at 50% 50%, rgba(1, 4, 3, 0.76) 0%, rgba(1, 4, 3, 0.48) 42%, rgba(1, 4, 3, 0.12) 66%, transparent 80%),
      radial-gradient(ellipse at 50% 55%, var(--artwork-shadow), transparent 72%);
    opacity: 0.82;
    filter: blur(12px);
    transform: scale(1);
  }

  .home-selected-plane--active img {
    max-height: min(66svh, 720px);
    filter: saturate(1.04) brightness(1.015) contrast(1.025);
    box-shadow:
      0 48px 128px rgba(0, 0, 0, 0.56),
      0 0 0 1px rgba(255, 255, 255, 0.07);
  }

  .home-selected-plane--orbit {
    opacity: 0.54;
  }

  .home-selected-plane--orbit img {
    filter: saturate(1.03) brightness(1.02) contrast(1.035);
    box-shadow:
      0 28px 82px rgba(0, 0, 0, 0.66),
      0 0 0 1px rgba(245, 248, 242, 0.065);
  }

  .home-selected-plane--orbit[data-home-slot="-3"],
  .home-selected-plane--orbit[data-home-slot="3"] {
    opacity: 0.34;
  }

  .home-selected-plane--orbit[data-home-slot="-2"] {
    opacity: 0.5;
  }

  .home-selected-plane--orbit[data-home-slot="-1"] {
    left: 55%;
    opacity: 0.76;
  }

  .home-selected-plane--orbit[data-home-slot="1"] {
    left: 89%;
    opacity: 0.72;
  }

  .home-selected-plane--orbit[data-home-slot="2"] {
    opacity: 0.46;
  }

  .home-selected-plane--orbit.is-active,
  .home-selected-plane--orbit[data-home-slot="active"] {
    opacity: 0;
    visibility: hidden;
  }

  .home-selected-plane--orbit:not(.is-active):not([data-home-slot="active"]) {
    visibility: visible;
  }

  .home-selected-plane--active span,
  .home-selected-plane--orbit span,
  .home-field-next,
  .home-field-register,
  .home-field-chapter {
    letter-spacing: 0;
  }

  .home-field-chapter {
    position: absolute;
    top: clamp(1.25rem, 3svh, 2.5rem);
    right: 0;
    z-index: 15;
    margin: 0;
    color: rgba(235, 240, 232, 0.44);
    font-size: 0.62rem;
    line-height: 1;
    text-transform: uppercase;
  }

  .home-field-register {
    position: absolute;
    right: 0;
    bottom: 5.75rem;
