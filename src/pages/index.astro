    .home-route-work--1,
    .home-route-work--2,
    .home-route-work--3,
    .home-route-work--4,
    .home-route-work--5,
    .home-route-work--6 {
      grid-column: auto;
      margin-top: 0;
      width: auto;
      opacity: 0.86;
    }

    .home-selected-thin-register {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .home-living-editorial {
      min-height: auto;
      padding: clamp(5rem, 12vw, 7rem) 0;
    }

    .home-living-editorial__spine,
    .home-living-notes {
      display: none;
    }

    .home-living-copy {
      position: relative;
      top: auto;
      width: min(100% - 2rem, 42rem);
      min-height: 20rem;
      margin: 0 auto 2.5rem;
    }

    .home-living-field {
      position: relative;
      inset: auto;
      width: min(100% - 2rem, 48rem);
      margin-inline: auto;
      display: grid;
      gap: 3rem;
    }

    .home-living-card {
      position: relative;
      top: auto;
      left: auto;
      width: 100%;
      opacity: 1 !important;
      transform: none !important;
    }

    .home-living-focus {
      display: block;
      overflow-y: auto;
      padding: clamp(5rem, 16vw, 6rem) 1rem 2rem;
    }

    .home-living-focus__image {
      position: relative;
      left: auto;
      top: auto;
      width: min(100%, 28rem);
      height: auto;
      margin-inline: auto;
      animation: homeFocusMobileImageIn 620ms cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    .home-living-focus__image img {
      width: 100%;
      height: auto;
      max-height: 68svh;
    }

    .home-living-focus__copy {
      position: relative;
      right: auto;
      top: auto;
      box-sizing: border-box;
      width: 100%;
      max-width: 32rem;
      margin: 1.6rem auto 0;
      padding-left: 1rem;
      transform: none;
      animation: homeFocusMobileCopyIn 620ms 80ms cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    .home-living-focus[data-closing="true"] .home-living-focus__copy {
      animation: homeFocusMobileCopyOut 380ms cubic-bezier(0.7, 0, 0.84, 0) both;
    }

    .home-living-focus__copy h3 {
      max-width: 100%;
      font-size: clamp(2.2rem, 12vw, 4rem);
    }
  }

  @media (max-width: 699px) {
    .home-title {
      max-width: 9ch;
      font-size: clamp(3.1rem, 13vw, 5rem);
    }

    .home-copy,
    .home-secondary-line,
    .home-active-context {
      max-width: min(32rem, calc(100vw - 2rem));
    }

    .home-route-signals {
      display: grid;
      gap: 0.65rem;
    }
  }

  @media (max-width: 560px) {
    .home-manifestation-field {
      padding-top: clamp(5.5rem, 15vw, 6.5rem);
    }

    .home-threshold-field,
    .home-selected-route-scene {
      width: 100%;
      max-width: none;
    }

    .home-title {
      max-width: 100%;
      font-size: clamp(2rem, 9vw, 3.2rem);
      overflow-wrap: normal;
      word-break: normal;
      hyphens: manual;
    }

    .home-selected-field {
      min-height: 520px;
    }

    .home-selected-plane--active {
      width: min(340px, 82vw);
    }

    .home-selected-plane--orbit {
      opacity: 0.18;
    }

    .home-selected-field-hint {
      display: none;
    }

    .home-field-next {
      bottom: clamp(3.35rem, 7svh, 4.5rem);
    }

    .home-selected-plane--orbit-4,
    .home-selected-plane--orbit-5,
    .home-selected-plane--orbit-6 {
      display: none;
    }

    .home-selected-route-stage {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .home-route-work:nth-child(n + 5) {
      display: none;
    }

    .home-selected-route-actions {
      display: grid;
    }

    .home-selected-thin-register {
      grid-template-columns: 1fr;
    }

    .home-living-copy {
      min-height: 18rem;
    }

    .home-living-copy h2 {
      max-width: 100%;
      font-size: clamp(2.2rem, 12vw, 3.8rem);
    }

    .home-living-field {
      width: calc(100vw - 1.5rem);
      gap: 2.35rem;
    }

    .home-copy,
    .home-secondary-line,
    .home-active-context,
    .home-selected-route-scene__intro p,
    .home-route-work div,
    .home-selected-thin-register a {
      overflow-wrap: anywhere;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-manifestation-field::before,
    .home-selected-plane--active,
    .home-selected-plane--active img,
    .home-selected-plane--orbit img,
    .home-selected-plane--orbit,
    .home-route-work,
    .home-living-copy__state,
    .home-living-card {
      transition: none;
      animation: none;
    }
  }

  @keyframes homeFocusMobileImageIn {
    from {
      opacity: 0;
      transform: translate3d(0, 1.25rem, 0) scale(0.96);
    }

    to {
      opacity: 1;
      transform: translate3d(0, 0, 0) scale(1);
    }
  }

  @keyframes homeFocusMobileCopyIn {
    from {
      opacity: 0;
      filter: blur(10px);
      transform: translate3d(0, 1rem, 0);
    }

    to {
      opacity: 1;
      filter: blur(0);
      transform: translate3d(0, 0, 0);
    }
  }

  @keyframes homeFocusMobileCopyOut {
    from {
      opacity: 1;
      filter: blur(0);
      transform: translate3d(0, 0, 0);
    }

    to {
      opacity: 0;
      filter: blur(8px);
      transform: translate3d(0, 0.75rem, 0);
    }
  }

  /* Home Living Overture - one material field from threshold to archive. */
  .home-manifestation-field {
    z-index: 1;
    isolation: isolate;
    padding: 0 0 clamp(3.5rem, 6vw, 6rem);
    background: transparent;
  }

  .home-manifestation-field::before {
    position: fixed;
    inset: var(--site-header-height) 0 0;
    height: auto;
    z-index: -1;
    background:
      linear-gradient(90deg, rgba(2, 5, 4, 0.12), transparent 42%, rgba(2, 5, 4, 0.035)),
      linear-gradient(180deg, rgba(2, 5, 4, 0.01), rgba(2, 5, 4, 0.1) 58%, rgba(2, 5, 4, 0.48));
    opacity: 1;
  }

  .home-threshold-field {
    min-height: calc(100svh - var(--site-header-height) - 2rem);
    padding-inline: var(--site-frame-gutter);
    grid-template-columns: minmax(350px, 40rem) minmax(0, 1fr);
    align-items: center;
    overflow: hidden;
  }

  .home-threshold-field > * {
    transform: none;
  }

  .home-threshold-field::before {
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, rgba(2, 5, 4, 0.9) 0%, rgba(2, 5, 4, 0.7) 24%, rgba(2, 5, 4, 0.24) 48%, rgba(2, 5, 4, 0.025) 68%, rgba(2, 5, 4, 0.1) 100%),
      linear-gradient(180deg, rgba(2, 5, 4, 0.16), transparent 32%, transparent 72%, rgba(2, 5, 4, 0.52));
    background-size: auto;
    mask-image: none;
    opacity: 1;
  }

  .home-threshold-copy {
    z-index: 18;
    width: min(40rem, 42vw);
    max-width: 40rem;
    background: none;
  }

  .home-threshold-copy::before {
    inset: -12% -18% -12% -8%;
    background: linear-gradient(90deg, rgba(2, 5, 4, 0.72), rgba(2, 5, 4, 0.24) 68%, transparent);
    filter: blur(8px);
  }

  .home-kicker {
    margin-bottom: clamp(0.85rem, 1.7svh, 1.15rem);
    color: rgba(235, 240, 232, 0.58);
  }

  .home-title {
    max-width: 8ch;
    font-size: 6.2rem;
    line-height: 0.82;
    letter-spacing: 0;
    text-wrap: nowrap;
  }

  .home-title span {
    display: block;
  }

  .home-title span:last-child {
    color: rgba(245, 248, 242, 0.72);
  }

  .home-manifesto {
    max-width: 19ch;
    margin: clamp(1rem, 2svh, 1.45rem) 0 0;
    color: rgba(245, 248, 242, 0.88);
    font-size: 1.75rem;
    font-weight: 300;
    line-height: 1.08;
    text-wrap: balance;
  }

  .home-copy {
    max-width: 35rem;
    margin-top: clamp(0.8rem, 1.5svh, 1.1rem);
    color: rgba(235, 240, 232, 0.62);
    font-size: 0.98rem;
    line-height: 1.55;
  }

  .home-active-context {
    margin-top: 0.7rem;
    color: rgba(235, 240, 232, 0.5);
    letter-spacing: 0;
