  .home-living-editorial::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 0;
    height: 38rem;
    pointer-events: none;
    background:
      linear-gradient(90deg, rgba(2, 5, 4, 0.9) 0%, rgba(2, 5, 4, 0.7) 24%, rgba(2, 5, 4, 0.24) 48%, rgba(2, 5, 4, 0.025) 68%, rgba(2, 5, 4, 0.1) 100%),
      linear-gradient(180deg, rgba(2, 5, 4, 0.52), rgba(2, 5, 4, 0.3) 36%, rgba(2, 5, 4, 0.08) 72%, transparent 100%);
    -webkit-mask-image: linear-gradient(180deg, black 0%, rgba(0, 0, 0, 0.82) 24%, rgba(0, 0, 0, 0.28) 70%, transparent 100%);
    mask-image: linear-gradient(180deg, black 0%, rgba(0, 0, 0, 0.82) 24%, rgba(0, 0, 0, 0.28) 70%, transparent 100%);
