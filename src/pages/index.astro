  .home-living-editorial__light::before,
  .home-living-editorial__light::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .home-living-editorial__light::before {
    background:
      radial-gradient(
        ellipse 34vw 68vh at calc(var(--home-light-x) - 34%) 54%,
        rgba(0, 0, 0, 0.58) 0%,
        rgba(0, 0, 0, 0.28) 42%,
        transparent 76%
