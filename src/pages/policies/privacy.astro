---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AtmosphericBackdropRoot from "../../app/atmosphere/AtmosphericBackdropSystem/AtmosphericBackdropRoot.astro";

const sections = [
  {
    title: "Checkout data",
    copy: "Checkout is handled through Stripe. Payment details are processed by Stripe rather than stored directly by this site.",
  },
  {
    title: "Contact messages",
    copy: "Messages sent through studio contact routes may include name, contact details, inquiry context, and selected work references supplied by the sender.",
  },
  {
    title: "Order context",
    copy: "Collector communication may reference selected work, edition, destination, shipping needs, and certificate or documentation context.",
  },
  {
    title: "Launch review",
    copy: "This privacy page is production trust context and should be reviewed before public live sales.",
  },
];
---
<BaseLayout
  title="Privacy - ARTIST STAGE"
  description="Minimal privacy context for collector checkout, Stripe processing, and studio contact messages."
  canonicalPath="/policies/privacy"
>
  <AtmosphericBackdropRoot />

  <section class="policy-shell">
    <div class="policy-hero">
      <p class="policy-kicker">production policy</p>
      <h1>Privacy</h1>
      <p>
        This site keeps privacy language minimal at production-prep stage. It does not claim
        analytics or tracking systems that are not implemented.
      </p>
    </div>

    <div class="policy-grid">
      {sections.map((section) => (
        <article class="policy-card">
          <h2>{section.title}</h2>
          <p>{section.copy}</p>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .policy-shell {
    position: relative;
    z-index: 1;
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
    padding: 7.5rem 0 5rem;
  }

  .policy-hero {
    display: grid;
    gap: 1rem;
    max-width: 760px;
  }

  .policy-kicker {
    margin: 0;
    color: rgba(229, 232, 242, 0.48);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .policy-hero h1 {
    margin: 0;
    color: rgba(244, 241, 234, 0.95);
    font-size: 5.2rem;
    font-weight: 300;
    line-height: 0.92;
    letter-spacing: 0;
  }

  .policy-hero p,
  .policy-card p {
    margin: 0;
    color: rgba(229, 232, 242, 0.66);
    line-height: 1.75;
  }

  .policy-grid {
    display: grid;
    gap: 0.85rem;
    margin-top: 4rem;
  }

  .policy-card {
    display: grid;
    gap: 0.7rem;
    border: 1px solid rgba(255, 255, 255, 0.075);
    border-radius: 1.25rem;
    background: rgba(255, 255, 255, 0.025);
    padding: 1rem;
  }

  .policy-card h2 {
    margin: 0;
    color: rgba(244, 241, 234, 0.86);
    font-size: 1.35rem;
    font-weight: 300;
    line-height: 1.08;
    letter-spacing: 0;
  }

  @media (min-width: 760px) {
    .policy-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .policy-shell {
      width: min(100% - 32px, 1180px);
      padding-top: 6rem;
    }

    .policy-hero h1 {
      font-size: 3.45rem;
    }
  }
</style>
