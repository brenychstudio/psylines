---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AtmosphericBackdropRoot from "../../app/atmosphere/AtmosphericBackdropSystem/AtmosphericBackdropRoot.astro";

const sections = [
  {
    title: "Returns overview",
    copy: "Return or review terms may depend on work type, destination, production state, and condition. This page is production process context and should be reviewed before live sales.",
  },
  {
    title: "Prints",
    copy: "Print editions may have a clearer review route when returned in original condition and packaging, subject to the final terms confirmed for launch.",
  },
  {
    title: "Originals",
    copy: "Original work cases may require direct studio review because each object is one-of-one and may involve different handling, documentation, or shipping conditions.",
  },
  {
    title: "Condition and packaging",
    copy: "Any review depends on the work returning safely, with protective packaging and documentation retained where applicable.",
  },
];
---
<BaseLayout
  title="Returns — Rostyslav Brenych"
  description="Return and review process context for prints, originals, condition, and packaging."
  canonicalPath="/policies/returns"
>
  <AtmosphericBackdropRoot />

  <section class="policy-shell">
    <div class="policy-hero">
      <p class="policy-kicker">production policy</p>
      <h1>Returns</h1>
      <p>
        Return language here is collector process context, not final legal text.
        Print editions and original works may be reviewed differently.
      </p>
    </div>

    <div class="policy-grid">
      {sections.map((section) => (
        <article class="policy-card">
          <h2>{section.title}</h2>
          <p>{section.copy}</p>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .policy-shell {
    position: relative;
    z-index: 1;
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
    padding: 7.5rem 0 5rem;
  }

  .policy-hero {
    display: grid;
    gap: 1rem;
    max-width: 760px;
  }

  .policy-kicker {
    margin: 0;
    color: rgba(229, 232, 242, 0.48);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .policy-hero h1 {
    margin: 0;
    color: rgba(244, 241, 234, 0.95);
    font-size: 5.2rem;
    font-weight: 300;
    line-height: 0.92;
    letter-spacing: 0;
  }

  .policy-hero p,
  .policy-card p {
    margin: 0;
    color: rgba(229, 232, 242, 0.66);
    line-height: 1.75;
  }

  .policy-grid {
    display: grid;
    gap: 0.85rem;
    margin-top: 4rem;
  }

  .policy-card {
    display: grid;
    gap: 0.7rem;
    border: 1px solid rgba(255, 255, 255, 0.075);
    border-radius: 1.25rem;
    background: rgba(255, 255, 255, 0.025);
    padding: 1rem;
  }

  .policy-card h2 {
    margin: 0;
    color: rgba(244, 241, 234, 0.86);
    font-size: 1.35rem;
    font-weight: 300;
    line-height: 1.08;
    letter-spacing: 0;
  }

  @media (min-width: 760px) {
    .policy-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .policy-shell {
      width: min(100% - 32px, 1180px);
      padding-top: 6rem;
    }

    .policy-hero h1 {
      font-size: 3.45rem;
    }
  }
</style>
