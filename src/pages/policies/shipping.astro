---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AtmosphericBackdropRoot from "../../app/atmosphere/AtmosphericBackdropSystem/AtmosphericBackdropRoot.astro";

const sections = [
  {
    title: "Shipping overview",
    copy: "Shipping route and timing depend on the selected work, destination, format, and production state. Timing shown on work pages is estimated collector context, not a guarantee.",
  },
  {
    title: "Production before shipping",
    copy: "Editioned works may be produced after checkout. The selected object page carries the most relevant production note before the collector route continues.",
  },
  {
    title: "Regions",
    copy: "Spain, EU, and worldwide routes may be available depending on the work and destination. Final handling and timing are confirmed through checkout or studio contact where needed.",
  },
  {
    title: "Collector handling",
    copy: "Works are prepared with collector handling in mind, including protective packaging and documentation context where applicable.",
  },
];
---
<BaseLayout
  title="Shipping — Rostyslav Brenych"
  description="Shipping process context for collector orders, production timing, regions, and handling."
  canonicalPath="/policies/shipping"
>
  <AtmosphericBackdropRoot />

  <section class="policy-shell">
    <div class="policy-hero">
      <p class="policy-kicker">production policy</p>
      <h1>Shipping</h1>
      <p>
        Shipping expectations are kept visible as collector process context for
        confidence before production launch.
      </p>
    </div>

    <div class="policy-grid">
      {sections.map((section) => (
        <article class="policy-card">
          <h2>{section.title}</h2>
          <p>{section.copy}</p>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .policy-shell {
    position: relative;
    z-index: 1;
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
    padding: 7.5rem 0 5rem;
  }

  .policy-hero {
    display: grid;
    gap: 1rem;
    max-width: 760px;
  }

  .policy-kicker {
    margin: 0;
    color: rgba(229, 232, 242, 0.48);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .policy-hero h1 {
    margin: 0;
    color: rgba(244, 241, 234, 0.95);
    font-size: 5.2rem;
    font-weight: 300;
    line-height: 0.92;
    letter-spacing: 0;
  }

  .policy-hero p,
  .policy-card p {
    margin: 0;
    color: rgba(229, 232, 242, 0.66);
    line-height: 1.75;
  }

  .policy-grid {
    display: grid;
    gap: 0.85rem;
    margin-top: 4rem;
  }

  .policy-card {
    display: grid;
    gap: 0.7rem;
    border: 1px solid rgba(255, 255, 255, 0.075);
    border-radius: 1.25rem;
    background: rgba(255, 255, 255, 0.025);
    padding: 1rem;
  }

  .policy-card h2 {
    margin: 0;
    color: rgba(244, 241, 234, 0.86);
    font-size: 1.35rem;
    font-weight: 300;
    line-height: 1.08;
    letter-spacing: 0;
  }

  @media (min-width: 760px) {
    .policy-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .policy-shell {
      width: min(100% - 32px, 1180px);
      padding-top: 6rem;
    }

    .policy-hero h1 {
      font-size: 3.45rem;
    }
  }
</style>
