---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AtmosphericBackdropRoot from "../../app/atmosphere/AtmosphericBackdropSystem/AtmosphericBackdropRoot.astro";

const sections = [
  {
    title: "Availability",
    copy: "Artwork availability may change. Originals, editions, and selected formats are confirmed through the relevant work page or studio communication.",
  },
  {
    title: "Prices",
    copy: "Prices may be updated before checkout. The selected checkout or studio confirmation carries the active price context.",
  },
  {
    title: "Checkout",
    copy: "Checkout is handled securely through Stripe where available. Do not send payment details through general studio contact.",
  },
  {
    title: "Production and shipping",
    copy: "Production and shipping timing depend on the selected work, destination, and production state. Final legal text should be reviewed before live launch.",
  },
];
---
<BaseLayout
  title="Terms - ARTIST STAGE"
  description="Studio process terms for artwork availability, pricing, checkout, production, and shipping."
  canonicalPath="/policies/terms"
>
  <AtmosphericBackdropRoot />

  <section class="policy-shell">
    <div class="policy-hero">
      <p class="policy-kicker">production policy</p>
      <h1>Terms</h1>
      <p>
        These terms are clear studio process language for production trust context. They
        should be reviewed as final legal text before live public sales.
      </p>
    </div>

    <div class="policy-grid">
      {sections.map((section) => (
        <article class="policy-card">
          <h2>{section.title}</h2>
          <p>{section.copy}</p>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .policy-shell {
    position: relative;
    z-index: 1;
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
    padding: 7.5rem 0 5rem;
  }

  .policy-hero {
    display: grid;
    gap: 1rem;
    max-width: 760px;
  }

  .policy-kicker {
    margin: 0;
    color: rgba(229, 232, 242, 0.48);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .policy-hero h1 {
    margin: 0;
    color: rgba(244, 241, 234, 0.95);
    font-size: 5.2rem;
    font-weight: 300;
    line-height: 0.92;
    letter-spacing: 0;
  }

  .policy-hero p,
  .policy-card p {
    margin: 0;
    color: rgba(229, 232, 242, 0.66);
    line-height: 1.75;
  }

  .policy-grid {
    display: grid;
    gap: 0.85rem;
    margin-top: 4rem;
  }

  .policy-card {
    display: grid;
    gap: 0.7rem;
    border: 1px solid rgba(255, 255, 255, 0.075);
    border-radius: 1.25rem;
    background: rgba(255, 255, 255, 0.025);
    padding: 1rem;
  }

  .policy-card h2 {
    margin: 0;
    color: rgba(244, 241, 234, 0.86);
    font-size: 1.35rem;
    font-weight: 300;
    line-height: 1.08;
    letter-spacing: 0;
  }

  @media (min-width: 760px) {
    .policy-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .policy-shell {
      width: min(100% - 32px, 1180px);
      padding-top: 6rem;
    }

    .policy-hero h1 {
      font-size: 3.45rem;
    }
  }
</style>
