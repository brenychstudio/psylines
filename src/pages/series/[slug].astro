  /* V3-41 - Cinematic Series Chapter Surface */
  .series-chapter {
    --series-arrival-accent: var(--artwork-accent);
    --series-arrival-wash: var(--artwork-wash-strong);
    --series-arrival-ink: var(--artwork-shadow-wash);
    padding: clamp(6rem, 8vw, 8rem) 0 clamp(6rem, 10vw, 10rem);
    background:
      linear-gradient(180deg, rgba(5, 8, 7, 0.38), rgba(2, 4, 4, 0.2) 26%, rgba(2, 4, 4, 0.62) 100%);
    isolation: isolate;
  }

  .series-chapter-arrival-field {
    position: absolute;
    inset: 0 0 auto;
    z-index: 1;
    height: min(68rem, 100svh);
    pointer-events: none;
    overflow: hidden;
    background:
      conic-gradient(
        from 218deg at 61% 46%,
        transparent 0 16%,
        color-mix(in srgb, var(--series-arrival-wash), transparent 48%) 29%,
        transparent 47%,
        color-mix(in srgb, var(--series-arrival-accent), transparent 62%) 66%,
        transparent 84%
      ),
      linear-gradient(
        118deg,
        color-mix(in srgb, var(--series-arrival-ink), black 22%),
        transparent 48%,
        color-mix(in srgb, var(--series-arrival-wash), transparent 66%) 72%,
        transparent 92%
      );
    background-size: 146% 146%, 138% 154%;
    background-position: 46% 52%, 28% 44%;
    mix-blend-mode: screen;
    mask-image: linear-gradient(180deg, black 0, black 76%, transparent 100%);
    opacity: 0;
    transform: scale(1.035);
  }

  .series-chapter[data-series-chapter-arrival="entering"] .series-chapter-arrival-field {
    animation: seriesChapterArrivalCurrent 2200ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  html[data-cinematic-transition="arriving"] .series-chapter[data-series-chapter-arrival="entering"] .series-chapter-hero__copy,
  html[data-cinematic-transition="arriving"] .series-chapter[data-series-chapter-arrival="entering"] .series-hero-carousel__controls,
  html[data-cinematic-transition="arriving"] .series-chapter[data-series-chapter-arrival="entering"] .series-hero-frame:not([data-slot="active"]) {
    opacity: 0;
  }

  html[data-cinematic-transition="arriving-active"] .series-chapter[data-series-chapter-arrival="entering"] .series-chapter-hero__copy {
    animation: seriesChapterArrivalCopy 1380ms 180ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  html[data-cinematic-transition="arriving-active"] .series-chapter[data-series-chapter-arrival="entering"] .series-hero-carousel__controls {
    animation: seriesChapterArrivalControls 1180ms 460ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  html[data-cinematic-transition="arriving-active"] .series-chapter[data-series-chapter-arrival="entering"] .series-hero-frame:not([data-slot="active"]) {
    animation: seriesChapterArrivalPeripheral 1440ms 320ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes seriesChapterArrivalCurrent {
    0% {
      opacity: 0.82;
      background-position: 42% 56%, 24% 48%;
      transform: scale(1.08);
    }

    46% {
      opacity: 0.54;
    }

    100% {
      opacity: 0;
      background-position: 58% 43%, 76% 52%;
      transform: scale(1.015);
    }
  }

  @keyframes seriesChapterArrivalCopy {
    0% {
      opacity: 0;
      filter: blur(4px);
      transform: translate3d(-1.4rem, 0.5rem, 0);
    }

    100% {
      opacity: 1;
      filter: blur(0);
      transform: translate3d(0, 0, 0);
    }
  }

  @keyframes seriesChapterArrivalControls {
    0% {
      opacity: 0;
      transform: translate3d(0, 0.7rem, 0);
    }

    100% {
      opacity: 1;
      transform: translate3d(0, 0, 0);
    }
  }

  @keyframes seriesChapterArrivalPeripheral {
    0% {
      opacity: 0;
      filter: blur(3px) brightness(0.58);
    }

    100% {
      opacity: var(--series-hero-opacity);
      filter: blur(var(--series-hero-blur)) brightness(var(--series-hero-brightness));
    }
  }

