---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AtmosphericBackdropRoot from "../../app/atmosphere/AtmosphericBackdropSystem/AtmosphericBackdropRoot.astro";
import ArtworkAtmosphereBridge from "../../components/artwork-atmosphere/ArtworkAtmosphereBridge.astro";
import { artworkSeries, getSeriesBySlug } from "../../data/site/series";
import { getSeriesArtworks } from "../../data/site/artworkCollections";
import { getArtworkAtmosphereProfile } from "../../lib/artwork-atmosphere/artworkAtmosphereProfiles";
import { getResponsivePublicImage } from "../../lib/assets/responsiveImage";

export function getStaticPaths() {
  return artworkSeries.map((series) => ({
    params: { slug: series.slug },
    props: { series },
  }));
}

const routeSeries = Astro.props.series ?? getSeriesBySlug(Astro.params.slug);

if (!routeSeries) {
  throw new Error("Series chapter requires a valid series.");
}

const series = routeSeries;
const seriesSeoTitle = series.id === "meta-bodies"
  ? "Inner Structures — Rostyslav Brenych"
  : `${series.title} — Rostyslav Brenych`;
const seriesDisplayTitle = series.title.replace(/\s+\/\s+/g, " ");
const seriesWorks = getSeriesArtworks(series.id);
const selectedSeriesWorks = seriesWorks.filter(
  (work) => series.selectedWorkSlugs.includes(work.slug) || work.meta.isSelected,
);

const flagshipWork =
  seriesWorks.find((work) => series.flagshipWorkSlugs.includes(work.slug)) ??
  seriesWorks.find((work) => work.meta.isFlagship) ??
  seriesWorks[0] ??
  null;

const displaySelectedWorks =
  selectedSeriesWorks.length > 0
    ? selectedSeriesWorks
    : seriesWorks.slice(0, 4);

const orderedSeriesWorks = flagshipWork
  ? [flagshipWork, ...seriesWorks.filter((work) => work.slug !== flagshipWork.slug)]
  : seriesWorks;
const sequenceWorks = orderedSeriesWorks.length > 0 ? orderedSeriesWorks : displaySelectedWorks;
const heroWorks = sequenceWorks;
const sequenceLayouts = ["hero", "right", "left", "wide", "portrait", "standard", "offset-left", "offset-right"] as const;
const seriesToneByMood = {
  metaBodies: "earth",
  nightWater: "blue",
  studies: "ash",
  independent: "neutral",
} as const;
const seriesTone = seriesToneByMood[series.mood] ?? "neutral";
const visibleSeries = [...artworkSeries].sort((a, b) => a.order - b.order);
const seriesIndex = visibleSeries.findIndex((item) => item.slug === series.slug);
const previousSeries = visibleSeries[(seriesIndex - 1 + visibleSeries.length) % visibleSeries.length];
const nextSeries = visibleSeries[(seriesIndex + 1) % visibleSeries.length];

const chapterAtmosphereSlug =
  flagshipWork?.meta.atmosphereProfile ??
  series.atmosphereProfile ??
  "default";

const hasWorks = seriesWorks.length > 0;

const getWorkImage = (work: (typeof seriesWorks)[number], defaultWidth = 960) =>
  getResponsivePublicImage(work.cover, { defaultWidth });
const getWorkImageAlt = (work: (typeof seriesWorks)[number]) => work.title || "Artwork";

const getWorkAtmosphereSlug = (work: (typeof seriesWorks)[number]) => work.meta.atmosphereProfile || work.slug;
const getWorkAtmosphereVars = (work: (typeof seriesWorks)[number]) => {
  const profile = getArtworkAtmosphereProfile(getWorkAtmosphereSlug(work));

  return [
    `--work-wash: ${profile.washStrong}`,
    `--work-glow: ${profile.glow}`,
    `--work-accent: ${profile.accent}`,
    `--work-shadow: ${profile.shadowWash}`,
  ].join("; ");
};

const getHeroSlot = (index: number, total: number) => {
  if (index === 0) return "active";
  if (total <= 1) return "active";
  if (index === 1) return "next";
  if (index === total - 1) return "prev";
  if (index === 2) return "far-next";
  if (index === total - 2) return "far-prev";
  return "hidden";
};
---
<BaseLayout
  title={seriesSeoTitle}
  description={series.statement}
  canonicalPath={`/series/${series.slug}`}
  hideFooter
>
  <ArtworkAtmosphereBridge slug={chapterAtmosphereSlug} mode="page" />

  <div
    class={`series-chapter series-chapter--${series.slug}`}
    data-tone={seriesTone}
    data-works-atmosphere-field
    data-series-chapter
    data-series-slug={series.slug}
    data-cinematic-idle-root
    data-cinematic-idle-delay="6400"
    data-cinematic-idle-reduced-delay="9800"
    data-cinematic-idle-wake-duration="3900"
    data-cinematic-idle-settle-duration="3200"
    data-cinematic-idle-dream-duration="8800"
  >
    <div class="series-chapter-arrival-field" aria-hidden="true"></div>
    <script is:inline define:vars={{ chapterSlug: series.slug }}>
      (() => {
        const root = document.currentScript?.closest("[data-series-chapter]");
        if (!root) return;

        try {
          const transition = JSON.parse(sessionStorage.getItem("artist-stage:cinematic-transition") || "null");
          const handoff = JSON.parse(sessionStorage.getItem("artist-stage:series-constellation-handoff") || "null");
          let referrerPath = "";
          try {
            referrerPath = document.referrer ? new URL(document.referrer).pathname.replace(/\/+$/, "") : "";
          } catch {
            referrerPath = "";
          }
          const isMapArrival =
            document.documentElement.dataset.cinematicHandoffKind === "series-chapter" &&
            transition?.slug === chapterSlug;
          const isSeriesReturn = document.documentElement.dataset.cinematicHandoffKind === "series-return";
          const isFreshHandoff =
            handoff?.id === chapterSlug &&
            Date.now() - Number(handoff?.at || 0) < 10000 &&
            referrerPath === "/series";

          if (!isMapArrival && !isSeriesReturn && !isFreshHandoff) return;
          if (window.matchMedia?.("(prefers-reduced-motion: reduce)")?.matches) return;

          const palette = transition?.palette || handoff?.palette || {};
          root.dataset.seriesChapterArrival = "entering";
          if (palette.accent) root.style.setProperty("--series-arrival-accent", palette.accent);
          if (palette.wash) root.style.setProperty("--series-arrival-wash", palette.wash);
          if (palette.ink) root.style.setProperty("--series-arrival-ink", palette.ink);

          const settle = () => {
            root.dataset.seriesChapterArrival = "settled";
          };
          window.addEventListener("artist-stage:cinematic-arrival-complete", settle, { once: true });
          window.setTimeout(settle, 3600);
        } catch {
          // Direct loads keep the authored chapter composition.
        }
      })();
    </script>
    <AtmosphericBackdropRoot />

    <section class="series-chapter-hero" data-series-hero data-atmosphere-section="series-chapter-hero">
      <div class="series-chapter-hero__copy">
        <p class="series-chapter-kicker" data-cinematic-idle="detail">SERIES / CINEMATIC CHAPTER</p>
        <h1 class="series-chapter-title" data-cinematic-idle="anchor">{seriesDisplayTitle}</h1>
        {series.subtitle ? <p class="series-chapter-subtitle" data-cinematic-idle="voice">{series.subtitle}</p> : null}
        <p class="series-chapter-copy" data-cinematic-idle="voice">{series.statement}</p>

        <div class="series-chapter-live-signal" aria-label="Active series signal" data-cinematic-idle="line">
          <div>
            <span>Active work</span>
            <strong data-series-hero-active-title>
              {heroWorks[0]?.meta.inventoryNumber ?? heroWorks[0]?.title ?? "Pending"}
            </strong>
          </div>
          <div>
            <span>Chapter field</span>
            <strong>{String(seriesWorks.length).padStart(2, "0")} works</strong>
          </div>
        </div>

        <nav class="series-chapter-routes" aria-label="Series routes" data-cinematic-idle="action">
          <a href="/series" data-series-return-map data-series-return-id={series.slug}>Return to chapter map</a>
          <a href={`/works?series=${series.slug}`}>Open works index</a>
          <a href="/process">Open process</a>
          {heroWorks[0] ? (
            <a
              href={`/works/${heroWorks[0].slug}`}
              data-series-hero-active-link
              data-atmosphere-handoff-slug={getWorkAtmosphereSlug(heroWorks[0])}
              data-series-work-route
              data-series-work-slug={heroWorks[0].slug}
              data-series-work-index="0"
            >
              Open active object
            </a>
          ) : null}
        </nav>
      </div>

      {heroWorks.length > 0 ? (
        <div class="series-hero-carousel" data-series-hero-carousel aria-label={`${series.title} selected works`} data-cinematic-idle="field">
          <div class="series-hero-carousel__field" aria-live="polite">
            {heroWorks.map((work, index) => {
              const image = getWorkImage(work, index === 0 ? 1500 : 1100);
              const title = work.meta.inventoryNumber ?? work.title;
              const statement = work.meta.shortStatement ?? work.statement ?? series.shortLine;

              return (
                <button
                  class="series-hero-frame"
                  type="button"
                  data-series-hero-frame
                  data-frame-index={index}
                  data-slot={getHeroSlot(index, heroWorks.length)}
                  data-title={title}
                  data-description={statement}
                  data-href={`/works/${work.slug}`}
                  data-atmosphere-handoff-slug={getWorkAtmosphereSlug(work)}
                  data-cinematic-route-slug={work.slug}
                  data-cinematic-manual="true"
                  style={getWorkAtmosphereVars(work)}
                >
                  <figure>
                    <img
                      src={image.src}
                      srcset={image.srcset}
                      sizes="(min-width: 1300px) 34vw, (min-width: 760px) 56vw, 86vw"
                      alt={getWorkImageAlt(work)}
                      loading={index < 3 ? "eager" : "lazy"}
                      fetchpriority={index === 0 ? "high" : "auto"}
                      decoding="async"
                      data-cinematic-cover
                      data-cinematic-route-slug={work.slug}
                      data-cinematic-arrival-slug={index === 0 ? series.slug : undefined}
                      data-series-chapter-arrival-target={index === 0 ? "true" : undefined}
                      data-cinematic-idle={index === 0 ? "image" : "trace"}
                    />
                    <figcaption>
                      <span>{String(index + 1).padStart(2, "0")}</span>
                      <strong>{title}</strong>
                      <small>{work.meta.year ?? series.years}</small>
                    </figcaption>
                  </figure>
                </button>
              );
            })}
          </div>

          <div class="series-hero-carousel__controls" aria-label="Series hero controls">
            <button type="button" data-series-hero-prev disabled={heroWorks.length <= 1}>Prev</button>
            <div class="series-hero-carousel__dots" aria-label="Select work">
              {heroWorks.map((work, index) => (
                <button
                  type="button"
                  data-series-hero-dot
                  data-dot-index={index}
                  aria-label={`Show ${work.meta.inventoryNumber ?? work.title}`}
                  aria-current={index === 0 ? "true" : "false"}
                />
              ))}
            </div>
            <button type="button" data-series-hero-next disabled={heroWorks.length <= 1}>Next</button>
          </div>
        </div>
      ) : (
        <aside class="series-hero-empty">
          <p class="series-chapter-kicker">FIELD STATE</p>
          <h2>Works for this field are still being organized.</h2>
          <p>This chapter is prepared as a future route. Confirmed works will appear here after author review.</p>
        </aside>
      )}
    </section>

    {sequenceWorks.length > 0 ? (
      <section class="series-chapter-sequence" data-series-living-sequence data-atmosphere-section="series-chapter-sequence">
        <div class="series-section-heading">
          <p class="series-chapter-kicker">SERIES / LIVING IMAGE FIELD</p>
          <h2>Works held as a moving chapter surface.</h2>
        </div>

        <div class="series-sequence-field">
          {sequenceWorks.map((work, index) => {
            const image = getWorkImage(work, index === 0 ? 1200 : 860);
            const layout = sequenceLayouts[index % sequenceLayouts.length];

            return (
              <button
                class={`series-sequence-plane series-sequence-plane--${layout}`}
                type="button"
                style={getWorkAtmosphereVars(work)}
                data-series-inspect-trigger
                data-series-canvas-card
                data-series-inspect-index={index}
                data-series-inspect-src={image.src}
                data-series-inspect-title={work.meta.inventoryNumber ?? work.title}
                data-series-inspect-label={`${String(index + 1).padStart(2, "0")} / ${series.title}`}
                data-series-inspect-total={sequenceWorks.length}
                data-series-inspect-href={`/works/${work.slug}`}
                data-artwork-slug={work.meta.atmosphereProfile || work.slug}
                data-atmosphere-handoff-slug={work.meta.atmosphereProfile || work.slug}
                data-series-work-route
                data-series-work-slug={work.slug}
                data-series-work-index={index}
              >
                <img
                  src={image.src}
                  srcset={image.srcset}
                  sizes="(min-width: 1200px) 38vw, (min-width: 760px) 56vw, 88vw"
                  alt={getWorkImageAlt(work)}
                  loading={index < 2 ? "eager" : "lazy"}
                  fetchpriority={index < 2 ? "high" : "auto"}
                  decoding="async"
                  data-cinematic-cover
                  data-cinematic-route-slug={work.slug}
                  data-cinematic-idle="trace"
                />
                <span>{String(index + 1).padStart(2, "0")}</span>
                <strong>{work.meta.inventoryNumber ?? work.title}</strong>
                <small>{work.meta.year ?? ""}</small>
              </button>
            );
          })}
        </div>
      </section>
    ) : null}

    <section class="series-chapter-register" data-atmosphere-section="series-chapter-register">
      <div class="series-section-heading">
        <p class="series-chapter-kicker">SERIES REGISTER</p>
        <h2>Complete field register.</h2>
      </div>

      {hasWorks ? (
        <div class="series-register-list">
          {seriesWorks.map((work, index) => (
            <a
              class="series-register-row"
              href={`/works/${work.slug}`}
              data-artwork-slug={work.meta.atmosphereProfile || work.slug}
              data-atmosphere-handoff-slug={work.meta.atmosphereProfile || work.slug}
              data-series-work-route
              data-series-work-slug={work.slug}
              data-series-work-index={index}
              data-cinematic-idle="line"
            >
              <span>{String(work.meta.seriesOrder ?? index + 1).padStart(2, "0")}</span>
              <strong>{work.meta.inventoryNumber ?? work.title}</strong>
              <p>{work.statement ?? work.meta.shortStatement ?? "Manifestation in field."}</p>
              <small>{work.meta.year ?? "year pending"}</small>
            </a>
          ))}
        </div>
      ) : (
        <div class="series-empty-state">
          <p>Confirmed works for this chapter are pending author review.</p>
          <a href="/works">Return to works index</a>
        </div>
      )}
    </section>

    <nav class="series-chapter-neighbor-nav" aria-label="Adjacent series" data-cinematic-idle="action">
      {previousSeries ? (
        <a href={`/series/${previousSeries.slug}`} data-cinematic-route-slug={previousSeries.slug}>
          Previous / {previousSeries.title}
        </a>
      ) : null}
      <a href="/series" data-series-return-map data-series-return-id={series.slug}>Return to chapter map</a>
      {nextSeries ? (
        <a href={`/series/${nextSeries.slug}`} data-cinematic-route-slug={nextSeries.slug}>
          Next / {nextSeries.title}
        </a>
      ) : null}
    </nav>

    <div class="series-inspector" data-series-inspector data-open="false" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Series image viewer">
      <button class="series-inspector__veil" type="button" data-series-inspector-close aria-label="Close image viewer"></button>
      <img class="series-inspector__morph" src="" alt="" data-series-inspector-morph />

      <article class="series-inspector__panel" data-series-inspector-panel>
        <div class="series-inspector__media" data-series-inspector-media>
          <img class="series-inspector__image" src="" alt="" data-series-inspector-image />
          <img class="series-inspector__shift" src="" alt="" data-series-inspector-shift />
        </div>

        <div class="series-inspector__toolbar">
          <div class="series-inspector__readout" aria-live="polite">
            <span data-series-inspector-count></span>
            <strong data-series-inspector-title></strong>
            <span data-series-inspector-label></span>
          </div>

          <div class="series-inspector__controls" aria-label="Image inspector controls">
            <a
              class="series-inspector__work-link"
              href="/works"
              data-series-inspector-work-link
              data-cinematic-source-selector="[data-series-inspector-image]"
              data-series-work-route
            >
              View work
            </a>
            <button type="button" data-series-inspector-prev>Prev</button>
            <button type="button" data-series-inspector-next>Next</button>
            <button type="button" data-series-inspector-close>Close</button>
          </div>
        </div>

        <div class="series-inspector__progress" aria-hidden="true">
          <span data-series-inspector-progress></span>
        </div>
      </article>
    </div>
  </div>
</BaseLayout>

<script is:inline define:vars={{ chapterSlug: series.slug }}>
  (() => {
    const RETURN_KEY = "artist-stage:series-constellation-return";
    const HANDOFF_KEY = "artist-stage:series-constellation-handoff";
    const RESUME_KEY = "artist-stage:series-chapter-resume";
    const routeParams = new URLSearchParams(window.location.search);
    const navigationEntry = performance.getEntriesByType?.("navigation")?.[0];
    const isBackForwardNavigation = navigationEntry?.type === "back_forward";
    const readResumeState = () => {
      try {
        return JSON.parse(sessionStorage.getItem(RESUME_KEY) || "null");
      } catch {
        return null;
      }
    };
    let resumeState = readResumeState();

    let referrerPath = "";
    try {
      referrerPath = document.referrer ? new URL(document.referrer).pathname : "";
    } catch {
      referrerPath = "";
    }

    let canUseResume =
      resumeState?.seriesSlug === chapterSlug &&
      Date.now() - Number(resumeState?.at || 0) < 30 * 60 * 1000 &&
      (referrerPath.startsWith("/works/") || isBackForwardNavigation || routeParams.has("work"));
    let requestedWorkSlug = routeParams.get("work") || (canUseResume ? resumeState?.workSlug : "") || "";

    document.querySelectorAll("[data-series-return-map]").forEach((link) => {
      link.addEventListener("click", () => {
        try {
          const handoff = JSON.parse(sessionStorage.getItem(HANDOFF_KEY) || "null");
          sessionStorage.setItem(
            RETURN_KEY,
            JSON.stringify({
              id: link.dataset.seriesReturnId,
              slug: link.dataset.seriesReturnId,
              map: handoff?.id === link.dataset.seriesReturnId ? handoff?.map : null,
              at: Date.now(),
            }),
          );
        } catch {
          // Decorative continuity only.
        }
      });
    });

    const sequence = document.querySelector("[data-series-living-sequence]");
    const planes = [...document.querySelectorAll("[data-series-inspect-trigger]")];
    const hero = document.querySelector("[data-series-hero-carousel]");
    const heroFrames = [...document.querySelectorAll("[data-series-hero-frame]")];
    const heroDots = [...document.querySelectorAll("[data-series-hero-dot]")];
    const heroActiveTitle = document.querySelector("[data-series-hero-active-title]");
    const heroActiveLink = document.querySelector("[data-series-hero-active-link]");
    const prefersReducedMotion = window.matchMedia?.("(prefers-reduced-motion: reduce)")?.matches;
    let syncHeroToInspectorFrame = () => {};

    if (hero && heroFrames.length) {
      const requestedHeroIndex = heroFrames.findIndex((frame) => frame.dataset.cinematicRouteSlug === requestedWorkSlug);
      let activeHeroIndex = requestedHeroIndex >= 0 ? requestedHeroIndex : 0;
      let autoplayTimer = 0;
      let pointerStartX = 0;
      let isHeroPaused = false;
      const heroRect = hero.getBoundingClientRect();
      let isHeroDominant =
        heroRect.bottom > window.innerHeight * 0.16 &&
        heroRect.top < window.innerHeight * 0.78;

      const getCircularOffset = (index) => {
        const total = heroFrames.length;
        let offset = index - activeHeroIndex;
        if (offset > total / 2) offset -= total;
        if (offset < -total / 2) offset += total;
        return offset;
      };

      const getSlot = (index) => {
        if (heroFrames.length <= 1) return "active";
        const offset = getCircularOffset(index);
        if (offset === 0) return "active";
        if (offset === 1) return "next";
        if (offset === -1) return "prev";
        if (offset === 2) return "far-next";
        if (offset === -2) return "far-prev";
        return "hidden";
      };

      const syncHero = () => {
        const activeFrame = heroFrames[activeHeroIndex];

        heroFrames.forEach((frame, index) => {
          const isActive = index === activeHeroIndex;
          const image = frame.querySelector("img");
          frame.dataset.slot = getSlot(index);
          frame.setAttribute("aria-current", isActive ? "true" : "false");
          frame.tabIndex = isActive || Math.abs(getCircularOffset(index)) <= 1 ? 0 : -1;
          if (image) image.dataset.cinematicIdle = isActive ? "image" : "trace";
        });

        heroDots.forEach((dot, index) => {
          dot.setAttribute("aria-current", index === activeHeroIndex ? "true" : "false");
        });

        if (activeFrame) {
          const title = activeFrame.dataset.title || "";
          if (heroActiveTitle) heroActiveTitle.textContent = title;
          if (heroActiveLink) {
            heroActiveLink.setAttribute("href", activeFrame.dataset.href || "/works");
            heroActiveLink.setAttribute("data-atmosphere-handoff-slug", activeFrame.dataset.atmosphereHandoffSlug || "");
            heroActiveLink.dataset.cinematicRouteSlug = activeFrame.dataset.cinematicRouteSlug || "";
            heroActiveLink.dataset.seriesWorkSlug = activeFrame.dataset.cinematicRouteSlug || "";
            heroActiveLink.dataset.seriesWorkIndex = String(activeHeroIndex);
            heroActiveLink.dataset.cinematicSourceSelector = `[data-series-hero-frame][data-frame-index="${activeHeroIndex}"] [data-cinematic-cover]`;
          }

          const atmosphereSlug = activeFrame.dataset.atmosphereHandoffSlug;
          if (atmosphereSlug && isHeroDominant && !document.hidden) {
            window.ArtistStageAtmosphereOrchestrator?.setTarget?.(atmosphereSlug, {
              source: "series-hero",
              immediate: false,
            });
          }
        }
      };

      const setHero = (index) => {
        activeHeroIndex = (index + heroFrames.length) % heroFrames.length;
        syncHero();
      };

      syncHeroToInspectorFrame = (index) => {
        setHero(index);
      };

      const stepHero = (direction) => setHero(activeHeroIndex + direction);

      const restartAutoplay = () => {
        window.clearInterval(autoplayTimer);
        if (prefersReducedMotion || heroFrames.length <= 1) return;
        autoplayTimer = window.setInterval(() => {
          if (!isHeroPaused && isHeroDominant && !document.hidden) stepHero(1);
        }, 6800);
      };

      if ("IntersectionObserver" in window) {
        const heroVisibilityObserver = new IntersectionObserver(
          ([entry]) => {
            const wasDominant = isHeroDominant;
            isHeroDominant = Boolean(entry?.isIntersecting && entry.intersectionRatio >= 0.34);

            if (!wasDominant && isHeroDominant) {
              syncHero();
            }
          },
          {
            threshold: [0, 0.2, 0.34, 0.55, 0.75, 1],
            rootMargin: "-6% 0px -18% 0px",
          },
        );

        heroVisibilityObserver.observe(hero);
      }

      heroFrames.forEach((frame, index) => {
        const image = frame.querySelector("img");
        const syncFormat = () => {
          if (!image?.naturalWidth || !image?.naturalHeight) return;
          const ratio = image.naturalWidth / image.naturalHeight;
          frame.dataset.imageFormat = ratio > 1.14 ? "landscape" : ratio < 0.86 ? "portrait" : "square";
        };

        if (image?.complete) syncFormat();
        image?.addEventListener("load", syncFormat, { once: true });

        frame.addEventListener("click", (event) => {
          event.preventDefault();
          if (index === activeHeroIndex) {
            openInspector(index, frame);
          } else {
            setHero(index);
          }
          restartAutoplay();
        });
      });

      heroDots.forEach((dot) => {
        dot.addEventListener("click", () => {
          setHero(Number(dot.dataset.dotIndex || 0));
          restartAutoplay();
        });
      });

      hero.querySelector("[data-series-hero-prev]")?.addEventListener("click", () => {
        stepHero(-1);
        restartAutoplay();
      });

      hero.querySelector("[data-series-hero-next]")?.addEventListener("click", () => {
        stepHero(1);
        restartAutoplay();
      });

      hero.addEventListener("wheel", (event) => {
        if (heroFrames.length <= 1 || Math.abs(event.deltaY) < 12) return;
        event.preventDefault();
        stepHero(event.deltaY > 0 ? 1 : -1);
        restartAutoplay();
      }, { passive: false });

      hero.addEventListener("pointerdown", (event) => {
        pointerStartX = event.clientX;
      });

      hero.addEventListener("pointerup", (event) => {
        const delta = event.clientX - pointerStartX;
        if (Math.abs(delta) > 64) {
          stepHero(delta < 0 ? 1 : -1);
          restartAutoplay();
        }
      });

      hero.addEventListener("pointerenter", () => {
        isHeroPaused = true;
      });

      hero.addEventListener("pointerleave", () => {
        isHeroPaused = false;
      });

      hero.addEventListener("focusin", () => {
        isHeroPaused = true;
      });

      hero.addEventListener("focusout", () => {
        isHeroPaused = false;
      });

      document.addEventListener("visibilitychange", () => {
        if (!document.hidden && isHeroDominant) {
          syncHero();
        }
      });

      syncHero();
      restartAutoplay();
    }

    if ("IntersectionObserver" in window && planes.length) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            const rect = entry.boundingClientRect;
            const center = rect.top + rect.height * 0.5;
            const progress = Math.max(0, Math.min(1, 1 - Math.abs(center - window.innerHeight * 0.52) / window.innerHeight));
            entry.target.style.setProperty("--sequence-visible", entry.isIntersecting ? "1" : "0");
            entry.target.style.setProperty("--sequence-progress", progress.toFixed(3));
            entry.target.style.setProperty("--sequence-depth", String(Math.round(progress * 42)));
            entry.target.style.setProperty("--sequence-lift-x", `${((progress - 0.5) * 18).toFixed(2)}px`);
            entry.target.style.setProperty("--sequence-lift-y", `${((0.5 - progress) * 26).toFixed(2)}px`);
            entry.target.style.setProperty("--sequence-breathe", (0.985 + progress * 0.025).toFixed(3));
          });
        },
        { threshold: [0, 0.16, 0.32, 0.48, 0.64, 0.8, 1] },
      );

      planes.forEach((plane) => observer.observe(plane));
    }

    const inspector = document.querySelector("[data-series-inspector]");
    const inspectorPanel = inspector?.querySelector("[data-series-inspector-panel]");
    const inspectorMedia = inspector?.querySelector("[data-series-inspector-media]");
    const inspectorImage = inspector?.querySelector("[data-series-inspector-image]");
    const inspectorMorph = inspector?.querySelector("[data-series-inspector-morph]");
    const inspectorShift = inspector?.querySelector("[data-series-inspector-shift]");
    const inspectorTitle = inspector?.querySelector("[data-series-inspector-title]");
    const inspectorLabel = inspector?.querySelector("[data-series-inspector-label]");
    const inspectorCount = inspector?.querySelector("[data-series-inspector-count]");
    const inspectorProgress = inspector?.querySelector("[data-series-inspector-progress]");
    const inspectorWorkLink = inspector?.querySelector("[data-series-inspector-work-link]");
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let activeIndex = 0;
    let sourceTrigger = null;
    let inspectorOrigin = "sequence";
    let lastFocusedElement = null;
    let lockedScrollY = 0;
    let isInspectorOpen = false;
    let isInspectorBusy = false;
    let inspectorCloseTimer = 0;
    let wheelDelta = 0;
    let wheelCooldown = 0;
    let previousBodyTouchAction = "";

    if (inspector && inspector.parentElement !== document.body) {
      document.body.appendChild(inspector);
    }

    const frames = planes
      .map((trigger, fallbackIndex) => ({
        trigger,
        sourceImage: trigger.querySelector("img") || trigger,
        index: Number(trigger.dataset.seriesInspectIndex ?? fallbackIndex),
        src: trigger.dataset.seriesInspectSrc,
        title: trigger.dataset.seriesInspectTitle || "",
        label: trigger.dataset.seriesInspectLabel || "",
        href: trigger.dataset.seriesInspectHref || (trigger.dataset.artworkSlug ? `/works/${trigger.dataset.artworkSlug}` : "/works"),
        slug: trigger.dataset.artworkSlug || "",
        atmosphereSlug: trigger.dataset.atmosphereHandoffSlug || trigger.dataset.artworkSlug || "",
        alt: trigger.querySelector("img")?.alt || trigger.dataset.seriesInspectTitle || "",
        loaded: null,
      }))
      .filter((frame) => frame.src)
      .sort((a, b) => a.index - b.index);

    const writeChapterResume = ({ workSlug, workIndex, origin = "chapter", restoreInspector = false }) => {
      if (!workSlug) return;

      try {
        sessionStorage.setItem(
          RESUME_KEY,
          JSON.stringify({
            seriesSlug: chapterSlug,
            workSlug,
            workIndex,
            origin,
            restoreInspector,
            scrollY: window.scrollY,
            at: Date.now(),
          }),
        );
      } catch {
        // Route continuity is progressive enhancement only.
      }
    };

    const resolveWorkIndex = (workSlug, link) => {
      const linkIndex = Number(link?.dataset?.seriesWorkIndex);
      if (Number.isFinite(linkIndex)) return linkIndex;
      return frames.findIndex((frame) => frame.slug === workSlug);
    };

    const handleCinematicWorkNavigation = (event) => {
      const detail = event.detail;
      if (detail?.fromPath !== window.location.pathname || detail?.routeType !== "works") return;

      const workSlug = detail.slug || detail.link?.dataset?.seriesWorkSlug || "";
      const workIndex = resolveWorkIndex(workSlug, detail.link);
      const fromInspector = detail.link === inspectorWorkLink;
      writeChapterResume({
        workSlug,
        workIndex,
        origin: fromInspector ? inspectorOrigin : "hero",
        restoreInspector: fromInspector,
      });
    };

    window.addEventListener("artist-stage:cinematic-navigation-start", handleCinematicWorkNavigation);

    document.querySelectorAll("[data-series-work-route]").forEach((link) => {
      link.addEventListener("click", () => {
        const workSlug = link.dataset.seriesWorkSlug || link.dataset.cinematicRouteSlug || link.dataset.artworkSlug || "";
        writeChapterResume({
          workSlug,
          workIndex: resolveWorkIndex(workSlug, link),
          origin: link.matches("[data-series-hero-active-link]") ? "hero" : "chapter",
          restoreInspector: false,
        });
      });
    });

    const lockScroll = () => {
      lockedScrollY = window.scrollY;
      previousBodyTouchAction = document.body.style.touchAction;
      document.body.style.touchAction = "none";
    };

    const unlockScroll = () => {
      document.body.style.touchAction = previousBodyTouchAction;
      window.scrollTo(0, lockedScrollY);
      window.requestAnimationFrame(() => window.scrollTo(0, lockedScrollY));
    };

    const waitForFrame = () =>
      new Promise((resolve) => {
        window.requestAnimationFrame(() => {
          window.requestAnimationFrame(resolve);
        });
      });

    const imageReady = (image) => {
      if (!image) return Promise.resolve();
      if (image.complete && image.naturalWidth > 0) {
        return image.decode?.().catch(() => {}) ?? Promise.resolve();
      }
      return new Promise((resolve) => {
        image.onload = () => {
          image.decode?.().catch(() => {}).finally(resolve);
        };
        image.onerror = resolve;
      });
    };

    const preloadFrame = (frame) => {
      if (!frame) return Promise.resolve(null);
      if (frame.loaded) return frame.loaded;
      frame.loaded = new Promise((resolve) => {
        const image = new Image();
        image.decoding = "async";
        image.onload = () => resolve({
          width: image.naturalWidth || 1200,
          height: image.naturalHeight || 1600,
        });
        image.onerror = () => resolve({ width: 1200, height: 1600 });
        image.src = frame.src;
      });
      return frame.loaded;
    };

    const preloadNeighbors = (index) => {
      if (!frames.length) return;
      preloadFrame(frames[(index + 1) % frames.length]);
      preloadFrame(frames[(index - 1 + frames.length) % frames.length]);
    };

    const getTargetRect = (dimensions = { width: 1200, height: 1600 }) => {
      const maxWidth = Math.min(window.innerWidth * 0.78, 1180);
      const maxHeight = Math.min(window.innerHeight * 0.72, window.innerHeight - 165, 940);
      const ratio = Math.max(0.35, Math.min(2.4, dimensions.width / dimensions.height));
      let width = maxWidth;
      let height = width / ratio;

      if (height > maxHeight) {
        height = maxHeight;
        width = height * ratio;
      }

      return {
        left: (window.innerWidth - width) / 2,
        top: Math.max(52, (window.innerHeight - height) / 2 - window.innerHeight * 0.035),
        width,
        height,
      };
    };

    const setLayerRect = (element, rect) => {
      if (!element) return;
      element.style.left = `${rect.left}px`;
      element.style.top = `${rect.top}px`;
      element.style.width = `${rect.width}px`;
      element.style.height = `${rect.height}px`;
    };

    const setMediaRect = (rect) => {
      if (!inspectorMedia || !rect) return;
      inspectorMedia.style.setProperty("--series-inspector-media-left", `${rect.left}px`);
      inspectorMedia.style.setProperty("--series-inspector-media-top", `${rect.top}px`);
      inspectorMedia.style.setProperty("--series-inspector-media-width", `${rect.width}px`);
      inspectorMedia.style.setProperty("--series-inspector-media-height", `${rect.height}px`);
    };

    const hideMorphLayer = () => {
      if (!inspectorMorph) return;
      inspectorMorph.getAnimations?.().forEach((animation) => animation.cancel());
      inspectorMorph.src = "";
      inspectorMorph.style.opacity = "0";
      inspectorMorph.style.transform = "";
      inspectorMorph.style.clipPath = "";
    };

    const hideShiftLayer = () => {
      if (!inspectorShift) return;
      inspectorShift.getAnimations?.().forEach((animation) => animation.cancel());
      inspectorShift.src = "";
      inspectorShift.style.opacity = "";
      inspectorShift.style.transform = "";
      inspectorShift.style.clipPath = "";
    };

    const getWorkColor = (frame, name, fallback) =>
      frame?.trigger?.style?.getPropertyValue(name)?.trim() || fallback;

    const updateInspectorTheme = (frame) => {
      if (!inspector || !frame) return;
      inspector.style.setProperty("--photo-inspector-accent", getWorkColor(frame, "--work-accent", "rgba(205, 221, 156, 0.86)"));
      inspector.style.setProperty("--photo-inspector-atmo-a", getWorkColor(frame, "--work-wash", "rgba(81, 105, 58, 0.38)"));
      inspector.style.setProperty("--photo-inspector-atmo-c", getWorkColor(frame, "--work-glow", "rgba(160, 181, 105, 0.24)"));
      inspector.style.setProperty("--photo-inspector-shadow", getWorkColor(frame, "--work-shadow", "rgba(21, 30, 18, 0.72)"));
    };

    const updateReadout = (frame) => {
      if (!frame) return;
      if (inspectorCount) inspectorCount.textContent = `${String(activeIndex + 1).padStart(2, "0")} / ${String(frames.length).padStart(2, "0")}`;
      if (inspectorTitle) inspectorTitle.textContent = frame.title;
      if (inspectorLabel) inspectorLabel.textContent = frame.label;
      if (inspectorProgress) inspectorProgress.style.width = `${((activeIndex + 1) / Math.max(frames.length, 1)) * 100}%`;
      if (inspectorWorkLink) {
        inspectorWorkLink.href = frame.href || "/works";
        inspectorWorkLink.dataset.cinematicRouteSlug = frame.slug || "";
        inspectorWorkLink.dataset.artworkSlug = frame.slug || "";
        inspectorWorkLink.dataset.seriesWorkSlug = frame.slug || "";
        inspectorWorkLink.dataset.seriesWorkIndex = String(activeIndex);
        inspectorWorkLink.dataset.atmosphereHandoffSlug = frame.atmosphereSlug || frame.slug || "";
        inspectorWorkLink.setAttribute("aria-label", `View work ${frame.title}`);
      }
      updateInspectorTheme(frame);
    };

    const setDisplayFrame = (frame) => {
      if (!frame || !inspectorImage) return;
      inspectorImage.src = frame.src;
      inspectorImage.alt = frame.alt;
      updateReadout(frame);
    };

    const finishCloseInspector = () => {
      if (!inspector) return;
      inspector.setAttribute("aria-hidden", "true");
      inspector.dataset.open = "false";
      delete inspector.dataset.entered;
      delete inspector.dataset.morphing;
      delete inspector.dataset.handoff;
      delete inspector.dataset.phase;
      delete document.documentElement.dataset.seriesInspectorOpen;
      inspectorMorph?.getAnimations?.().forEach((animation) => animation.cancel());
      inspectorShift?.getAnimations?.().forEach((animation) => animation.cancel());
      if (inspectorMorph) {
        inspectorMorph.src = "";
        inspectorMorph.style.opacity = "";
        inspectorMorph.style.transform = "";
      }
      if (inspectorShift) {
        inspectorShift.src = "";
        inspectorShift.style.opacity = "";
        inspectorShift.style.transform = "";
      }
      inspectorMedia?.style.removeProperty("--series-inspector-media-width");
      inspectorMedia?.style.removeProperty("--series-inspector-media-height");
      inspectorMedia?.style.removeProperty("--series-inspector-media-left");
      inspectorMedia?.style.removeProperty("--series-inspector-media-top");
      isInspectorBusy = false;
      window.clearTimeout(inspectorCloseTimer);
      inspectorCloseTimer = window.setTimeout(() => {
        if (isInspectorOpen) {
          unlockScroll();
          isInspectorOpen = false;
        }
        lastFocusedElement?.focus?.({ preventScroll: true });
      }, 300);
    };

    const openInspector = async (index, sourceOverride = null) => {
      const frame = frames[index];
      if (!frame || !inspector || !inspectorImage || !inspectorMorph) return;
      if (isInspectorBusy) return;

      isInspectorBusy = true;
      lastFocusedElement = document.activeElement;
      activeIndex = index;
      sourceTrigger = sourceOverride || frame.trigger;
      inspectorOrigin = sourceOverride ? "hero" : "sequence";
      window.clearTimeout(inspectorCloseTimer);
      updateInspectorTheme(frame);

      if (!isInspectorOpen) {
        lockScroll();
        isInspectorOpen = true;
      }

      const dimensions = await preloadFrame(frame);
      const sourceImage = sourceOverride?.querySelector?.("img") || frame.sourceImage;
      const sourceRect = sourceImage.getBoundingClientRect();
      const targetRect = getTargetRect(dimensions);
      setMediaRect(targetRect);

      setDisplayFrame(frame);
      inspectorMorph.src = frame.src;
      inspectorMorph.alt = frame.alt;
      await Promise.all([imageReady(inspectorImage), imageReady(inspectorMorph)]);
      inspectorMorph.getAnimations?.().forEach((morphAnimation) => morphAnimation.cancel());
      setLayerRect(inspectorMorph, sourceRect);
      inspectorMorph.style.opacity = "1";
      inspectorMorph.style.transform = "";
      inspectorMorph.style.clipPath = "";
      inspectorMorph.style.transformOrigin = "top left";

      inspector.setAttribute("aria-hidden", "false");
      inspector.dataset.open = "true";
      inspector.dataset.phase = "primed";
      inspector.dataset.morphing = "true";
      delete inspector.dataset.handoff;
      delete inspector.dataset.entered;
      document.documentElement.dataset.seriesInspectorOpen = "true";
      await waitForFrame();

      const openingTransform = `translate3d(${sourceRect.left - targetRect.left}px, ${sourceRect.top - targetRect.top}px, 0) scale(${sourceRect.width / targetRect.width}, ${sourceRect.height / targetRect.height})`;
      setLayerRect(inspectorMorph, targetRect);
      inspectorMorph.style.transform = openingTransform;
      inspector.dataset.phase = "opening";
      await waitForFrame();

      const animation = reduceMotion || !inspectorMorph.animate
        ? null
        : inspectorMorph.animate(
            [
              { transform: openingTransform, opacity: 0.88, clipPath: "inset(0% 0% 0% 0%)" },
              { transform: "translate3d(0, 0, 0) scale(1)", opacity: 1, clipPath: "inset(0% 0% 0% 0%)" },
            ],
            {
              duration: 620,
              easing: "cubic-bezier(0.16, 1, 0.3, 1)",
              fill: "forwards",
            },
          );

      if (animation) await animation.finished.catch(() => {});
      inspectorMorph.style.transform = "translate3d(0, 0, 0) scale(1)";
      inspectorMorph.style.opacity = "1";
      inspectorMorph.style.clipPath = "inset(0% 0% 0% 0%)";
      if (animation) animation.cancel();

      inspector.dataset.entered = "true";
      inspector.dataset.phase = "entered";
      inspector.dataset.handoff = "true";
      delete inspector.dataset.morphing;
      await waitForFrame();
      const handoff = inspectorMorph.animate?.(
        [
          { opacity: 1 },
          { opacity: 0 },
        ],
        {
          duration: reduceMotion ? 1 : 120,
          easing: "ease",
          fill: "forwards",
        },
      );
      if (handoff) await handoff.finished.catch(() => {});
      hideMorphLayer();
      delete inspector.dataset.handoff;
      isInspectorBusy = false;
      preloadNeighbors(activeIndex);
    };

    const closeInspector = async () => {
      if (!inspector || !inspectorImage || !inspectorMorph || inspector.getAttribute("aria-hidden") === "true") return;
      if (isInspectorBusy) return;

      isInspectorBusy = true;
      window.clearTimeout(inspectorCloseTimer);
      const frame = frames[activeIndex];
      const dimensions = await preloadFrame(frame);
      const fromRect = getTargetRect(dimensions);
      syncHeroToInspectorFrame(activeIndex);
      if (inspectorOrigin === "hero") {
        sourceTrigger = heroFrames[activeIndex] || frame.trigger;
        lastFocusedElement = sourceTrigger;
      }
      await waitForFrame();
      const sourceImage = sourceTrigger?.querySelector("img") || sourceTrigger;
      const sourceRect = sourceImage?.getBoundingClientRect?.();
      const sourceVisible = sourceRect && sourceRect.bottom > 0 && sourceRect.top < window.innerHeight;

      inspectorMorph.src = inspectorImage.src;
      inspectorMorph.alt = inspectorImage.alt;
      await imageReady(inspectorMorph);
      inspectorMorph.getAnimations?.().forEach((morphAnimation) => morphAnimation.cancel());
      setLayerRect(inspectorMorph, fromRect);
      inspectorMorph.style.opacity = "1";
      inspectorMorph.style.transform = "";
      inspectorMorph.style.clipPath = "";
      inspectorMorph.style.transformOrigin = "top left";
      await waitForFrame();

      inspector.dataset.phase = "closing";
      inspector.dataset.morphing = "true";
      delete inspector.dataset.entered;
      await waitForFrame();

      if (!sourceVisible || reduceMotion || !inspectorMorph.animate) {
        const fallback = inspectorMorph.animate?.(
          [
            { transform: "translate3d(0, 0, 0) scale(1)", opacity: 1 },
            { transform: "translate3d(0, 10px, 0) scale(0.96)", opacity: 0 },
          ],
          { duration: 260, easing: "ease", fill: "forwards" },
        );
        if (fallback) await fallback.finished.catch(() => {});
        if (fallback) fallback.cancel();
        finishCloseInspector();
        return;
      }

      const to = `translate3d(${sourceRect.left - fromRect.left}px, ${sourceRect.top - fromRect.top}px, 0) scale(${sourceRect.width / fromRect.width}, ${sourceRect.height / fromRect.height})`;
      const animation = inspectorMorph.animate(
        [
          { transform: "translate3d(0, 0, 0) scale(1)", opacity: 1 },
          { transform: to, opacity: 0.72 },
        ],
        {
          duration: 420,
          easing: "cubic-bezier(0.16, 1, 0.3, 1)",
          fill: "forwards",
        },
      );

      await animation.finished.catch(() => {});
      animation.cancel();
      finishCloseInspector();
    };

    const forceCloseInspector = () => {
      window.clearTimeout(inspectorCloseTimer);
      finishCloseInspector();
    };

    const shiftTo = async (nextIndex) => {
      if (!frames.length || !inspectorImage || !inspectorShift || isInspectorBusy) return;
      const normalizedIndex = (nextIndex + frames.length) % frames.length;
      if (normalizedIndex === activeIndex) return;

      isInspectorBusy = true;
      const previousIndex = activeIndex;
      const direction = normalizedIndex > previousIndex || (previousIndex === frames.length - 1 && normalizedIndex === 0) ? 1 : -1;
      const nextFrame = frames[normalizedIndex];
      const nextDimensions = await preloadFrame(nextFrame);
      setMediaRect(getTargetRect(nextDimensions));

      activeIndex = normalizedIndex;
      sourceTrigger = nextFrame.trigger;
      updateReadout(nextFrame);

      inspectorImage.getAnimations?.().forEach((animation) => animation.cancel());
      hideShiftLayer();
      inspectorShift.src = nextFrame.src;
      inspectorShift.alt = nextFrame.alt;
      inspectorShift.style.opacity = "1";
      inspectorShift.style.transform = `translate3d(${direction * 9}vw, 0, 0) scale(0.985)`;
      inspectorShift.style.clipPath = "";
      inspector.dataset.phase = direction > 0 ? "shift-next" : "shift-prev";

      if (reduceMotion || !inspectorImage.animate || !inspectorShift.animate) {
        setDisplayFrame(nextFrame);
        hideShiftLayer();
        isInspectorBusy = false;
        preloadNeighbors(activeIndex);
        return;
      }

      const outgoing = inspectorImage.animate(
        [
          { transform: "translate3d(0, 0, 0) scale(1)", opacity: 1, clipPath: "inset(0% 0% 0% 0%)" },
          { transform: `translate3d(${-direction * 8}vw, 0, 0) scale(0.975)`, opacity: 0, clipPath: "inset(3% 5% 3% 5%)" },
        ],
        { duration: 460, easing: "cubic-bezier(0.16, 1, 0.3, 1)", fill: "forwards" },
      );
      const incoming = inspectorShift.animate(
        [
          { transform: `translate3d(${direction * 9}vw, 0, 0) scale(0.985)`, opacity: 0, clipPath: "inset(4% 6% 4% 6%)" },
          { transform: "translate3d(0, 0, 0) scale(1)", opacity: 1, clipPath: "inset(0% 0% 0% 0%)" },
        ],
        { duration: 520, easing: "cubic-bezier(0.16, 1, 0.3, 1)", fill: "forwards" },
      );

      await Promise.all([outgoing.finished.catch(() => {}), incoming.finished.catch(() => {})]);
      inspectorImage.getAnimations?.().forEach((animation) => animation.cancel());
      inspectorImage.style.transform = "";
      inspectorImage.style.opacity = "";
      inspectorImage.style.clipPath = "";
      setDisplayFrame(nextFrame);
      hideShiftLayer();
      inspector.dataset.phase = "entered";
      isInspectorBusy = false;
      preloadNeighbors(activeIndex);
    };

    const stepInspector = (direction) => {
      shiftTo(activeIndex + direction);
    };

    planes.forEach((trigger, index) => {
      trigger.addEventListener("click", (event) => {
        event.preventDefault();
        event.stopPropagation();
        openInspector(index);
      });
    });

    inspector?.querySelectorAll("[data-series-inspector-close]").forEach((control) => {
      control.addEventListener("click", closeInspector);
    });
    inspector?.querySelector("[data-series-inspector-prev]")?.addEventListener("click", () => stepInspector(-1));
    inspector?.querySelector("[data-series-inspector-next]")?.addEventListener("click", () => stepInspector(1));
    inspector?.addEventListener("wheel", (event) => {
      event.preventDefault();
      wheelDelta += event.deltaY;
      window.clearTimeout(wheelCooldown);
      if (Math.abs(wheelDelta) > 72) {
        stepInspector(wheelDelta > 0 ? 1 : -1);
        wheelDelta = 0;
      }
      wheelCooldown = window.setTimeout(() => {
        wheelDelta = 0;
      }, 180);
    }, { passive: false });

    let swipeStartX = 0;
    inspector?.addEventListener("pointerdown", (event) => {
      swipeStartX = event.clientX;
    });
    inspector?.addEventListener("pointerup", (event) => {
      const delta = event.clientX - swipeStartX;
      if (Math.abs(delta) > 60) stepInspector(delta < 0 ? 1 : -1);
    });

    document.addEventListener("keydown", (event) => {
      if (!inspector || inspector.getAttribute("aria-hidden") === "true") return;
      if (event.key === "Escape") {
        event.preventDefault();
        closeInspector();
      }
      if (event.key === "ArrowLeft" || event.key === "ArrowUp") {
        event.preventDefault();
        stepInspector(-1);
      }
      if (event.key === "ArrowRight" || event.key === "ArrowDown") {
        event.preventDefault();
        stepInspector(1);
      }
    });

    let restoredView = false;
    const restoreRequestedView = ({ fromHistory = false } = {}) => {
      if (restoredView || !requestedWorkSlug || !frames.length) return;
      const requestedIndex = frames.findIndex((frame) => frame.slug === requestedWorkSlug);
      if (requestedIndex < 0) return;

      restoredView = true;
      syncHeroToInspectorFrame(requestedIndex);

      if (canUseResume && Number.isFinite(Number(resumeState?.scrollY))) {
        window.scrollTo(0, Number(resumeState.scrollY));
      }

      const shouldRestoreInspector =
        routeParams.get("view") === "inspector" ||
        ((fromHistory || isBackForwardNavigation) && canUseResume && resumeState?.restoreInspector === true);
      if (!shouldRestoreInspector) return;

      let launched = false;
      const launch = () => {
        if (launched) return;
        launched = true;
        const sourceOverride = resumeState?.origin === "hero" ? heroFrames[requestedIndex] : null;
        window.requestAnimationFrame(() => {
          window.requestAnimationFrame(() => openInspector(requestedIndex, sourceOverride));
        });

        if (routeParams.has("work") || routeParams.has("view")) {
          window.history.replaceState(window.history.state, "", `${window.location.pathname}${window.location.hash}`);
        }
      };

      if (document.documentElement.hasAttribute("data-cinematic-transition")) {
        window.addEventListener("artist-stage:cinematic-arrival-complete", launch, { once: true });
        window.setTimeout(launch, 2100);
      } else {
        launch();
      }
    };

    window.addEventListener("pagehide", forceCloseInspector);
    window.addEventListener("pageshow", (event) => {
      const navigation = performance.getEntriesByType?.("navigation")?.[0];
      if (!event.persisted && navigation?.type !== "back_forward") return;
      forceCloseInspector();
      resumeState = readResumeState();
      canUseResume =
        resumeState?.seriesSlug === chapterSlug &&
        Date.now() - Number(resumeState?.at || 0) < 30 * 60 * 1000;
      requestedWorkSlug = canUseResume ? resumeState?.workSlug || "" : "";
      restoredView = false;
      window.setTimeout(() => restoreRequestedView({ fromHistory: true }), 380);
    });

    restoreRequestedView({ fromHistory: isBackForwardNavigation });

    if (sequence && !planes.length) {
      sequence.hidden = true;
    }

    const canvasCards = [...document.querySelectorAll("[data-series-canvas-card]")];
    let canvasRaf = 0;

    const renderCanvasCards = () => {
      canvasRaf = 0;
      const viewportCenter = window.innerHeight * 0.52;

      canvasCards.forEach((card, index) => {
        const rect = card.getBoundingClientRect();
        const center = rect.top + rect.height * 0.5;
        const distance = Math.abs(center - viewportCenter);
        const emphasis = Math.max(0, Math.min(1, 1 - distance / (window.innerHeight * 0.72)));
        const y = (1 - emphasis) * 34;
        const scale = 0.94 + emphasis * 0.075;
        const opacity = 0.5 + emphasis * 0.5;

        card.style.setProperty("--cover-y", `${y.toFixed(2)}px`);
        card.style.setProperty("--cover-scale", scale.toFixed(4));
        card.style.setProperty("--cover-opacity", opacity.toFixed(3));
        card.style.setProperty("--cover-tilt", "0deg");
        card.style.setProperty("--sequence-progress", emphasis.toFixed(3));
        card.style.setProperty("--sequence-visible", rect.bottom > 0 && rect.top < window.innerHeight ? "1" : "0");
      });
    };

    const requestCanvasRender = () => {
      if (!canvasRaf) canvasRaf = window.requestAnimationFrame(renderCanvasCards);
    };

    if (canvasCards.length) {
      window.addEventListener("scroll", requestCanvasRender, { passive: true });
      window.addEventListener("resize", requestCanvasRender);
      requestCanvasRender();
    }
  })();
</script>

