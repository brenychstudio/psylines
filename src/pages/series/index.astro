---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArtworkAtmosphereBridge from "../../components/artwork-atmosphere/ArtworkAtmosphereBridge.astro";
import SeriesWebGLBackdrop from "../../components/series/SeriesWebGLBackdrop.astro";
import SeriesConstellationField, {
  type SeriesConstellationNode,
} from "../../components/series/SeriesConstellationField";
import { artworkSeries } from "../../data/site/series";
import { getEnrichedArtworks, getSeriesArtworks } from "../../data/site/artworkCollections";
import { resolvePublicAsset } from "../../lib/assets/publicAsset";
import { getResponsivePublicImage } from "../../lib/assets/responsiveImage";

const visibleSeries = [...artworkSeries].sort((a, b) => a.order - b.order);
const primarySeries = visibleSeries[0];

const constellationLayout = {
  "meta-bodies": {
    x: 1280,
    y: 720,
    size: "hero",
    tone: "earth",
    signal: "Core pressure",
  },
  "night-water": {
    x: 2260,
    y: 350,
    size: "medium",
    tone: "blue",
    signal: "Latent reflection",
  },
  studies: {
    x: 2550,
    y: 1040,
    size: "large",
    tone: "ash",
    signal: "Material fragments",
  },
} as const;

const objectSignalLayout = {
  "mt-1": {
    x: 600,
    y: 1230,
    size: "medium",
    tone: "green",
    signal: "Object signal / vertical route",
  },
  "mt-2": {
    x: 3320,
    y: 700,
    size: "medium",
    tone: "red",
    signal: "Object signal / red pressure",
  },
  "mt-5": {
    x: 1620,
    y: 1530,
    size: "medium",
    tone: "ash",
    signal: "Object signal / folded body",
  },
} as const;

const objectSignalSlugs = Object.keys(objectSignalLayout);

const getSeriesFlagship = (series: (typeof visibleSeries)[number]) => {
  const seriesWorks = getSeriesArtworks(series.id);

  return (
    seriesWorks.find((work) => series.flagshipWorkSlugs.includes(work.slug)) ??
    seriesWorks.find((work) => series.selectedWorkSlugs.includes(work.slug)) ??
    seriesWorks[0] ??
    null
  );
};

const seriesNodes: SeriesConstellationNode[] = visibleSeries.map((series, index) => {
  const works = getSeriesArtworks(series.id);
  const flagship = getSeriesFlagship(series);
  const layout =
    constellationLayout[series.id as keyof typeof constellationLayout] ??
    ({
      x: 720 + index * 420,
      y: 420 + (index % 2) * 220,
      size: "medium",
      tone: "neutral",
      signal: "Series signal",
    } as const);
  const assetPath = flagship ? resolvePublicAsset(flagship.cover) ?? flagship.cover : "";
  const image = assetPath ? getResponsivePublicImage(assetPath, { defaultWidth: 1120 }) : null;

  return {
    id: series.slug,
    title: series.title,
    description: series.shortLine,
    href: `/series/${series.slug}`,
    objectHref: flagship ? `/works/${flagship.slug}` : `/works?series=${series.slug}`,
    coverSrc: image?.src ?? assetPath,
    coverSrcset: image?.srcset ?? "",
    coverAlt: flagship?.title ?? series.title,
    year: series.years,
    status: series.status,
    orientation: "portrait",
    count: works.length,
    atmosphereSlug: series.atmosphereProfile,
    kind: "series",
    ...layout,
  };
});

const objectSignalNodes = getEnrichedArtworks()
  .filter((work) => objectSignalSlugs.includes(work.slug))
  .map((work) => {
    const layout = objectSignalLayout[work.slug as keyof typeof objectSignalLayout];
    const assetPath = resolvePublicAsset(work.cover) ?? work.cover;
    const image = getResponsivePublicImage(assetPath, { defaultWidth: 980 });
    const label = work.meta.inventoryNumber ?? work.title;

    return {
      id: work.slug,
      title: label,
      description: work.meta.shortStatement ?? work.statement,
      href: `/works/${work.slug}`,
      objectHref: `/works/${work.slug}`,
      coverSrc: image.src,
      coverSrcset: image.srcset ?? "",
      coverAlt: work.title,
      year: String(work.meta.year ?? work.year ?? "2025"),
      status: "object signal",
      orientation: work.meta.orientation ?? work.aspect ?? "portrait",
      count: 1,
      atmosphereSlug: work.meta.atmosphereProfile || work.slug,
      kind: "object",
      ...layout,
    } satisfies SeriesConstellationNode;
  });

const constellationNodes = [...seriesNodes, ...objectSignalNodes];
const constellationPreloadImages = constellationNodes
  .map((node) => node.coverSrc)
  .filter((src): src is string => Boolean(src))
  .slice(0, 6);

const MAP_WIDTH = 3800;
const MAP_HEIGHT = 1980;
---

<BaseLayout
  title="Series - ARTIST STAGE"
  description="Authored fields and cycles within ARTIST STAGE: Meta-Bodies, Night Water, Studies, and future manifestations."
  canonicalPath="/series"
  preloadImages={constellationPreloadImages}
  hideFooter
>
  {primarySeries ? <ArtworkAtmosphereBridge slug={primarySeries.atmosphereProfile} mode="page" /> : null}
  <div class="series-webgl-backdrop" data-series-webgl-backdrop aria-hidden="true"></div>
  <div
    class="series-presence-root"
    data-cinematic-idle-root
    data-cinematic-idle-delay="6600"
    data-cinematic-idle-reduced-delay="10400"
    data-cinematic-idle-wake-duration="3900"
    data-cinematic-idle-settle-duration="3200"
    data-cinematic-idle-dream-duration="9000"
  >
    <SeriesConstellationField
      nodes={constellationNodes}
      mapWidth={MAP_WIDTH}
      mapHeight={MAP_HEIGHT}
      client:load
    />
  </div>
  <SeriesWebGLBackdrop />
</BaseLayout>

<style is:global>
  .series-presence-root {
    position: relative;
    z-index: 2;
    min-height: calc(100svh - 1px);
  }

  .series-constellation-page {
    --series-atmo-a: rgba(72, 88, 50, 0.58);
    --series-atmo-b: rgba(142, 130, 82, 0.28);
    --series-atmo-c: rgba(18, 28, 20, 0.94);
    --series-accent: rgba(167, 190, 117, 0.44);
    --series-glow-opacity: 0.58;
    --series-glow-x: 50%;
    --series-glow-y: 44%;
    --series-pan-x: 0px;
    --series-pan-y: 0px;
    --series-glow: var(--series-atmo-b);
    --series-wash: var(--series-atmo-a);
    position: relative;
    z-index: 2;
    min-height: calc(100svh - 1px);
    overflow: clip;
    background:
      radial-gradient(circle at var(--series-glow-x) var(--series-glow-y), color-mix(in srgb, var(--series-accent), transparent 97%), transparent 18rem),
      radial-gradient(ellipse at 50% 100%, rgba(0, 0, 0, 0.12), transparent 42rem),
      linear-gradient(180deg, rgba(5, 8, 7, 0), rgba(3, 6, 5, 0.05));
  }

  .series-constellation-page[data-active-tone="blue"] {
    --series-accent: rgba(88, 147, 178, 0.3);
    --series-glow: rgba(48, 112, 150, 0.24);
    --series-wash: rgba(28, 56, 70, 0.5);
  }

  .series-constellation-page[data-active-tone="ash"] {
    --series-accent: rgba(192, 170, 136, 0.24);
    --series-glow: rgba(140, 112, 82, 0.22);
    --series-wash: rgba(80, 68, 58, 0.46);
  }

  .series-constellation-page[data-active-tone="red"] {
    --series-accent: rgba(196, 76, 68, 0.3);
    --series-glow: rgba(150, 52, 42, 0.24);
    --series-wash: rgba(84, 34, 28, 0.48);
  }

  .series-constellation-page[data-active-tone="green"] {
    --series-accent: rgba(128, 172, 86, 0.28);
    --series-glow: rgba(88, 130, 64, 0.22);
    --series-wash: rgba(42, 70, 36, 0.48);
  }

  .series-constellation-shell {
    position: relative;
    min-height: 100svh;
    isolation: isolate;
    z-index: 2;
  }

  .series-constellation-shell::before {
    content: "";
    position: absolute;
    inset: 4rem 0 0;
    z-index: 1;
    pointer-events: none;
    display: none;
  }

  .series-constellation-shell::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    display: none;
  }

  .series-constellation-panel {
    position: absolute;
    left: clamp(1.25rem, 3vw, 3.5rem);
    bottom: clamp(2rem, 7svh, 5.5rem);
    z-index: 8;
    width: min(31rem, calc(100vw - 2.5rem));
    padding: clamp(1.15rem, 2vw, 1.85rem);
    border-left: 1px solid rgba(245, 248, 242, 0.08);
    background:
      linear-gradient(90deg, rgba(5, 8, 7, 0.42), rgba(5, 8, 7, 0.12) 48%, rgba(5, 8, 7, 0) 100%),
      radial-gradient(circle at 0 0, color-mix(in srgb, var(--series-accent), transparent 92%), transparent 14rem);
    backdrop-filter: none;
    box-shadow: none;
    mask-image: linear-gradient(90deg, black 0%, black 58%, rgba(0, 0, 0, 0.62) 78%, transparent 100%);
  }

  .series-constellation-kicker,
  .series-constellation-signal {
    margin: 0;
    color: rgba(235, 240, 232, 0.44);
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    line-height: 1.45;
    text-transform: uppercase;
  }

  .series-constellation-signal {
    margin-top: clamp(1.1rem, 3svh, 2rem);
    color: rgba(235, 240, 232, 0.56);
  }

  .series-constellation-panel h1 {
    margin: 0.65rem 0 0;
    max-width: 9.5ch;
    color: rgba(245, 248, 242, 0.95);
    font-size: clamp(3rem, 5.5vw, 6.2rem);
    font-weight: 300;
    letter-spacing: -0.055em;
    line-height: 0.9;
    text-wrap: balance;
  }

  .series-constellation-panel > p[data-series-active-description] {
    max-width: 30rem;
    margin: 1rem 0 0;
    color: rgba(235, 240, 232, 0.68);
    font-size: clamp(0.96rem, 1.1vw, 1.08rem);
    line-height: 1.58;
  }

  .series-constellation-meta {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.7rem;
    margin: 1.15rem 0 0;
  }

  .series-constellation-meta div {
    padding-top: 0.65rem;
    border-top: 1px solid rgba(245, 248, 242, 0.09);
  }

  .series-constellation-meta dt {
    color: rgba(235, 240, 232, 0.36);
    font-size: 0.56rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .series-constellation-meta dd {
    margin: 0.25rem 0 0;
    color: rgba(245, 248, 242, 0.78);
    font-size: 0.8rem;
    text-transform: uppercase;
  }

  .series-constellation-controls,
  .series-constellation-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 1rem;
  }

  .series-constellation-controls button,
  .series-constellation-actions a {
    min-height: 2.25rem;
    border: 1px solid rgba(245, 248, 242, 0.13);
    border-radius: 999px;
    background: rgba(245, 248, 242, 0.03);
    color: rgba(235, 240, 232, 0.66);
    font: inherit;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    line-height: 1;
    text-transform: uppercase;
    text-decoration: none;
    padding: 0 0.88rem;
    cursor: pointer;
    transition:
      transform 180ms ease,
      border-color 180ms ease,
      background 180ms ease,
      color 180ms ease;
  }

  .series-constellation-actions a {
    display: inline-flex;
    align-items: center;
  }

  .series-constellation-actions a:first-child {
    border-color: rgba(245, 248, 242, 0.74);
    background: rgba(245, 248, 242, 0.9);
    color: rgba(4, 7, 5, 0.96);
  }

  .series-constellation-controls button:hover,
  .series-constellation-controls button:focus-visible,
  .series-constellation-actions a:hover,
  .series-constellation-actions a:focus-visible {
    transform: translateY(-1px);
    border-color: rgba(245, 248, 242, 0.28);
    color: rgba(245, 248, 242, 0.94);
  }

  .series-constellation-actions a:first-child:hover,
  .series-constellation-actions a:first-child:focus-visible {
    background: rgba(245, 248, 242, 0.98);
    color: rgba(4, 7, 5, 0.98);
  }

  .series-constellation-viewport {
    position: absolute;
    inset: 0;
    z-index: 3;
    overflow: hidden;
    cursor: grab;
    touch-action: none;
    user-select: none;
    outline: none;
  }

  .series-constellation-viewport.is-grabbing {
    cursor: grabbing;
  }

  .series-constellation-map {
    position: absolute;
    left: 0;
    top: 0;
    width: 3000px;
    height: 1480px;
    will-change: transform;
  }

  .series-constellation-lines {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    opacity: 0.92;
  }

  .series-neural-web,
  .series-neural-nodes {
    pointer-events: none;
  }

  .series-neural-link {
    opacity: var(--link-opacity);
    transition: opacity 520ms ease;
  }

  .series-neural-link__body,
  .series-neural-link__signal {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .series-neural-link__body {
    stroke: rgba(223, 232, 211, 0.18);
    stroke-width: calc(var(--link-width) * 1px);
    stroke-dasharray: 9 18;
    animation: seriesNeuralDrift 16s linear infinite;
    animation-delay: var(--link-delay);
  }

  .series-neural-link__signal {
    stroke: rgba(239, 248, 226, 0.48);
    stroke-width: calc(var(--link-width) * 1.25px);
    stroke-dasharray: 1 92;
    stroke-dashoffset: 0;
    opacity: 0.52;
    filter: url("#seriesNeuralGlow");
    animation: seriesNeuralSignal 5.8s cubic-bezier(0.45, 0, 0.2, 1) infinite;
    animation-delay: var(--link-delay);
  }

  .series-neural-link[data-link-state="active"] .series-neural-link__body {
    stroke: rgba(230, 240, 214, 0.24);
    stroke-width: calc(var(--link-width) * 1px);
    stroke-dasharray: 12 16;
  }

  .series-neural-link[data-link-state="active"] .series-neural-link__signal {
    stroke: rgba(244, 252, 230, 0.68);
    opacity: 0.76;
    stroke-dasharray: 2 78;
    animation-duration: 4.6s;
  }

  .series-neural-link[data-link-proximity="far"] {
    opacity: calc(var(--link-opacity) * 0.52);
  }

  .series-neural-node {
    fill: rgba(239, 248, 226, 0.3);
    stroke: rgba(239, 248, 226, 0.14);
    stroke-width: 1;
    opacity: 0.42;
    filter: url("#seriesNeuralGlow");
    transform-box: fill-box;
    transform-origin: center;
    animation: seriesNeuralNodeBreath 4.8s ease-in-out infinite alternate;
  }

  .series-neural-node[data-node-state="active"] {
    fill: rgba(244, 252, 230, 0.74);
    stroke: rgba(244, 252, 230, 0.34);
    opacity: 0.86;
  }

  .series-neural-node[data-node-state="hovered"] {
    fill: rgba(244, 252, 230, 0.56);
    opacity: 0.74;
  }

  .series-constellation-node {
    --node-glow: var(--series-glow);
    --node-accent: var(--series-accent);
    position: absolute;
    left: var(--node-x);
    top: var(--node-y);
    z-index: 2;
    display: block;
    width: 280px;
    color: inherit;
    text-decoration: none;
    transform: translate3d(-50%, -50%, 0);
    opacity: 1;
    filter: saturate(0.72) contrast(0.9) brightness(0.58);
    transition:
      opacity 420ms ease,
      filter 520ms ease,
      transform 620ms cubic-bezier(0.16, 1, 0.3, 1);
    outline-offset: 0.75rem;
    user-select: none;
    -webkit-user-drag: none;
  }

  .series-constellation-node[data-series-tone="earth"] {
    --node-glow: rgba(142, 166, 86, 0.26);
    --node-accent: rgba(166, 184, 110, 0.42);
  }

  .series-constellation-node[data-series-tone="green"] {
    --node-glow: rgba(116, 168, 76, 0.28);
    --node-accent: rgba(145, 189, 95, 0.42);
  }

  .series-constellation-node[data-series-tone="blue"] {
    --node-glow: rgba(84, 130, 148, 0.24);
    --node-accent: rgba(106, 155, 171, 0.38);
  }

  .series-constellation-node[data-series-tone="ash"] {
    --node-glow: rgba(174, 150, 112, 0.23);
    --node-accent: rgba(185, 162, 118, 0.36);
  }

  .series-constellation-node[data-series-tone="red"] {
    --node-glow: rgba(186, 78, 58, 0.25);
    --node-accent: rgba(192, 106, 79, 0.42);
  }

  .series-constellation-node--hero {
    width: min(470px, 34vw);
  }

  .series-constellation-node--large {
    width: min(360px, 27vw);
  }

  .series-constellation-node--medium {
    width: min(300px, 22vw);
  }

  .series-constellation-node figure {
    position: relative;
    margin: 0;
    overflow: visible;
    isolation: isolate;
    background: transparent;
  }

  .series-constellation-node figure::before {
    content: "";
    position: absolute;
    inset: -16%;
    z-index: -1;
    background:
      radial-gradient(circle at 50% 42%, color-mix(in srgb, var(--node-accent), transparent 22%), transparent 38%),
      radial-gradient(ellipse at 50% 84%, rgba(0, 0, 0, 0.38), transparent 70%);
    opacity: 0.32;
    filter: blur(2px);
    transform: scale(1);
    transition:
      opacity 680ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 820ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .series-constellation-node figure::after {
    content: "";
    position: absolute;
    inset: -7%;
    z-index: 1;
    pointer-events: none;
    display: none;
  }

  .series-constellation-node img,
  .series-constellation-empty {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
    position: relative;
    z-index: 2;
    background: transparent;
    box-shadow:
      0 34px 108px rgba(0, 0, 0, 0.42),
      0 0 44px color-mix(in srgb, var(--node-accent), transparent 86%),
      0 0 0 1px rgba(245, 248, 242, 0.035);
    -webkit-user-drag: none;
    user-select: none;
  }

  .series-constellation-node__open {
    position: absolute;
    right: 1.05rem;
    bottom: 1.05rem;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    justify-content: center;
    min-height: 2rem;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: rgba(245, 248, 242, 0.88);
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    line-height: 1;
    text-transform: uppercase;
    padding: 0 0 0.1rem;
    opacity: 0;
    pointer-events: none;
    text-shadow: 0 0 20px rgba(245, 248, 242, 0.28);
    transform: translate3d(0.45rem, 0.35rem, 0);
    transition:
      opacity 220ms ease,
      transform 320ms cubic-bezier(0.16, 1, 0.3, 1),
      color 180ms ease;
  }

  .series-constellation-node__open::before {
    content: "";
    display: block;
    width: 3.6rem;
    height: 1px;
    background: linear-gradient(90deg, rgba(245, 248, 242, 0.16), rgba(245, 248, 242, 0.7));
    transform-origin: right center;
    transition:
      width 320ms cubic-bezier(0.16, 1, 0.3, 1),
      background 180ms ease;
  }

  .series-constellation-node__open::after {
    content: "";
    position: absolute;
    left: -0.45rem;
    right: -0.45rem;
    bottom: -0.45rem;
    height: 2.1rem;
    z-index: -1;
    background:
      radial-gradient(ellipse at 72% 50%, rgba(245, 248, 242, 0.1), transparent 68%),
      linear-gradient(90deg, transparent, rgba(4, 6, 5, 0.18));
    opacity: 0;
    transition: opacity 220ms ease;
  }

  .series-constellation-node figure:hover .series-constellation-node__open,
  .series-constellation-node.is-hovered .series-constellation-node__open,
  .series-constellation-node:focus-visible .series-constellation-node__open {
    opacity: 1;
    pointer-events: auto;
    transform: translate3d(0, 0, 0);
  }

  .series-constellation-node__open:hover {
    color: rgba(255, 255, 250, 0.98);
    transform: translate3d(0.15rem, 0, 0);
  }

  .series-constellation-node__open:hover::before {
    width: 4.5rem;
    background: linear-gradient(90deg, rgba(245, 248, 242, 0.24), rgba(255, 255, 250, 0.92));
  }

  .series-constellation-node__open:hover::after {
    opacity: 1;
  }

  .series-constellation-empty {
    aspect-ratio: 3 / 4;
    border: 1px solid rgba(245, 248, 242, 0.08);
    background:
      linear-gradient(90deg, rgba(245, 248, 242, 0.04) 1px, transparent 1px),
      linear-gradient(180deg, rgba(245, 248, 242, 0.028) 1px, transparent 1px);
    background-size: 3rem 3rem;
  }

  .series-constellation-node__caption {
    display: grid;
    grid-template-columns: 2.4rem minmax(0, 1fr);
    gap: 0.25rem 0.75rem;
    margin-top: 0.72rem;
    color: rgba(235, 240, 232, 0.44);
  }

  .series-constellation-node__caption span {
    grid-row: span 2;
    color: rgba(235, 240, 232, 0.36);
    font-size: 0.62rem;
    letter-spacing: 0.16em;
  }

  .series-constellation-node__caption strong {
    color: rgba(245, 248, 242, 0.78);
    font-size: 0.82rem;
    line-height: 1.25;
    text-transform: uppercase;
  }

  .series-constellation-node__caption small {
    color: rgba(235, 240, 232, 0.38);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .series-constellation-node:hover,
  .series-constellation-node.is-hovered,
  .series-constellation-node:focus-visible,
  .series-constellation-node.is-active {
    z-index: 8;
    opacity: 1;
    filter: saturate(1.12) contrast(1.08) brightness(1.08);
    transform: translate3d(-50%, -51.5%, 0) scale(1.045);
    transition:
      transform 620ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .series-constellation-node.is-active {
    z-index: 10;
    transform: translate3d(-50%, -54%, 0) scale(1.095);
  }

  .series-constellation-node.is-hovered:not(.is-active) {
    z-index: 9;
    opacity: 0.92;
    filter: saturate(1.08) contrast(1.05) brightness(1.05);
    transform: translate3d(-50%, -52.5%, 0) scale(1.045);
  }

  .series-constellation-node.is-hovered:not(.is-active) figure::before {
    opacity: 0.5;
    transform: scale(1.055);
  }

  .series-constellation-node.is-hovered:not(.is-active) img {
    box-shadow:
