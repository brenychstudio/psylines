---
import {
  getCommerceOptionMaterialLine,
  getCommerceOptionProofLine,
  getCommerceOptionTypeLabel,
  type CommerceOption,
  type CommerceProduct,
} from "../../data/commerce/catalog";
import type { ArtworkMeta } from "../../data/site/artworkMeta";
import type { ArtworkSeries } from "../../data/site/series";
import type { WorkItem } from "../../data/site/types";
import { buildCollectorInquiryHref } from "../../lib/contactInquiry";

type Props = {
  work: WorkItem;
  commerceProduct: CommerceProduct | null;
  defaultCommerceOption: CommerceOption | null;
  defaultOptionTypeLabel: string;
  defaultOptionProofLine: string;
  defaultOptionMaterialLine: string;
  printOptions: CommerceOption[];
  originalOption: CommerceOption | null;
  artworkMeta?: ArtworkMeta;
  artworkSeries?: ArtworkSeries | null;
};

const {
  work,
  commerceProduct,
  defaultCommerceOption,
  defaultOptionTypeLabel,
  defaultOptionProofLine,
  defaultOptionMaterialLine,
  printOptions,
  originalOption,
  artworkMeta,
  artworkSeries,
} = Astro.props as Props;

function getCompactProofLine(option: CommerceOption | null, fallback: string) {
  if (!option) return fallback;

  if (option.type === "original") {
    return "signed - certificate included";
  }

  const edition = option.editionSize ? `edition of ${option.editionSize}` : option.editionNumberLabel;
  const parts = [
    edition,
    option.signed ? "signed" : null,
    option.certificateIncluded ? "certificate" : null,
  ].filter(Boolean);

  return parts.join(" - ") || fallback;
}

function getCompactMaterialLine(option: CommerceOption | null, fallback: string) {
  if (!option) return fallback;
  if (option.type === "original") return "original surface";
  if (option.paper?.toLowerCase().includes("archival")) return "pigment print / archival paper";
  return option.printMethod && option.paper ? `${option.printMethod} / ${option.paper}` : fallback;
}

const defaultCompactProofLine = getCompactProofLine(defaultCommerceOption, defaultOptionProofLine);
const defaultCompactMaterialLine = getCompactMaterialLine(defaultCommerceOption, defaultOptionMaterialLine);
const hasCommerceRoute = Boolean(commerceProduct && defaultCommerceOption);
const availabilityStatus = artworkMeta?.acquisitionStatus ?? (hasCommerceRoute ? "available" : "inquiry");
const canCheckout = hasCommerceRoute && !["reserved", "sold", "not_for_sale"].includes(availabilityStatus);
const hasPreviewRoute = Boolean(artworkMeta?.dimensions ?? work.dimensions);

const inventoryNumber = artworkMeta?.inventoryNumber ?? work.title;
const contextLabel = artworkSeries?.title ?? "Independent Manifestation";
const recordParts = [
  inventoryNumber,
  artworkMeta?.year ? String(artworkMeta.year) : null,
  contextLabel,
].filter(Boolean);

const formatDetails = [
  artworkMeta?.format,
  artworkMeta?.dimensions,
  artworkMeta?.orientation,
].filter(Boolean).join(" / ");

const materialsLine = artworkMeta?.materials?.length
  ? artworkMeta.materials.join(", ")
  : "";

const processLayerLine = [
  artworkMeta?.primaryGesture,
  artworkMeta?.surfaceLayer,
  artworkMeta?.colorLayer,
  artworkMeta?.finalLine,
].filter(Boolean).join(" / ");

function getAvailabilityLabel(status: typeof availabilityStatus) {
  switch (status) {
    case "available":
      return "Available";
    case "reserved":
      return "Reserved";
    case "sold":
      return "Placed";
    case "not_for_sale":
      return "Not in public route";
    default:
      return "Inquiry";
  }
}

function getAvailabilityCopy(status: typeof availabilityStatus) {
  if (status === "available") {
    if (originalOption && printOptions.length > 0) {
      return "Original and selected edition routes are currently open.";
    }

    if (originalOption) {
      return "Original collector route is currently open.";
    }

    if (printOptions.length > 0) {
      return "Selected edition routes are currently open.";
    }

    return "Collector route is currently open.";
  }

  if (status === "reserved") {
    return "This work is under collector hold. Use inquiry for follow-up or nearby alternatives.";
  }

  if (status === "sold") {
    return "This work is already placed. Inquiry can open adjacent or series-related options.";
  }

  if (status === "not_for_sale") {
    return "This work is outside the public collector route and remains available for context only.";
  }

  return "Availability, pricing, and next steps are shared through direct studio contact.";
}

const availabilityLabel = getAvailabilityLabel(availabilityStatus);
const availabilityCopy = getAvailabilityCopy(availabilityStatus);
const routeBackHref = artworkSeries ? `/works?series=${artworkSeries.slug}` : "/works";
const routeBackLabel = artworkSeries ? "Return to series works" : "Return to works field";
const seriesChapterHref = artworkSeries ? `/series/${artworkSeries.slug}` : null;
const defaultRouteLabel = defaultCommerceOption
  ? getCommerceOptionTypeLabel(defaultCommerceOption)
  : availabilityStatus === "sold"
    ? "Placed work"
    : availabilityStatus === "reserved"
      ? "Collector hold"
      : "Original inquiry";
const defaultFormatLabel = defaultCommerceOption?.label ?? artworkMeta?.format ?? "Original work";
const defaultDimensions = defaultCommerceOption?.dimensions ?? artworkMeta?.dimensions ?? work.dimensions ?? "";
const defaultPriceLabel = defaultCommerceOption ? `EUR ${defaultCommerceOption.priceEUR}` : "Shared on request";
const defaultCollectorFormatLine = [
  defaultCommerceOption?.dimensions ?? formatDetails,
  artworkMeta?.orientation,
].filter(Boolean).join(" / ");
const defaultEditionLine = defaultCommerceOption?.editionNumberLabel ?? defaultRouteLabel;
const defaultTechniqueLine = defaultCommerceOption?.type === "original"
  ? artworkMeta?.technique
  : defaultCommerceOption?.printMethod;
const defaultSurfaceLine = defaultCommerceOption?.type === "original"
  ? artworkMeta?.surfaceTreatment
  : [defaultCommerceOption?.printMethod, defaultCommerceOption?.paper].filter(Boolean).join(" / ");
const defaultPaperLine = defaultCommerceOption?.type === "original"
  ? artworkMeta?.paper
  : defaultCommerceOption?.paper;
const defaultMaterialsLine = defaultCommerceOption?.type === "original"
  ? materialsLine
  : [defaultCommerceOption?.printMethod, defaultCommerceOption?.paper].filter(Boolean).join(" / ");
const defaultSignatureLine = defaultCommerceOption
  ? (defaultCommerceOption.signed ? "Signed" : "Signature not included")
  : (artworkMeta?.signature === "signed" ? "Signed" : "Signature status pending");
const defaultCertificateLine = defaultCommerceOption
  ? (defaultCommerceOption.certificateIncluded ? "Certificate of authenticity included" : "Certificate not included")
  : (artworkMeta?.certificate ? "Certificate of authenticity included" : "Certificate context pending");
const defaultPresentationLine = defaultCommerceOption?.framedOption
  ? "Framing option available"
  : "Unframed";
const inquiryHref = buildCollectorInquiryHref({
  context: "collector",
  workTitle: work.title,
  workSlug: work.slug,
  inventoryNumber,
  seriesTitle: artworkSeries?.title ?? null,
  seriesSlug: artworkSeries?.slug ?? null,
  routeLabel: defaultRouteLabel,
  formatLabel: defaultFormatLabel,
  dimensions: defaultDimensions,
  priceLabel: defaultPriceLabel,
  source: "work-detail",
});
---

<div
  id="collector-route"
  class="detail-purchase-panel collector-instrument__route floating-acquisition-annotation"
  data-collector-route
>
  <p class="detail-purchase-kicker">collector route</p>

  <p class="collector-object-record">
    {recordParts.map((part) => (
      <span>{part}</span>
    ))}
  </p>

  <div class="detail-purchase-topline collector-instrument__route-copy">
    <div class="collector-availability" aria-label={`Availability: ${availabilityCopy}`}>
      <span class={`collector-availability__badge is-${availabilityStatus}`}>{availabilityLabel}</span>
    </div>
  </div>

  {canCheckout && commerceProduct ? (
    <>
      <div class="detail-purchase-size-row collector-instrument__selector">
        <p class="detail-purchase-label">Format</p>

        <div class="detail-size-options">
          {commerceProduct.options.map((option, index, array) => {
            const isDefaultActive = option.sizeKey === "original" || (!array.some((item) => item.sizeKey === "original") && index === 0);

            return (
              <button
                type="button"
                class={`detail-size-chip ${isDefaultActive ? "is-active" : ""}`}
                data-size-chip
                data-size-label={option.sizeKey}
                data-size-dimensions={option.dimensions}
                data-size-price={String(option.priceEUR)}
                data-size-type-label={getCommerceOptionTypeLabel(option)}
                data-size-proof-line={getCompactProofLine(option, getCommerceOptionProofLine(option))}
                data-size-material-line={getCompactMaterialLine(option, getCommerceOptionMaterialLine(option))}
                data-size-production-time={option.productionTime ?? ""}
                data-size-return-window={option.returnWindow ?? ""}
                data-size-shipping-note={option.shippingNote ?? ""}
                data-size-collector-format={[
                  option.dimensions,
                  artworkMeta?.orientation,
                ].filter(Boolean).join(" / ")}
                data-size-edition-label={option.editionNumberLabel ?? getCommerceOptionTypeLabel(option)}
                data-size-technique={option.type === "original" ? artworkMeta?.technique ?? "" : option.printMethod ?? ""}
                data-size-surface={option.type === "original"
                  ? artworkMeta?.surfaceTreatment ?? ""
                  : [option.printMethod, option.paper].filter(Boolean).join(" / ")}
                data-size-paper={option.type === "original" ? artworkMeta?.paper ?? "" : option.paper ?? ""}
                data-size-materials={option.type === "original"
                  ? materialsLine
                  : [option.printMethod, option.paper].filter(Boolean).join(" / ")}
                data-size-signature={option.signed ? "Signed" : "Signature not included"}
                data-size-certificate={option.certificateIncluded
                  ? "Certificate of authenticity included"
                  : "Certificate not included"}
                data-size-presentation={option.framedOption ? "Framing option available" : "Unframed"}
              >
                {option.label}
              </button>
            );
          })}
        </div>
      </div>

      <div class="detail-purchase-price-row collector-instrument__readout">
        <div class="collector-instrument__readout-cell">
          <p class="detail-purchase-label">Price</p>
          <p class="detail-price-value" data-price-display>
            EUR {defaultCommerceOption?.priceEUR ?? 0}
          </p>
        </div>

        <div class="collector-instrument__readout-cell">
          <p class="detail-purchase-label">Selected format</p>
          <p class="detail-format-value" data-format-display>
            {defaultCommerceOption?.dimensions ?? work.dimensions}
          </p>
        </div>
      </div>

      <div class="detail-purchase-proof-list collector-instrument__proof collector-signal-line" hidden>
        <span data-type-display>{defaultOptionTypeLabel}</span>
        <span data-proof-display>{defaultCompactProofLine}</span>
        <span data-material-display>{defaultCompactMaterialLine}</span>
      </div>

      <div class="detail-purchase-actions collector-instrument__actions" data-collector-actions>
        <button
          type="button"
          class="detail-purchase-primary"
          data-buy-now
          data-buy-now-default-label={defaultRouteLabel}
        >
          Acquire work
        </button>
        {hasPreviewRoute ? (
          <button type="button" class="detail-purchase-secondary" data-print-ar-open data-space-preview-open>
            Preview in space
          </button>
        ) : null}
        <a
          href={inquiryHref}
          class="detail-purchase-secondary"
          data-collector-inquiry-link
          data-inquiry-work-title={work.title}
          data-inquiry-work-slug={work.slug}
          data-inquiry-inventory={inventoryNumber}
          data-inquiry-series-title={artworkSeries?.title ?? ""}
          data-inquiry-series-slug={artworkSeries?.slug ?? ""}
          data-inquiry-default-route={defaultRouteLabel}
          data-inquiry-default-format={defaultFormatLabel}
          data-inquiry-default-dimensions={defaultDimensions}
          data-inquiry-default-price={defaultPriceLabel}
        >
          Ask about this work
        </a>
      </div>
    </>
  ) : (
    <div class="detail-purchase-actions collector-instrument__actions" data-collector-actions>
      <a
        href={inquiryHref}
        class="detail-purchase-primary"
        data-collector-inquiry-link
        data-inquiry-work-title={work.title}
        data-inquiry-work-slug={work.slug}
        data-inquiry-inventory={inventoryNumber}
        data-inquiry-series-title={artworkSeries?.title ?? ""}
        data-inquiry-series-slug={artworkSeries?.slug ?? ""}
        data-inquiry-default-route={defaultRouteLabel}
        data-inquiry-default-format={defaultFormatLabel}
        data-inquiry-default-dimensions={defaultDimensions}
        data-inquiry-default-price={defaultPriceLabel}
      >
        {availabilityStatus === "sold" ? "Ask about related works" : "Inquire about this work"}
      </a>
      {hasPreviewRoute ? (
        <button type="button" class="detail-purchase-secondary" data-print-ar-open data-space-preview-open>
          Preview in space
        </button>
      ) : null}
    </div>
  )}

  <details class="detail-purchase-meta collector-instrument__logistics collector-details" data-collector-details>
    <summary
      data-collector-details-summary
      aria-controls="collector-details-panel"
      aria-expanded="false"
    >
      Collector details
    </summary>

    <button
      type="button"
      class="collector-details-backdrop"
      data-collector-details-close
      aria-label="Close collector details"
    ></button>

    <div
      id="collector-details-panel"
      class="collector-details-panel"
      data-collector-details-panel
      aria-label="Collector object record"
      tabindex="-1"
    >
      <div class="collector-details-panel__head">
        <p>Collector record</p>
        <span>{inventoryNumber} / {artworkMeta?.year ?? work.year ?? "field"}</span>
      </div>

      <dl class="collector-details-list">
        <div class="detail-purchase-meta-row" data-collector-detail="availability" data-collector-detail-priority="primary">
          <dt>Availability</dt>
          <dd>{availabilityLabel} - {availabilityCopy}</dd>
        </div>

        <div class="detail-purchase-meta-row" data-collector-detail="selected-route" data-collector-detail-priority="primary">
          <dt>Selected route</dt>
          <dd>
            <span data-collector-route-display>{defaultRouteLabel}</span>
            <span class="collector-details-separator" aria-hidden="true"> / </span>
            <span data-collector-price-display>{defaultPriceLabel}</span>
          </dd>
        </div>

        <div class="detail-purchase-meta-row" data-collector-detail="edition" data-collector-detail-priority="primary">
          <dt>Edition</dt>
          <dd data-edition-display>{defaultEditionLine}</dd>
        </div>

        {artworkSeries ? (
          <div class="detail-purchase-meta-row" data-collector-detail="series" data-collector-detail-priority="primary">
            <dt>Series</dt>
            <dd>
              <a href={`/series/${artworkSeries.slug}`}>{artworkSeries.title}</a>
            </dd>
          </div>
        ) : (
          <div class="detail-purchase-meta-row" data-collector-detail="context" data-collector-detail-priority="primary">
            <dt>Context</dt>
            <dd>Independent Manifestation</dd>
          </div>
        )}

        {artworkMeta?.inventoryNumber ? (
          <div class="detail-purchase-meta-row" data-collector-detail="inventory" data-collector-detail-priority="secondary">
            <dt>Inventory</dt>
            <dd>{artworkMeta.inventoryNumber}</dd>
          </div>
        ) : null}

        {artworkMeta?.year ? (
          <div class="detail-purchase-meta-row" data-collector-detail="year" data-collector-detail-priority="secondary">
            <dt>Year</dt>
            <dd>{artworkMeta.year}</dd>
          </div>
        ) : null}

        {formatDetails ? (
          <div class="detail-purchase-meta-row" data-collector-detail="format" data-collector-detail-priority="primary">
            <dt>Format</dt>
            <dd data-collector-format-detail>{defaultCollectorFormatLine || formatDetails}</dd>
          </div>
        ) : null}

        {artworkMeta?.technique ? (
          <div class="detail-purchase-meta-row" data-collector-detail="method" data-collector-detail-priority="primary">
            <dt>Technique</dt>
            <dd data-technique-display>
              <a href="/process">{defaultTechniqueLine || artworkMeta.technique}</a>
            </dd>
          </div>
        ) : null}

        {artworkMeta?.techniqueNote ? (
          <div class="detail-purchase-meta-row" data-collector-detail="process" data-collector-detail-priority="secondary">
            <dt>Process</dt>
            <dd>{artworkMeta.techniqueNote}</dd>
          </div>
        ) : null}

        {artworkMeta?.referencePolicy ? (
          <div class="detail-purchase-meta-row" data-collector-detail="reference" data-collector-detail-priority="secondary">
            <dt>Reference</dt>
            <dd>{artworkMeta.referencePolicy}</dd>
          </div>
        ) : null}

        {processLayerLine ? (
          <div class="detail-purchase-meta-row" data-collector-detail="layers" data-collector-detail-priority="secondary">
            <dt>Layers</dt>
            <dd>{processLayerLine}</dd>
          </div>
        ) : null}

        {artworkMeta?.surfaceTreatment ? (
          <div class="detail-purchase-meta-row" data-collector-detail="surface" data-collector-detail-priority="secondary">
            <dt>Surface</dt>
            <dd>{defaultSurfaceLine || artworkMeta.surfaceTreatment}</dd>
          </div>
        ) : null}

        {artworkMeta?.paper ? (
          <div class="detail-purchase-meta-row" data-collector-detail="paper" data-collector-detail-priority="secondary">
            <dt>Paper</dt>
            <dd data-paper-display>{defaultPaperLine || artworkMeta.paper}</dd>
          </div>
        ) : null}

        {materialsLine ? (
          <div class="detail-purchase-meta-row" data-collector-detail="materials" data-collector-detail-priority="primary">
            <dt>Materials / surface</dt>
            <dd class="collector-record-stack">
              <span data-materials-detail-display>{defaultMaterialsLine || materialsLine}</span>
              <span class="collector-record-line collector-record-line--muted" data-surface-display>
                {defaultSurfaceLine || artworkMeta?.surfaceTreatment || "Surface treatment documented with the work."}
              </span>
            </dd>
          </div>
        ) : null}

        <div class="detail-purchase-meta-row" data-collector-detail="signature" data-collector-detail-priority="primary">
          <dt>Collector package</dt>
          <dd class="collector-record-stack collector-record-stack--inline">
            <span data-signature-display>{defaultSignatureLine}</span>
            <span data-certificate-display>{defaultCertificateLine}</span>
            <span data-presentation-display>{defaultPresentationLine}</span>
          </dd>
        </div>

        <div class="detail-purchase-meta-row" data-collector-detail="routes" data-collector-detail-priority="secondary">
          <dt>Routes</dt>
          <dd class="collector-details-routes">
            {seriesChapterHref ? <a href={seriesChapterHref}>Series chapter</a> : null}
            <a href={routeBackHref}>
              Works index
            </a>
            <a href={inquiryHref} data-collector-inquiry-link>
              Contact the studio
            </a>
          </dd>
        </div>

        {hasPreviewRoute ? (
          <div class="detail-purchase-meta-row" data-collector-detail="viewing" data-collector-detail-priority="secondary">
            <dt>Viewing</dt>
            <dd>Interior scale preview is available as a collector confidence tool.</dd>
          </div>
        ) : null}

        {canCheckout ? (
          <>
            <div class="detail-purchase-meta-row" data-collector-detail="production" data-collector-detail-priority="primary">
              <dt>Delivery & terms</dt>
              <dd class="collector-record-stack">
                <span data-production-display>
                  {defaultCommerceOption?.productionTime ?? "Production timing confirmed inside the collector route."}
                </span>
                <span class="collector-record-line" data-shipping-display>
                  {defaultCommerceOption?.shippingNote ?? "Shipping route confirmed after checkout."}
                </span>
                <span class="collector-record-line collector-record-line--muted" data-return-display>
                  {defaultCommerceOption?.returnWindow ?? "Return terms confirmed by selected option."}
                </span>
              </dd>
            </div>
          </>
        ) : null}

        <div class="detail-purchase-meta-row" data-collector-detail="policies" data-collector-detail-priority="primary">
          <dt>Collector terms</dt>
          <dd class="collector-details-routes">
            <a href="/collectors">Collector process</a>
            <a href="/policies/shipping">Shipping</a>
            <a href="/policies/returns">Returns</a>
            <a href="/policies/terms">Terms</a>
          </dd>
        </div>
      </dl>

      <button type="button" class="collector-details-close" data-collector-details-close aria-label="Close collector details">
        Close details
      </button>
    </div>
  </details>

  <div class="detail-checkout-status" aria-live="polite">
    <div class="detail-checkout-feedback" data-checkout-feedback></div>
  </div>
  <div class="detail-checkout-overlay" data-checkout-overlay hidden>
    <div class="detail-checkout-overlay-inner">
      <div class="detail-checkout-spinner" aria-hidden="true"></div>
      <p class="detail-checkout-overlay-kicker">Preparing secure checkout</p>
      <p class="detail-checkout-overlay-copy" data-checkout-overlay-copy>
        Redirecting to Stripe...
      </p>
    </div>
  </div>
</div>

<style>
  .collector-details {
    position: relative;
    z-index: 4;
    display: grid;
    gap: 0;
    margin-top: 0.25rem;
  }

  .collector-details::before {
    content: "";
    position: absolute;
    inset: -0.7rem -0.9rem auto;
    height: 0;
    pointer-events: none;
    background:
      radial-gradient(circle at 42% 0%, color-mix(in srgb, var(--artwork-glow), transparent 72%), transparent 58%),
      linear-gradient(90deg, rgba(245, 248, 242, 0), rgba(245, 248, 242, 0.08), rgba(245, 248, 242, 0));
    opacity: 0;
    filter: blur(18px);
    transition:
      height 740ms cubic-bezier(0.16, 1, 0.3, 1),
      opacity 640ms ease;
  }

  .collector-details[open]::before {
    height: calc(100% + 1.4rem);
    opacity: 0.48;
  }

  .collector-details summary {
    width: fit-content;
    list-style: none;
    cursor: pointer;
    color: rgba(232, 238, 228, 0.56);
    font-size: 0.72rem;
    line-height: 1.2;
    text-decoration: underline;
    text-underline-offset: 0.22rem;
    transition:
      color 360ms ease,
      transform 520ms cubic-bezier(0.16, 1, 0.3, 1),
      opacity 360ms ease;
  }

  .collector-details summary::-webkit-details-marker {
    display: none;
  }

  .collector-details[open] summary {
    color: rgba(246, 250, 242, 0.78);
    transform: translate3d(0, -0.06rem, 0);
  }

  .collector-details-panel {
    position: relative;
    z-index: 2;
    width: 100%;
    max-height: 0;
    display: grid;
    gap: 0;
    margin-top: 0;
    padding: 0 1.02rem;
    overflow: hidden;
    border: 1px solid rgba(232, 238, 228, 0.13);
    border-left-color: rgba(232, 238, 228, 0.26);
    border-radius: 8px;
    background:
      radial-gradient(circle at 8% 0%, color-mix(in srgb, var(--artwork-glow), transparent 62%), transparent 42%),
      radial-gradient(circle at 96% 100%, rgba(245, 248, 242, 0.045), transparent 46%),
      linear-gradient(135deg, rgba(245, 248, 242, 0.074), rgba(245, 248, 242, 0.02) 48%, rgba(6, 11, 7, 0.34)),
      color-mix(in srgb, rgba(8, 15, 10, 0.58), var(--artwork-wash-strong) 14%);
    -webkit-backdrop-filter: blur(14px) saturate(1.08);
    backdrop-filter: blur(14px) saturate(1.08);
    box-shadow:
      0 18px 64px rgba(0, 0, 0, 0.28),
      0 0 42px color-mix(in srgb, var(--artwork-glow), transparent 88%),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
    opacity: 0;
    pointer-events: none;
    transform: translate3d(0, -0.3rem, 0);
    transform-origin: top center;
    clip-path: inset(0 0 100% 0 round 8px);
    transition:
      max-height 820ms cubic-bezier(0.16, 1, 0.3, 1),
      margin-top 720ms cubic-bezier(0.16, 1, 0.3, 1),
      padding 720ms cubic-bezier(0.16, 1, 0.3, 1),
      opacity 520ms ease,
      transform 740ms cubic-bezier(0.16, 1, 0.3, 1),
      clip-path 820ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .collector-details-panel::before {
    content: "";
    position: absolute;
    left: 1.1rem;
    right: 1.1rem;
    top: 0;
    height: 1px;
    pointer-events: none;
    background: linear-gradient(90deg, rgba(245, 248, 242, 0), rgba(245, 248, 242, 0.28), rgba(245, 248, 242, 0));
    opacity: 0.72;
  }

  .collector-details-panel::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(180deg, rgba(245, 248, 242, 0.045), transparent 30%),
      linear-gradient(90deg, color-mix(in srgb, var(--artwork-glow), transparent 88%), transparent 34%);
    opacity: 0.62;
  }

