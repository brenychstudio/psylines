---
type CycleSubsetItem = {
  title: string;
  slug: string;
  year: number;
  coverSrc: string | null;
  statement: string;
  seriesTitle?: string;
};

type Props = {
  items: CycleSubsetItem[];
};

const { items } = Astro.props as Props;
---

<section class="cycle-subset">
  <div class="cycle-subset-head">
    <div>
      <p class="cycle-subset-kicker">selected manifestations</p>
      <h2 class="cycle-subset-title">Field fragments</h2>
    </div>
    <a href="/works" class="cycle-subset-link">Open full archive</a>
  </div>

  <div class="cycle-subset-grid">
    {items.map((item) => (
      <a href={`/works/${item.slug}`} class="cycle-subset-item">
        <div class="cycle-subset-media">
          {item.coverSrc ? (
            <>
              <img src={item.coverSrc} alt={`${item.title} artwork`} class="cycle-subset-image" loading="lazy" decoding="async" />
              <div class="cycle-subset-frame"></div>
            </>
          ) : null}
        </div>

        <div class="cycle-subset-copy">
          <p class="cycle-subset-item-kicker">{item.year} · {item.seriesTitle ?? "Cycle fragment"}</p>
          <div class="cycle-subset-title-row">
            <h3 class="cycle-subset-item-title">{item.title}</h3>
            <span class="cycle-subset-open">Open</span>
          </div>
          <p class="cycle-subset-item-text">{item.statement}</p>
        </div>
      </a>
    ))}
  </div>
</section>

<style>
  .cycle-subset {
    position: relative;
    z-index: 2;
    margin: 0 auto;
    max-width: 88rem;
    padding: 0 1.5rem 2.5rem;
  }

  .cycle-subset-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.2rem;
  }

  .cycle-subset-kicker {
    margin: 0;
    font-size: 0.72rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: rgba(244, 241, 234, 0.5);
  }

  .cycle-subset-title {
    margin: 0.5rem 0 0;
    font-size: clamp(1.7rem, 4vw, 2.5rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .cycle-subset-link {
    font-size: 0.84rem;
    color: rgba(244, 241, 234, 0.76);
  }

  .cycle-subset-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.1rem;
  }

  .cycle-subset-item {
    display: block;
  }

  .cycle-subset-media {
    position: relative;
    overflow: hidden;
    background:
      linear-gradient(180deg, rgba(255,255,255,0.018), rgba(255,255,255,0.006));
  }

  .cycle-subset-image {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: contain;
    object-position: center center;
  }

  .cycle-subset-frame {
    position: absolute;
    inset: 0.65rem;
    border: 1px solid rgba(255, 255, 255, 0.05);
    pointer-events: none;
  }

  .cycle-subset-copy {
    padding-top: 0.8rem;
  }

  .cycle-subset-item-kicker {
    margin: 0;
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(244, 241, 234, 0.5);
  }

  .cycle-subset-title-row {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.55rem;
  }

  .cycle-subset-item-title {
    margin: 0;
    font-size: 1.55rem;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .cycle-subset-open {
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(244, 241, 234, 0.48);
  }

  .cycle-subset-item-text {
    margin: 0.7rem 0 0;
    color: rgba(244, 241, 234, 0.68);
    line-height: 1.68;
    font-size: 0.94rem;
  }

  @media (max-width: 980px) {
    .cycle-subset-grid {
      grid-template-columns: 1fr;
    }

    .cycle-subset-head {
      flex-direction: column;
      align-items: start;
    }
  }
</style>
