---
type Props = {
  title: string;
  headline: string;
  intro: string;
  keywords: string[];
  worksCount: number;
};

const { title, headline, intro, keywords, worksCount } = Astro.props as Props;
---

<section class="cycle-hero">
  <div class="cycle-hero-copy">
    <p class="cycle-hero-kicker">cycle field</p>
    <h1 class="cycle-hero-title">{headline}</h1>
    <p class="cycle-hero-intro">{intro}</p>

    <div class="cycle-hero-keywords">
      {keywords.map((item) => (
        <span class="cycle-hero-keyword">{item}</span>
      ))}
    </div>
  </div>

  <div class="cycle-hero-meta">
    <p class="cycle-hero-meta-label">cycle</p>
    <p class="cycle-hero-meta-title">{title}</p>

    <p class="cycle-hero-meta-label">mapped works</p>
    <p class="cycle-hero-meta-count">{worksCount}</p>
  </div>
</section>

<style>
  .cycle-hero {
    position: relative;
    z-index: 2;
    margin: 0 auto;
    max-width: 88rem;
    padding: 5.5rem 1.5rem 1.8rem;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(14rem, 0.42fr);
    gap: 2rem;
    align-items: end;
  }

  .cycle-hero-kicker,
  .cycle-hero-meta-label {
    margin: 0;
    font-size: 0.72rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: rgba(244, 241, 234, 0.5);
  }

  .cycle-hero-title {
    margin: 0.7rem 0 0;
    max-width: 12ch;
    font-size: clamp(2.8rem, 6.2vw, 5.8rem);
    line-height: 0.94;
    letter-spacing: -0.045em;
    color: rgba(244, 241, 234, 0.96);
  }

  .cycle-hero-intro {
    margin: 1.35rem 0 0;
    max-width: 42rem;
    color: rgba(244, 241, 234, 0.7);
    line-height: 1.72;
    font-size: 1rem;
  }

  .cycle-hero-keywords {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 1.4rem;
  }

  .cycle-hero-keyword {
    display: inline-flex;
    align-items: center;
    border: 1px solid rgba(255, 255, 255, 0.07);
    padding: 0.55rem 0.8rem;
    border-radius: 999px;
    font-size: 0.78rem;
    color: rgba(244, 241, 234, 0.74);
    background: rgba(255, 255, 255, 0.02);
  }

  .cycle-hero-meta {
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding-top: 1rem;
  }

  .cycle-hero-meta-title,
  .cycle-hero-meta-count {
    margin: 0.22rem 0 1rem;
    font-size: 1.08rem;
    color: rgba(244, 241, 234, 0.92);
  }

  .cycle-hero-meta-count {
    font-size: 2.1rem;
    letter-spacing: -0.04em;
  }

  @media (max-width: 900px) {
    .cycle-hero {
      grid-template-columns: 1fr;
      gap: 1.25rem;
      padding-top: 5rem;
    }

    .cycle-hero-title {
      max-width: none;
      font-size: clamp(2.4rem, 10vw, 4rem);
    }

    .cycle-hero-intro {
      max-width: none;
    }
  }
</style>
