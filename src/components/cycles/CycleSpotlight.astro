---
type Props = {
  title: string;
  year: number;
  statement: string;
  medium: string;
  dimensions: string;
  imageSrc: string | null;
  href: string;
};

const { title, year, statement, medium, dimensions, imageSrc, href } = Astro.props as Props;
---

<section class="cycle-spotlight">
  <div class="cycle-spotlight-media">
    {imageSrc ? (
      <>
        <img src={imageSrc} alt={`${title} spotlight artwork`} class="cycle-spotlight-image" loading="eager" decoding="async" />
        <div class="cycle-spotlight-frame"></div>
      </>
    ) : (
      <div class="cycle-spotlight-surface"></div>
    )}

    <div class="cycle-spotlight-label">spotlight manifestation</div>
  </div>

  <div class="cycle-spotlight-copy">
    <p class="cycle-spotlight-kicker">manifestation / {year}</p>
    <h2 class="cycle-spotlight-title">{title}</h2>
    <p class="cycle-spotlight-text">{statement}</p>

    <div class="cycle-spotlight-meta">
      <span>{medium}</span>
      <span>{dimensions}</span>
    </div>

    <div class="cycle-spotlight-actions">
      <a href={href} class="cycle-btn-primary">Open work</a>
      <a href="/works" class="cycle-btn-secondary">Open full archive</a>
    </div>
  </div>
</section>

<style>
  .cycle-spotlight {
    position: relative;
    z-index: 2;
    margin: 0 auto;
    max-width: 88rem;
    padding: 0 1.5rem 2rem;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(18rem, 0.45fr);
    gap: 1.2rem;
    align-items: start;
  }

  .cycle-spotlight-media {
    position: relative;
    overflow: hidden;
    background:
      linear-gradient(180deg, rgba(255,255,255,0.018), rgba(255,255,255,0.006));
  }

  .cycle-spotlight-image,
  .cycle-spotlight-surface {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: contain;
    object-position: center center;
  }

  .cycle-spotlight-frame {
    position: absolute;
    inset: 0.8rem;
    border: 1px solid rgba(255, 255, 255, 0.05);
    pointer-events: none;
  }

  .cycle-spotlight-label {
    position: absolute;
    left: 0.9rem;
    bottom: 0.9rem;
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(244, 241, 234, 0.68);
  }

  .cycle-spotlight-copy {
    border: 1px solid rgba(255,255,255,0.055);
    background: rgba(255,255,255,0.02);
    padding: 1.15rem 1.1rem;
  }

  .cycle-spotlight-kicker {
    margin: 0;
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(244, 241, 234, 0.5);
  }

  .cycle-spotlight-title {
    margin: 0.5rem 0 0;
    font-size: clamp(2rem, 4.4vw, 3.3rem);
    line-height: 0.95;
    letter-spacing: -0.04em;
  }

  .cycle-spotlight-text {
    margin: 1rem 0 0;
    color: rgba(244, 241, 234, 0.72);
    line-height: 1.7;
    font-size: 0.98rem;
  }

  .cycle-spotlight-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 1rem;
  }

  .cycle-spotlight-meta span {
    display: inline-flex;
    align-items: center;
    border: 1px solid rgba(255,255,255,0.06);
    padding: 0.52rem 0.78rem;
    border-radius: 999px;
    font-size: 0.76rem;
    color: rgba(244, 241, 234, 0.7);
  }

  .cycle-spotlight-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.35rem;
  }

  .cycle-btn-primary,
  .cycle-btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    padding: 0.82rem 1.15rem;
    font-size: 0.9rem;
    transition: transform 180ms ease, border-color 180ms ease, background 180ms ease;
  }

  .cycle-btn-primary {
    background: rgba(255,255,255,0.92);
    color: #0a0c10;
  }

  .cycle-btn-secondary {
    border: 1px solid rgba(255,255,255,0.08);
    background: rgba(255,255,255,0.03);
    color: rgba(244, 241, 234, 0.9);
  }

  .cycle-btn-primary:hover,
  .cycle-btn-secondary:hover {
    transform: translateY(-1px);
  }

  @media (max-width: 980px) {
    .cycle-spotlight {
      grid-template-columns: 1fr;
    }

    .cycle-spotlight-title {
      font-size: clamp(2rem, 9vw, 3rem);
    }
  }
</style>
