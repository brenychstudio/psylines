---
interface Props {
  mode?: "index" | "field";
}

const { mode = "index" } = Astro.props;
---

<div
  class="works-archive-illumination"
  data-works-archive-illumination
  data-works-archive-mode={mode}
  aria-hidden="true"
>
  <div class="works-archive-illumination__ambient"></div>
  <div class="works-archive-illumination__horizon"></div>
  <div class="works-archive-illumination__wash"></div>
  <div class="works-archive-illumination__rake"></div>
  <div class="works-archive-illumination__counterlight"></div>
  <div class="works-archive-illumination__canopy"></div>
  <div class="works-archive-illumination__vignette"></div>
  <div class="works-archive-illumination__register"></div>
</div>

<script>
  type Rgba = [number, number, number, number];
  type ArchivePalette = {
    tone: string;
    wash: Rgba;
    glow: Rgba;
    accent: Rgba;
    shadow: Rgba;
    density: number;
    pressure: number;
  };

  type ArchiveLightHost = HTMLElement & {
    __artistStageWorksArchiveLightState?: () => Record<string, unknown>;
  };

  const mountedArchiveLights = new WeakMap<HTMLElement, { destroy: () => void }>();
  const MEMORY_KEY = "artist-stage:works-archive-light-memory";
  const clamp = (value: number, min: number, max: number) => Math.min(max, Math.max(min, value));
  const damp = (current: number, target: number, delta: number, speed: number) =>
    current + (target - current) * (1 - Math.exp(-delta * speed));

  const ARCHIVE_TONES: Record<string, ArchivePalette> = {
    neutral: {
      tone: "neutral",
      wash: [126, 139, 119, 0.32],
      glow: [205, 214, 194, 0.2],
      accent: [235, 238, 224, 0.28],
      shadow: [18, 27, 21, 0.56],
      density: 0.54,
      pressure: 0.42,
    },
    moss: {
      tone: "moss",
      wash: [105, 153, 69, 0.4],
      glow: [172, 215, 104, 0.24],
      accent: [221, 214, 132, 0.3],
      shadow: [13, 38, 18, 0.6],
      density: 0.61,
      pressure: 0.5,
    },
    oxide: {
      tone: "oxide",
      wash: [166, 65, 48, 0.4],
      glow: [230, 127, 69, 0.24],
      accent: [240, 195, 111, 0.3],
      shadow: [50, 13, 10, 0.62],
      density: 0.66,
      pressure: 0.66,
    },
    amber: {
      tone: "amber",
      wash: [188, 116, 39, 0.42],
      glow: [239, 174, 68, 0.25],
      accent: [244, 218, 145, 0.31],
      shadow: [49, 28, 8, 0.61],
      density: 0.6,
      pressure: 0.56,
    },
    mineral: {
      tone: "mineral",
      wash: [68, 135, 137, 0.4],
      glow: [126, 204, 195, 0.24],
      accent: [199, 226, 207, 0.3],
      shadow: [7, 32, 32, 0.61],
      density: 0.58,
      pressure: 0.48,
    },
  };

  const cloneColor = (color: Rgba): Rgba => [...color] as Rgba;
  const clonePalette = (palette: ArchivePalette): ArchivePalette => ({
    tone: palette.tone,
    wash: cloneColor(palette.wash),
    glow: cloneColor(palette.glow),
    accent: cloneColor(palette.accent),
    shadow: cloneColor(palette.shadow),
    density: palette.density,
    pressure: palette.pressure,
  });

  const mixColor = (fallback: Rgba, profile: Rgba, profileWeight: number, alphaScale = 1): Rgba => [
    fallback[0] + (profile[0] - fallback[0]) * profileWeight,
    fallback[1] + (profile[1] - fallback[1]) * profileWeight,
    fallback[2] + (profile[2] - fallback[2]) * profileWeight,
    clamp(profile[3] * alphaScale, fallback[3] * 0.74, fallback[3] * 1.14),
  ];

  const parseColor = (value: string | undefined, fallback: Rgba): Rgba => {
    if (!value) return cloneColor(fallback);
    const match = value.match(/rgba?\(\s*([\d.]+)[,\s]+([\d.]+)[,\s]+([\d.]+)(?:\s*[,/]\s*([\d.]+))?\s*\)/i);
    if (!match) return cloneColor(fallback);

    return [
      clamp(Number(match[1]), 0, 255),
      clamp(Number(match[2]), 0, 255),
      clamp(Number(match[3]), 0, 255),
      clamp(match[4] === undefined ? 1 : Number(match[4]), 0, 1),
    ];
  };

  const colorToCss = (color: Rgba) =>
    `rgba(${Number(color[0].toFixed(2))}, ${Number(color[1].toFixed(2))}, ${Number(color[2].toFixed(2))}, ${color[3].toFixed(4)})`;

  const dampColor = (current: Rgba, target: Rgba, delta: number, speed: number) => {
    current[0] = damp(current[0], target[0], delta, speed);
    current[1] = damp(current[1], target[1], delta, speed);
    current[2] = damp(current[2], target[2], delta, speed);
    current[3] = damp(current[3], target[3], delta, speed);
  };

  const getEntryPalette = (entry: HTMLElement): ArchivePalette => {
    const toneName = entry.dataset.worksLightTone || "neutral";
    const fallback = clonePalette(ARCHIVE_TONES[toneName] || ARCHIVE_TONES.neutral);
    const hasAuthoredProfile = Boolean(entry.dataset.worksLightWash);
    if (!hasAuthoredProfile) return fallback;

    const profileWash = parseColor(entry.dataset.worksLightWash, fallback.wash);
    const profileGlow = parseColor(entry.dataset.worksLightGlow, fallback.glow);
    const profileAccent = parseColor(entry.dataset.worksLightAccent, fallback.accent);
    const profileShadow = parseColor(entry.dataset.worksLightShadow, fallback.shadow);

    return {
      tone: toneName,
      wash: mixColor(fallback.wash, profileWash, 0.82, 0.78),
      glow: mixColor(fallback.glow, profileGlow, 0.8, 0.9),
      accent: mixColor(fallback.accent, profileAccent, 0.76, 0.39),
      shadow: mixColor(fallback.shadow, profileShadow, 0.76, 0.94),
      density: clamp(Number(entry.dataset.worksLightDensity || fallback.density), 0.34, 0.82),
      pressure: clamp(Number(entry.dataset.worksLightPressure || fallback.pressure), 0.24, 0.86),
    };
  };

  const readStoredPalette = (): ArchivePalette | null => {
    try {
      const stored = JSON.parse(window.sessionStorage.getItem(MEMORY_KEY) || "null");
      const validColor = (value: unknown) =>
        Array.isArray(value) && value.length === 4 && value.every((channel) => Number.isFinite(Number(channel)));

      if (
        !stored ||
        !validColor(stored.wash) ||
        !validColor(stored.glow) ||
        !validColor(stored.accent) ||
        !validColor(stored.shadow)
      ) {
        return null;
      }

      return {
        tone: typeof stored.tone === "string" ? stored.tone : "neutral",
        wash: stored.wash.map(Number) as Rgba,
        glow: stored.glow.map(Number) as Rgba,
        accent: stored.accent.map(Number) as Rgba,
        shadow: stored.shadow.map(Number) as Rgba,
        density: clamp(Number(stored.density || 0.54), 0.34, 0.82),
        pressure: clamp(Number(stored.pressure || 0.42), 0.24, 0.86),
      };
    } catch {
      return null;
    }
  };

  const storePalette = (palette: ArchivePalette) => {
    try {
      window.sessionStorage.setItem(MEMORY_KEY, JSON.stringify(palette));
    } catch {
      // Atmosphere memory is an enhancement; the archive remains fully functional without storage.
    }
  };

  function mountArchiveLight(host: ArchiveLightHost) {
    if (mountedArchiveLights.has(host)) return;

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const mode = host.dataset.worksArchiveMode === "field" ? "field" : "index";
    const baseIntensity = mode === "field" ? 0.92 : 0.76;
    const activeIntensity = mode === "field" ? 1.08 : 0.96;
    const storedPalette = readStoredPalette();
    let targetPalette = clonePalette(storedPalette || ARCHIVE_TONES.neutral);
    let currentPalette = clonePalette(targetPalette);
    let targetX = mode === "field" ? 55 : 52;
    let currentX = targetX;
    let targetY = mode === "field" ? 48 : 42;
    let currentY = targetY;
    let targetIntensity = baseIntensity;
    let currentIntensity = targetIntensity;
    let currentDensity = targetPalette.density;
    let currentPressure = targetPalette.pressure;
    let presenceLift = 0;
    let activeEntry: HTMLElement | null = null;
    let memoryUntil = storedPalette ? performance.now() + 2400 : 0;
    let releaseTimer = 0;
    let scrollRaf = 0;
    let raf = 0;
    let lastFrame = 0;
    let lastDomUpdate = 0;
    let lastDomSignature = "";
    let renderSettled = false;
    let lastScrollY = window.scrollY;
    let destroyed = false;
    let observer: IntersectionObserver | null = null;
    const visibleEntries = new Map<HTMLElement, number>();

    document.documentElement.dataset.worksArchiveLighting = mode;

    const applyPalette = (palette: ArchivePalette) => {
      host.style.setProperty("--works-archive-wash", colorToCss(palette.wash));
      host.style.setProperty("--works-archive-glow", colorToCss(palette.glow));
      host.style.setProperty("--works-archive-accent", colorToCss(palette.accent));
      host.style.setProperty("--works-archive-shadow", colorToCss(palette.shadow));
    };

    const findEntry = (target: EventTarget | null) =>
      target instanceof Element ? target.closest<HTMLElement>("[data-works-light-tone]") : null;

    const updateIntensityTarget = (isActive = Boolean(activeEntry)) => {
      const paletteLift = (targetPalette.density - 0.5) * 0.13 + (targetPalette.pressure - 0.42) * 0.045;
      targetIntensity = clamp((isActive ? activeIntensity : baseIntensity) + paletteLift + presenceLift, 0.68, 1.18);
      renderSettled = false;
    };

    const setPaletteTarget = (entry: HTMLElement) => {
      targetPalette = getEntryPalette(entry);
      host.dataset.worksArchiveTone = targetPalette.tone;
      storePalette(targetPalette);
      updateIntensityTarget();
    };

    const setSpatialTarget = (entry: HTMLElement) => {
      const rect = entry.getBoundingClientRect();
      const headerHeight = parseFloat(getComputedStyle(document.documentElement).getPropertyValue("--site-header-height")) || 0;
      const usableHeight = Math.max(window.innerHeight - headerHeight, 1);
      const centerX = rect.left + rect.width * 0.5;
      const centerY = rect.top + rect.height * 0.46 - headerHeight;
      targetX = clamp((centerX / Math.max(window.innerWidth, 1)) * 100, 15, 85);
      targetY = clamp((centerY / usableHeight) * 100, 20, 78);
    };

    const setEntryTarget = (entry: HTMLElement, source: "pointer" | "focus" | "touch" | "viewport") => {
      window.clearTimeout(releaseTimer);
      setSpatialTarget(entry);
      setPaletteTarget(entry);

      if (source !== "viewport") {
        activeEntry = entry;
        memoryUntil = performance.now() + 6400;
        host.dataset.worksArchiveActive = entry.dataset.workSlug || entry.dataset.artworkSlug || "active";
        updateIntensityTarget(true);
      } else {
        host.dataset.worksArchiveVisible = entry.dataset.workSlug || entry.dataset.artworkSlug || "visible";
        updateIntensityTarget(false);
      }
    };

    const getViewportScore = (entry: HTMLElement, ratio: number) => {
      const rect = entry.getBoundingClientRect();
      const centerY = rect.top + rect.height * 0.5;
      const centerDistance = Math.min(Math.abs(centerY - window.innerHeight * 0.52) / Math.max(window.innerHeight * 0.72, 1), 1);
      const visibleCenter = 1 - centerDistance;
      return ratio * 0.68 + visibleCenter * 0.32;
    };

    const pickVisibleEntry = () => {
      let bestEntry: HTMLElement | null = null;
      let bestScore = -1;

      visibleEntries.forEach((ratio, entry) => {
        if (!entry.isConnected || ratio <= 0) return;
        const score = getViewportScore(entry, ratio);
        if (score > bestScore) {
          bestEntry = entry;
          bestScore = score;
        }
      });

      return bestEntry;
    };

    const updateVisibleTarget = (force = false) => {
      if (activeEntry && !force) return;
      if (!force && performance.now() < memoryUntil) return;
      const visibleEntry = pickVisibleEntry();
      if (visibleEntry) setEntryTarget(visibleEntry, "viewport");
    };

    const releaseActiveEntry = (entry: HTMLElement | null) => {
      if (!entry || activeEntry !== entry) return;
      activeEntry = null;
      delete host.dataset.worksArchiveActive;
      memoryUntil = performance.now() + 6400;
      updateIntensityTarget(false);
      window.clearTimeout(releaseTimer);
      releaseTimer = window.setTimeout(() => updateVisibleTarget(true), 6500);
    };

    const handlePointerOver = (event: PointerEvent) => {
      const entry = findEntry(event.target);
      if (!entry || entry === activeEntry) return;
      setEntryTarget(entry, event.pointerType === "touch" ? "touch" : "pointer");
    };

    const handlePointerOut = (event: PointerEvent) => {
      const entry = findEntry(event.target);
      if (!entry) return;
      if (event.relatedTarget instanceof Node && entry.contains(event.relatedTarget)) return;
      if (findEntry(event.relatedTarget)) return;
      releaseActiveEntry(entry);
    };

    const handlePointerDown = (event: PointerEvent) => {
      if (event.pointerType !== "touch") return;
      const entry = findEntry(event.target);
      if (entry) setEntryTarget(entry, "touch");
    };

    const handleFocusIn = (event: FocusEvent) => {
      const entry = findEntry(event.target);
      if (entry) setEntryTarget(entry, "focus");
    };

    const handleFocusOut = (event: FocusEvent) => {
      const entry = findEntry(event.target);
      if (!entry) return;
      if (event.relatedTarget instanceof Node && entry.contains(event.relatedTarget)) return;
      releaseActiveEntry(entry);
    };

    const handlePresence = (event: Event) => {
      const phase = (event as CustomEvent<{ phase?: string }>).detail?.phase || "awake";
      presenceLift =
        phase === "dreaming" ? 0.09 :
        phase === "settling" ? 0.045 :
        phase === "gathering" ? 0.055 :
        phase === "reforming" ? 0.035 : 0;
      updateIntensityTarget();
    };

    const handleDreamCycle = (event: Event) => {
      if ((document.documentElement.dataset.presencePhase || "awake") !== "dreaming") return;
      const cycle = (event as CustomEvent<{ cycle?: string }>).detail?.cycle || "gathering";
      const direction =
        cycle === "dispersing" ? [2.8, 1.4, 0.105] :
        cycle === "reforming" ? [-1.2, -0.6, 0.075] :
        [-1.6, -0.8, 0.095];
      targetX = clamp(targetX + direction[0], 15, 85);
      targetY = clamp(targetY + direction[1], 20, 78);
      presenceLift = direction[2];
      updateIntensityTarget();
    };

    const handleScroll = () => {
      if (scrollRaf) return;
      scrollRaf = window.requestAnimationFrame(() => {
        scrollRaf = 0;
        const nextScrollY = window.scrollY;
        const moved = Math.abs(nextScrollY - lastScrollY);
        lastScrollY = nextScrollY;
        if (moved < 12) return;

        const focusedEntry = findEntry(document.activeElement);
        if (!focusedEntry) {
          activeEntry = null;
          delete host.dataset.worksArchiveActive;
          memoryUntil = 0;
          updateVisibleTarget(true);
        }
      });
    };

    const refreshVisibleGeometry = () => {
      document.querySelectorAll<HTMLElement>("[data-works-light-tone]").forEach((entry) => {
        const rect = entry.getBoundingClientRect();
        const visibleWidth = Math.max(0, Math.min(rect.right, window.innerWidth) - Math.max(rect.left, 0));
        const visibleHeight = Math.max(0, Math.min(rect.bottom, window.innerHeight) - Math.max(rect.top, 0));
        const ratio = (visibleWidth * visibleHeight) / Math.max(rect.width * rect.height, 1);
        if (ratio > 0) visibleEntries.set(entry, ratio);
        else visibleEntries.delete(entry);
      });
      updateVisibleTarget(true);
    };

    const initObserver = () => {
      const entries = document.querySelectorAll<HTMLElement>("[data-works-light-tone]");
      if (!("IntersectionObserver" in window)) {
        refreshVisibleGeometry();
        return;
      }

      observer = new IntersectionObserver(
        (changes) => {
          changes.forEach((change) => {
            const entry = change.target as HTMLElement;
            if (change.isIntersecting) visibleEntries.set(entry, change.intersectionRatio);
            else visibleEntries.delete(entry);
          });
          updateVisibleTarget();
        },
        {
          rootMargin: "-7% 0px -12% 0px",
          threshold: [0, 0.12, 0.25, 0.4, 0.6, 0.8, 1],
        },
      );

      entries.forEach((entry) => observer?.observe(entry));
      window.requestAnimationFrame(refreshVisibleGeometry);
    };

    const destroy = () => {
      if (destroyed) return;
      destroyed = true;
      window.cancelAnimationFrame(raf);
      window.cancelAnimationFrame(scrollRaf);
      window.clearTimeout(releaseTimer);
      observer?.disconnect();
      document.removeEventListener("pointerover", handlePointerOver);
      document.removeEventListener("pointerout", handlePointerOut);
      document.removeEventListener("pointerdown", handlePointerDown);
      document.removeEventListener("focusin", handleFocusIn);
      document.removeEventListener("focusout", handleFocusOut);
      window.removeEventListener("scroll", handleScroll);
      window.removeEventListener("resize", refreshVisibleGeometry);
      window.removeEventListener("artist-stage:presence-phase", handlePresence);
      window.removeEventListener("artist-stage:presence-dream-cycle", handleDreamCycle);
      window.removeEventListener("pagehide", destroy);
      document.removeEventListener("astro:before-swap", destroy);
      reducedMotion.removeEventListener?.("change", refreshVisibleGeometry);
      if (document.documentElement.dataset.worksArchiveLighting === mode) {
        delete document.documentElement.dataset.worksArchiveLighting;
      }
      delete host.__artistStageWorksArchiveLightState;
      mountedArchiveLights.delete(host);
    };

    const render = (now: number) => {
      if (destroyed) return;
      if (!host.isConnected) {
        destroy();
        return;
      }

      raf = window.requestAnimationFrame(render);
      const delta = lastFrame ? clamp((now - lastFrame) * 0.001, 0.001, 0.08) : 0.016;
      lastFrame = now;
      const immediateSpeed = reducedMotion.matches ? 16 : 3.4;
      const colorSpeed = reducedMotion.matches ? 16 : 2.8;
      if (!renderSettled) {
        currentX = damp(currentX, targetX, delta, immediateSpeed);
        currentY = damp(currentY, targetY, delta, immediateSpeed * 0.86);
        currentIntensity = damp(currentIntensity, targetIntensity, delta, reducedMotion.matches ? 16 : 2.7);
        currentDensity = damp(currentDensity, targetPalette.density, delta, colorSpeed);
        currentPressure = damp(currentPressure, targetPalette.pressure, delta, colorSpeed);
        dampColor(currentPalette.wash, targetPalette.wash, delta, colorSpeed);
        dampColor(currentPalette.glow, targetPalette.glow, delta, colorSpeed);
        dampColor(currentPalette.accent, targetPalette.accent, delta, colorSpeed);
        dampColor(currentPalette.shadow, targetPalette.shadow, delta, colorSpeed);
      }

      const colorNear = (current: Rgba, target: Rgba) =>
        Math.abs(current[0] - target[0]) < 0.35 &&
        Math.abs(current[1] - target[1]) < 0.35 &&
        Math.abs(current[2] - target[2]) < 0.35 &&
        Math.abs(current[3] - target[3]) < 0.0015;
      const settled =
        Math.abs(currentX - targetX) < 0.04 &&
        Math.abs(currentY - targetY) < 0.04 &&
        Math.abs(currentIntensity - targetIntensity) < 0.0015 &&
        Math.abs(currentDensity - targetPalette.density) < 0.0015 &&
        Math.abs(currentPressure - targetPalette.pressure) < 0.0015 &&
        colorNear(currentPalette.wash, targetPalette.wash) &&
        colorNear(currentPalette.glow, targetPalette.glow) &&
        colorNear(currentPalette.accent, targetPalette.accent) &&
        colorNear(currentPalette.shadow, targetPalette.shadow);

      if (!renderSettled && settled) {
        currentX = targetX;
        currentY = targetY;
        currentIntensity = targetIntensity;
        currentDensity = targetPalette.density;
        currentPressure = targetPalette.pressure;
        currentPalette = clonePalette(targetPalette);
        renderSettled = true;
      }

      const renderX = clamp(currentX, 14, 86);
      const renderY = clamp(currentY, 18, 80);
      const washOpacity = clamp(0.4375 + currentIntensity * 0.34 + currentDensity * 0.13, 0.66, 0.96);
      const rakeOpacity = clamp(0.2175 + currentIntensity * 0.31 + currentPressure * 0.11, 0.47, 0.78);
      const horizonOpacity = clamp(0.23 + currentIntensity * 0.24 + currentDensity * 0.08, 0.43, 0.66);
      const canopyOpacity = clamp(0.215 + currentIntensity * 0.21, 0.36, 0.54);

      const washCss = colorToCss(currentPalette.wash);
      const glowCss = colorToCss(currentPalette.glow);
      const accentCss = colorToCss(currentPalette.accent);
      const shadowCss = colorToCss(currentPalette.shadow);
      const domSignature = [
        renderX.toFixed(2),
        renderY.toFixed(2),
        washOpacity.toFixed(3),
        rakeOpacity.toFixed(3),
        horizonOpacity.toFixed(3),
        canopyOpacity.toFixed(3),
        washCss,
        glowCss,
        accentCss,
        shadowCss,
      ].join("|");
      const domInterval = window.innerWidth <= 760 ? 40 : 1000 / 30;
      if (!lastDomUpdate || now - lastDomUpdate >= domInterval) {
        lastDomUpdate = now;
        if (domSignature !== lastDomSignature) {
          lastDomSignature = domSignature;
          host.style.cssText = [
            `--works-archive-anchor-x:${renderX.toFixed(2)}%`,
            `--works-archive-anchor-y:${renderY.toFixed(2)}%`,
            `--works-archive-counter-x:${(100 - renderX * 0.62).toFixed(2)}%`,
            `--works-archive-rake-shift:${((renderX - 50) * 0.42).toFixed(2)}vw`,
            `--works-archive-wash-opacity:${washOpacity.toFixed(3)}`,
            `--works-archive-rake-opacity:${rakeOpacity.toFixed(3)}`,
            `--works-archive-horizon-opacity:${horizonOpacity.toFixed(3)}`,
            `--works-archive-canopy-opacity:${canopyOpacity.toFixed(3)}`,
            `--works-archive-wash:${washCss}`,
            `--works-archive-glow:${glowCss}`,
            `--works-archive-accent:${accentCss}`,
            `--works-archive-shadow:${shadowCss}`,
          ].join(";");
        }
      }
    };

    applyPalette(currentPalette);
    host.dataset.worksArchiveTone = currentPalette.tone;
    document.addEventListener("pointerover", handlePointerOver, { passive: true });
    document.addEventListener("pointerout", handlePointerOut, { passive: true });
    document.addEventListener("pointerdown", handlePointerDown, { passive: true });
    document.addEventListener("focusin", handleFocusIn);
    document.addEventListener("focusout", handleFocusOut);
    window.addEventListener("scroll", handleScroll, { passive: true });
    window.addEventListener("resize", refreshVisibleGeometry, { passive: true });
    window.addEventListener("artist-stage:presence-phase", handlePresence);
    window.addEventListener("artist-stage:presence-dream-cycle", handleDreamCycle);
    document.addEventListener("astro:before-swap", destroy, { once: true });
    window.addEventListener("pagehide", destroy, { once: true });
    reducedMotion.addEventListener?.("change", refreshVisibleGeometry);
    initObserver();
    raf = window.requestAnimationFrame(render);

    host.__artistStageWorksArchiveLightState = () => ({
      mode,
      activeSlug: activeEntry?.dataset.workSlug || activeEntry?.dataset.artworkSlug || "",
      visibleSlug: host.dataset.worksArchiveVisible || "",
      tone: host.dataset.worksArchiveTone || "neutral",
      position: [currentX, currentY],
      targetPosition: [targetX, targetY],
      intensity: currentIntensity,
      targetIntensity,
      settled: renderSettled,
      reducedMotion: reducedMotion.matches,
    });
    mountedArchiveLights.set(host, { destroy });
  }

  function mountAllArchiveLights() {
    document
      .querySelectorAll<ArchiveLightHost>("[data-works-archive-illumination]")
      .forEach((host) => mountArchiveLight(host));
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", mountAllArchiveLights, { once: true });
  } else {
    mountAllArchiveLights();
  }

  document.addEventListener("astro:page-load", mountAllArchiveLights);
</script>

<style>
  .works-archive-illumination {
    --works-archive-anchor-x: 52%;
    --works-archive-anchor-y: 42%;
    --works-archive-counter-x: 67.76%;
    --works-archive-rake-shift: 0vw;
    --works-archive-wash-opacity: 0.78;
    --works-archive-rake-opacity: 0.57;
    --works-archive-horizon-opacity: 0.5;
    --works-archive-canopy-opacity: 0.43;
    --works-archive-wash: rgba(126, 139, 119, 0.32);
