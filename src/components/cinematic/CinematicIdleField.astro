<script is:inline>
  (() => {
    if (window.__artistStageCinematicIdleInstalled) return;
    window.__artistStageCinematicIdleInstalled = true;

    const rootSelector = "[data-cinematic-idle-root]";
    const targetSelector = "[data-cinematic-idle]";
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const controllers = new Set();

    const roleWeight = {
      anchor: 0,
      presence: 1,
      image: 1,
      field: 1,
      voice: 3,
      line: 4,
      detail: 5,
      trace: 6,
      contact: 1,
      action: 2,
    };

    const clamp = (value, min, max) => Math.min(max, Math.max(min, value));
    const phaseToPresence = {
      awake: "active",
      settling: "settling",
      idle: "still",
      dreaming: "deep",
      waking: "active",
    };
    const dreamCycles = ["gathering", "dispersing", "reforming"];
    const dreamCycleDurations = [11800, 15200, 12600];

    const toPublicPhase = (state) => state === "idle" ? "contemplating" : state;

    const getRouteKind = () => document.documentElement.dataset.presenceRoute || "generic";

    const isVisibleCandidate = (element) => {
      const rect = element.getBoundingClientRect();
      const style = window.getComputedStyle(element);

      return (
        rect.width > 2 &&
        rect.height > 2 &&
        rect.bottom > 0 &&
        rect.top < window.innerHeight &&
        rect.right > 0 &&
        rect.left < window.innerWidth &&
        style.display !== "none" &&
        style.visibility !== "hidden"
      );
    };

    const prepareAutomaticTargets = (root) => {
      if (root.querySelector(targetSelector)) return;

      root.querySelectorAll("h1, h2").forEach((element) => {
        element.dataset.cinematicIdle = "anchor";
      });

      root.querySelectorAll("p").forEach((element) => {
        if (element.closest("nav, footer, button, [role='dialog']")) return;
        if ((element.textContent || "").trim().length < 28) return;
        element.dataset.cinematicIdle = "voice";
      });

      root.querySelectorAll("figure, picture").forEach((element, index) => {
        element.dataset.cinematicIdle = index === 0 ? "image" : "trace";
      });
    };

    const pickClosestToViewport = (elements, focusX = window.innerWidth * 0.52, focusY = window.innerHeight * 0.48) => {
      return elements
        .filter(isVisibleCandidate)
        .map((element) => {
          const rect = element.getBoundingClientRect();
          const centerX = rect.left + rect.width * 0.5;
          const centerY = rect.top + rect.height * 0.5;
          const distance = Math.hypot(
            (centerX - focusX) / Math.max(window.innerWidth, 1),
            (centerY - focusY) / Math.max(window.innerHeight, 1),
          );
          const areaBoost = Math.min((rect.width * rect.height) / Math.max(window.innerWidth * window.innerHeight, 1), 0.28);

          return { element, score: distance - areaBoost * 0.42 };
        })
        .sort((a, b) => a.score - b.score)[0]?.element || null;
    };

    const prepareMetamorphosis = (root) => {
      root.querySelectorAll("[data-presence-focus], [data-presence-anchor], [data-presence-echo], [data-presence-subject]")
        .forEach((element) => {
          delete element.dataset.presenceFocus;
          delete element.dataset.presenceAnchor;
          delete element.dataset.presenceEcho;
          delete element.dataset.presenceSubject;
          element.style.removeProperty("--presence-echo-order");
        });

      const route = getRouteKind();
      const explicitFocusSelectors = {
        home: "[data-home-active-image]",
        series: "[data-series-node].is-active [data-cinematic-idle='image']",
        "series-detail": "[data-series-inspector-image], [data-cinematic-idle='image']",
        "work-detail": "[data-object-artwork-stage] [data-cinematic-idle='image'], [data-object-physical-plane]",
        contact: "[data-cinematic-idle='contact']",
      };
      const mediaCandidates = Array.from(root.querySelectorAll(
        "[data-cinematic-idle='image'], [data-cinematic-idle='presence'], [data-cinematic-idle='trace'], [data-artwork-slug] img",
      ));
      const explicitFocus = explicitFocusSelectors[route]
        ? root.querySelector(explicitFocusSelectors[route])
        : null;
      const focus = explicitFocus && isVisibleCandidate(explicitFocus)
        ? explicitFocus
        : pickClosestToViewport(mediaCandidates);
      const anchor = pickClosestToViewport(Array.from(root.querySelectorAll("[data-cinematic-idle='anchor']")));

      if (focus) {
        focus.dataset.presenceFocus = "true";
        const subject =
          focus.closest("[data-artwork-slug]") ||
          focus.closest("figure, section") ||
          focus;
        subject.dataset.presenceSubject = "true";

        const rect = focus.getBoundingClientRect();
        const focusX = clamp((rect.left + rect.width * 0.5) / Math.max(window.innerWidth, 1), 0.04, 0.96);
        const focusY = clamp((rect.top + rect.height * 0.5) / Math.max(window.innerHeight, 1), 0.06, 0.94);
        root.style.setProperty("--presence-focus-x", `${(focusX * 100).toFixed(2)}%`);
        root.style.setProperty("--presence-focus-y", `${(focusY * 100).toFixed(2)}%`);

        mediaCandidates
          .filter((element) => element !== focus && isVisibleCandidate(element))
          .slice(0, 3)
          .forEach((element, index) => {
            element.dataset.presenceEcho = "true";
            element.style.setProperty("--presence-echo-order", String(index));
          });
      } else {
        root.style.setProperty("--presence-focus-x", "54%");
        root.style.setProperty("--presence-focus-y", "46%");
      }

      if (anchor) {
        anchor.dataset.presenceAnchor = "true";
        const phrase = root.querySelector(":scope > .cinematic-presence-phrase");
        if (phrase) phrase.textContent = (anchor.textContent || "").trim();
      }
    };

    const prepareTextDispersal = (root) => {
      const field = root.querySelector(":scope > .cinematic-presence-dispersal-field");
      if (!field) return;

      field.replaceChildren();
      root.querySelectorAll("[data-presence-dispersal-source]").forEach((element) => {
        delete element.dataset.presenceDispersalSource;
      });

      const candidates = Array.from(root.querySelectorAll(
        "[data-cinematic-idle='voice'], [data-cinematic-idle='line'], [data-cinematic-idle='detail']",
      ))
        .filter((element) => {
          if (!isVisibleCandidate(element)) return false;
          if (element.matches("[data-presence-anchor='true']")) return false;
          if (element.closest("nav, footer, button, [role='dialog'], [aria-hidden='true']")) return false;
          const text = (element.innerText || element.textContent || "").replace(/\s+/g, " ").trim();
          return text.length >= 24 && text.length <= 280;
        })
        .sort((a, b) => {
          const aRect = a.getBoundingClientRect();
          const bRect = b.getBoundingClientRect();
          const viewportCenter = window.innerHeight * 0.48;
          const aDistance = Math.abs(aRect.top + aRect.height * 0.5 - viewportCenter);
          const bDistance = Math.abs(bRect.top + bRect.height * 0.5 - viewportCenter);
          return aDistance - bDistance;
        });

      const selected = [];
      for (const candidate of candidates) {
        if (selected.some((element) => element.contains(candidate) || candidate.contains(element))) continue;
        selected.push(candidate);
        if (selected.length === (window.innerWidth < 700 ? 1 : 2)) break;
      }

      selected.forEach((element, traceIndex) => {
        const rect = element.getBoundingClientRect();
        const computed = window.getComputedStyle(element);
        const text = (element.innerText || element.textContent || "").replace(/\s+/g, " ").trim();
        const words = text.split(" ").slice(0, 42);
        const trace = document.createElement("span");

        element.dataset.presenceDispersalSource = "true";
        trace.className = "cinematic-presence-text-trace";
        trace.style.left = `${clamp(rect.left, 0, window.innerWidth)}px`;
        trace.style.top = `${clamp(rect.top, 0, window.innerHeight)}px`;
        trace.style.width = `${Math.min(rect.width, window.innerWidth - clamp(rect.left, 0, window.innerWidth))}px`;
        trace.style.minHeight = `${Math.min(rect.height, window.innerHeight)}px`;
        trace.style.fontFamily = computed.fontFamily;
        trace.style.fontSize = computed.fontSize;
        trace.style.fontWeight = computed.fontWeight;
        trace.style.fontStyle = computed.fontStyle;
        trace.style.lineHeight = computed.lineHeight;
        trace.style.textAlign = computed.textAlign;
        trace.style.textTransform = computed.textTransform;
        trace.style.setProperty("--presence-trace-order", String(traceIndex));

        words.forEach((wordText, wordIndex) => {
          const word = document.createElement("span");
          const hash = hashElement(element, wordIndex + traceIndex * 47);
          const direction = hash % 2 === 0 ? 1 : -1;
          const spreadX = direction * (10 + (hash % 58));
          const spreadY = ((hash >> 3) % 49) - 24;

          word.className = "cinematic-presence-word";
          word.textContent = wordText;
          word.style.setProperty("--presence-word-x", `${spreadX}px`);
          word.style.setProperty("--presence-word-y", `${spreadY}px`);
          word.style.setProperty("--presence-word-delay", `${(hash % 1100) + wordIndex * 34}ms`);
          trace.append(word);
        });

        field.append(trace);
      });
    };

    const announcePhase = (root, state, source, origin) => {
      const phase = toPublicPhase(state);
      const html = document.documentElement;
      const point = origin || { x: window.innerWidth * 0.5, y: window.innerHeight * 0.48 };
      const normalizedX = clamp(point.x / Math.max(window.innerWidth, 1), 0, 1);
      const normalizedY = clamp(point.y / Math.max(window.innerHeight, 1), 0, 1);

      html.dataset.presenceDirector = "active";
      html.dataset.presencePhase = phase;
      html.style.setProperty("--presence-wake-x", `${(normalizedX * 100).toFixed(2)}%`);
      html.style.setProperty("--presence-wake-y", `${(normalizedY * 100).toFixed(2)}%`);

      const detail = {
        phase,
        legacyState: state,
        presenceId: phaseToPresence[state] || "active",
        source: source || "presence-director",
        route: getRouteKind(),
        x: normalizedX,
        y: normalizedY,
      };

      window.__artistStagePresencePhase = detail;
      window.dispatchEvent(new CustomEvent("artist-stage:presence-phase", { detail }));
    };

    const setRootState = (root, state, source, origin) => {
      root.dataset.cinematicIdleState = state;
      announcePhase(root, state, source, origin);
    };

    const hashElement = (element, index) => {
      const source = `${element.textContent || element.getAttribute("aria-label") || ""}:${index}`;
      let hash = 0;

      for (let i = 0; i < source.length; i += 1) {
        hash = (hash << 5) - hash + source.charCodeAt(i);
        hash |= 0;
      }

      return Math.abs(hash);
    };

    const prepareWave = (root, origin) => {
      const targets = Array.from(root.querySelectorAll(targetSelector)).filter((element) => {
        return !element.closest("[hidden], [aria-hidden='true']");
      });
      const viewportWidth = Math.max(window.innerWidth || 1, 1);
      const viewportHeight = Math.max(window.innerHeight || 1, 1);
      const focusX = origin?.x ?? viewportWidth * 0.52;
      const focusY = origin?.y ?? viewportHeight * 0.46;
      const total = Math.max(targets.length - 1, 1);

      targets.forEach((element, index) => {
        const rect = element.getBoundingClientRect();
        const centerX = rect.left + rect.width * 0.5;
        const centerY = rect.top + rect.height * 0.5;
        const distance = clamp(Math.hypot((centerX - focusX) / viewportWidth, (centerY - focusY) / viewportHeight), 0, 1.4);
        const role = element.getAttribute("data-cinematic-idle") || "voice";
        const weight = roleWeight[role] ?? roleWeight.voice;
        const manualOrder = Number(element.getAttribute("data-cinematic-idle-order"));
        const order = Number.isFinite(manualOrder) ? manualOrder : index / total;
        const hash = hashElement(element, index);
        const jitter = hash % 120;
        const driftY = clamp((centerY - focusY) / viewportHeight, -0.8, 0.8) * 0.72;
        const driftX = clamp((centerX - focusX) / viewportWidth, -0.8, 0.8) * 0.54 + ((hash % 18) - 9) / 100;
        const enterDelay = Math.round(distance * 820 + weight * 96 + order * 620 + jitter);
        const wakeDelay = Math.round((1.15 - clamp(distance, 0, 1.15)) * 320 + (1 - order) * 360 + (hash % 140));

        element.style.setProperty("--cinematic-idle-enter-delay", `${enterDelay}ms`);
        element.style.setProperty("--cinematic-idle-wake-delay", `${wakeDelay}ms`);
        element.style.setProperty("--cinematic-idle-x", `${driftX.toFixed(3)}rem`);
        element.style.setProperty("--cinematic-idle-y", `${driftY.toFixed(3)}rem`);
      });
    };

    const ensureVeil = (root) => {
      if (!root.querySelector(":scope > .cinematic-idle-veil")) {
        const veil = document.createElement("span");
        veil.className = "cinematic-idle-veil";
        veil.setAttribute("aria-hidden", "true");
        root.prepend(veil);
      }

      if (!root.querySelector(":scope > .cinematic-presence-layer")) {
        const layer = document.createElement("span");
        layer.className = "cinematic-presence-layer";
        layer.setAttribute("aria-hidden", "true");
        root.prepend(layer);
      }

      if (!root.querySelector(":scope > .cinematic-presence-phrase")) {
        const phrase = document.createElement("span");
        phrase.className = "cinematic-presence-phrase";
        phrase.setAttribute("aria-hidden", "true");
        root.prepend(phrase);
      }

      if (!root.querySelector(":scope > .cinematic-presence-dispersal-field")) {
        const dispersalField = document.createElement("span");
        dispersalField.className = "cinematic-presence-dispersal-field";
        dispersalField.setAttribute("aria-hidden", "true");
        root.prepend(dispersalField);
      }
    };

    const createController = (root) => {
      if (root.__artistStageCinematicIdleController) return root.__artistStageCinematicIdleController;
      if (root.closest?.("astro-island[ssr]")) return null;

      prepareAutomaticTargets(root);
      ensureVeil(root);
      setRootState(root, "awake", "init");

      let timer = 0;
      let settleTimer = 0;
      let dreamTimer = 0;
      let dreamCycleTimer = 0;
      let wakeTimer = 0;
      let dreamCycleIndex = 0;
      const idleDelay = Number(root.dataset.cinematicIdleDelay) || 5600;
      const reducedDelay = Number(root.dataset.cinematicIdleReducedDelay) || Math.max(idleDelay, 9000);
      const wakeDuration = Number(root.dataset.cinematicIdleWakeDuration) || 3200;
      const settleDuration = Number(root.dataset.cinematicIdleSettleDuration) || 2600;
      const dreamDuration = Number(root.dataset.cinematicIdleDreamDuration) || 6400;

      const clearStageTimers = () => {
        window.clearTimeout(settleTimer);
        window.clearTimeout(dreamTimer);
        window.clearTimeout(dreamCycleTimer);
      };

      const clearDreamCycle = () => {
        window.clearTimeout(dreamCycleTimer);
        dreamCycleIndex = 0;
        delete root.dataset.cinematicDreamCycle;
        delete document.documentElement.dataset.presenceDreamCycle;
      };

      const runDreamCycle = () => {
        if (root.dataset.cinematicIdleState !== "dreaming") return;

        const cycle = dreamCycles[dreamCycleIndex];
        const detail = {
          cycle,
          index: dreamCycleIndex,
          route: getRouteKind(),
          source: "presence-director",
        };

        root.dataset.cinematicDreamCycle = cycle;
        document.documentElement.dataset.presenceDreamCycle = cycle;
        window.__artistStagePresenceDreamCycle = detail;
        window.dispatchEvent(new CustomEvent("artist-stage:presence-dream-cycle", { detail }));

        if (reducedMotion.matches) return;
        const duration = dreamCycleDurations[dreamCycleIndex];
        dreamCycleTimer = window.setTimeout(() => {
          dreamCycleIndex = (dreamCycleIndex + 1) % dreamCycles.length;
          runDreamCycle();
        }, duration);
      };

      const enter = () => {
        if (document.hidden) return;
        if (root.matches(":focus-within")) {
          timer = window.setTimeout(enter, 1200);
          return;
        }
        prepareMetamorphosis(root);
        prepareTextDispersal(root);
        prepareWave(root);
        clearDreamCycle();
        setRootState(root, "settling", "stillness");
        clearStageTimers();
        settleTimer = window.setTimeout(() => {
          if (root.dataset.cinematicIdleState === "settling") {
            setRootState(root, "idle", "stillness");
          }
        }, reducedMotion.matches ? 1 : settleDuration);
        dreamTimer = window.setTimeout(() => {
          if (root.dataset.cinematicIdleState === "idle") {
            setRootState(root, "dreaming", "deep-stillness");
            runDreamCycle();
          }
        }, reducedMotion.matches ? 1 : dreamDuration);
      };

      const schedule = () => {
        window.clearTimeout(timer);
        clearStageTimers();
        clearDreamCycle();
        timer = window.setTimeout(enter, reducedMotion.matches ? reducedDelay : idleDelay);
      };

      const wake = (origin) => {
        const wasContemplating =
          root.dataset.cinematicIdleState === "settling" ||
          root.dataset.cinematicIdleState === "idle" ||
          root.dataset.cinematicIdleState === "dreaming" ||
          root.dataset.cinematicIdleState === "waking";

        if (wasContemplating) {
          prepareWave(root, origin);
          clearStageTimers();
          clearDreamCycle();
          setRootState(root, "waking", "activity", origin);
          window.clearTimeout(wakeTimer);
          wakeTimer = window.setTimeout(() => {
            if (root.dataset.cinematicIdleState === "waking") {
              setRootState(root, "awake", "wake-complete", origin);
            }
          }, reducedMotion.matches ? 160 : wakeDuration);
        } else {
          setRootState(root, "awake", "activity", origin);
        }

        schedule();
      };

      const controller = { root, schedule, wake };
      root.__artistStageCinematicIdleController = controller;
      controllers.add(controller);
      schedule();

      return controller;
    };

    const initRoots = (scope = document) => {
      if (scope instanceof Element && scope.matches(rootSelector)) {
        createController(scope);
      }

      scope.querySelectorAll?.(rootSelector).forEach(createController);
    };

    let wakeQueued = false;
    let pendingWakeOrigin = null;
    let pointerX = window.innerWidth * 0.5;
    let pointerY = window.innerHeight * 0.48;
    let pointerTravel = 0;
    let lastPointerWakeAt = 0;

    const wakeAll = (origin) => {
      controllers.forEach((controller) => {
        if (!controller.root.isConnected) {
          controllers.delete(controller);
          return;
        }

        controller.wake(origin);
      });
    };

    const requestWakeAll = (origin) => {
      if (origin) pendingWakeOrigin = origin;
      if (wakeQueued) return;
      wakeQueued = true;

      window.requestAnimationFrame(() => {
        wakeQueued = false;
        const nextOrigin = pendingWakeOrigin;
        pendingWakeOrigin = null;
        wakeAll(nextOrigin);
      });
    };

    const handlePointerMove = (event) => {
      const distance = Math.hypot(event.clientX - pointerX, event.clientY - pointerY);
      pointerX = event.clientX;
      pointerY = event.clientY;

      if (distance < 0.6) return;
      pointerTravel += distance;

      const phase = document.documentElement.dataset.presencePhase || "awake";
      const threshold = phase === "awake" ? 4 : 14;
      if (pointerTravel < threshold) return;

      const now = performance.now();
      if (phase === "awake" && now - lastPointerWakeAt < 120) return;

      pointerTravel = 0;
      lastPointerWakeAt = now;
      requestWakeAll({ x: pointerX, y: pointerY });
    };

    window.addEventListener("pointermove", handlePointerMove, { passive: true });
    window.addEventListener("pointerdown", (event) => {
      pointerX = event.clientX;
      pointerY = event.clientY;
      pointerTravel = 0;
      requestWakeAll({ x: pointerX, y: pointerY });
    }, { passive: true });

    ["wheel", "scroll", "keydown", "touchstart"].forEach((eventName) => {
      window.addEventListener(eventName, () => {
        requestWakeAll({ x: pointerX, y: pointerY });
      }, { passive: true });
    });

    document.addEventListener("visibilitychange", () => {
      if (document.hidden) {
        controllers.forEach((controller) => {
          setRootState(controller.root, "awake", "document-hidden");
        });
        return;
      }

      controllers.forEach((controller) => controller.schedule());
    });

    const initDocumentRoots = () => {
      initRoots();

      if (!document.querySelector(rootSelector)) {
        const fallbackRoot = document.querySelector("main");
        if (fallbackRoot && !fallbackRoot.querySelector("astro-island[ssr]")) {
          fallbackRoot.setAttribute("data-cinematic-idle-root", "");
          fallbackRoot.dataset.cinematicIdleAutoRoot = "true";
          fallbackRoot.dataset.cinematicIdleDelay = "6800";
          fallbackRoot.dataset.cinematicIdleSettleDuration = "3200";
          fallbackRoot.dataset.cinematicIdleDreamDuration = "9400";
          fallbackRoot.dataset.cinematicIdleWakeDuration = "3600";
          createController(fallbackRoot);
        }
      }
    };

    document.documentElement.dataset.presenceDirector = "active";
    document.documentElement.dataset.presencePhase = "awake";

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initDocumentRoots, { once: true });
    } else {
      initDocumentRoots();
    }

    const rootObserver = new MutationObserver((mutations) => {
      mutations.forEach((mutation) => {
        if (
          mutation.type === "attributes" &&
          mutation.target instanceof Element &&
          mutation.target.matches("astro-island:not([ssr])")
        ) {
          window.requestAnimationFrame(() => {
            initRoots(mutation.target);
            initDocumentRoots();
          });
          return;
        }

        mutation.addedNodes.forEach((node) => {
          if (node.nodeType === Node.ELEMENT_NODE) {
            initRoots(node);
          }
        });
      });
    });

    rootObserver.observe(document.documentElement, {
      childList: true,
      subtree: true,
      attributes: true,
      attributeFilter: ["ssr"],
    });
  })();
</script>

<style is:global>
  [data-cinematic-idle-root] {
    --cinematic-idle-ease: cubic-bezier(0.22, 0.72, 0.18, 1);
    --cinematic-idle-wake-ease: cubic-bezier(0.18, 0.72, 0.18, 1);
    --cinematic-idle-veil-opacity: 0.76;
    --cinematic-idle-duration: 3200ms;
    --cinematic-idle-wake-duration: 3800ms;
    --presence-phrase-gather-opacity: 0.052;
    --presence-phrase-disperse-opacity: 0.03;
    position: relative;
    isolation: isolate;
  }

  [data-cinematic-idle-root] > .cinematic-idle-veil {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(circle at 58% 44%, rgba(181, 205, 145, 0.1), transparent 34rem),
      radial-gradient(circle at 28% 62%, rgba(136, 86, 62, 0.1), transparent 36rem),
      linear-gradient(180deg, rgba(3, 5, 5, 0.08), rgba(3, 5, 5, 0.52));
    opacity: 0;
    transition:
      opacity 2600ms var(--cinematic-idle-ease),
      filter 3200ms var(--cinematic-idle-ease);
  }

  [data-cinematic-idle-root][data-cinematic-idle-state="settling"] > .cinematic-idle-veil {
    opacity: 0.32;
    filter: blur(0.08px) saturate(0.96);
  }

  [data-cinematic-idle-root][data-cinematic-idle-state="idle"] > .cinematic-idle-veil {
    opacity: 0.58;
    filter: blur(0.16px) saturate(0.9);
  }

  [data-cinematic-idle-root][data-cinematic-idle-state="dreaming"] > .cinematic-idle-veil {
    opacity: var(--cinematic-idle-veil-opacity);
    filter: blur(0.28px) saturate(0.86);
  }

  [data-cinematic-idle-root][data-cinematic-idle-state="waking"] > .cinematic-idle-veil {
    opacity: 0;
    transition-duration: 3600ms;
    transition-timing-function: var(--cinematic-idle-wake-ease);
  }

  [data-cinematic-idle] {
    transition:
      opacity var(--cinematic-idle-duration, 2600ms) var(--cinematic-idle-ease),
      filter var(--cinematic-idle-duration, 2600ms) var(--cinematic-idle-ease),
      transform var(--cinematic-idle-duration, 2600ms) var(--cinematic-idle-ease),
      text-shadow var(--cinematic-idle-duration, 2600ms) var(--cinematic-idle-ease),
      letter-spacing var(--cinematic-idle-duration, 2600ms) var(--cinematic-idle-ease);
